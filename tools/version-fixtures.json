      {"host": "0.6", "range": ">=0.6", "ok": true},
      {"host": "0.6", "range": ">0.6", "ok": false},
      {"host": "0.6", "range": "<=0.6", "ok": true},
      {"host": "0.6", "range": "<0.6", "ok": false},
      {"host": "0.6", "range": "=0.6", "ok": true},
      {"host": "0.6", "range": "0.6", "ok": true},
      {"host": "0.6", "range": ">=0.5 <0.7", "ok": true},
      {"host": "0.6", "range": ">=0.5 <0.6", "ok": false},
      {"host": "0.6", "range": " >=0.5 ", "ok": true},
      {"host": "0.6", "range": "0.6\n", "ok": true},
      {"host": "256.0", "range": ">=255.255", "ok": true},
      {"host": "9007199254740993.0", "range": ">=9007199254740992.0", "ok": true},
      {"host": "9007199254740992.0", "range": ">=9007199254740993.0", "ok": false},

      {"host": "0.6", "range": ">=0.5.0", "ok": false},
