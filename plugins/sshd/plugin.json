{
  "id": "01M2JKHTZGF12N0T9CB3XVK36H",
  "name": "sshd",
  "displayName": "SSH 中转站",
  "version": "1.0.0",
  "description": "作业里跑一个用户态 sshd。原生 VS Code Remote-SSH、codex 这类要求 ssh 连接的工具都从这里接进来。",
  "author": "slurmate",
  "engines": { "slurmate": ">=0.5" },
  "contributes": {
    "layout": false,
    "submitPubkey": true,
    "defaultService": false,
    "data": { "inherit": "relay" }
  },
  "site": {
    "defaultCpus": 1,
    "defaultMem": "2G",
    "defaultEnabled": false,
    "bin": {
      "env": "SLURMATE_SSHD_BIN",
      "discovery": "convention",
      "fallback": "/usr/sbin/sshd"
    }
  }
}
