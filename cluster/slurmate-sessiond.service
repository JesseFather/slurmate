# ==============================================================================
#  slurmate-sessiond.service — Slurmate 会话守护进程（systemd 单元）
# ==============================================================================
#  这一份是逐字安装的，没有需要按站点替换的东西：沙箱那一条走
#  ProtectSystem=strict，用户家目录挂在哪、有几个，都由内核那一侧盖住，不用
#  站点报任何一个路径。install-base.sh 把它装到
#  /etc/systemd/system/slurmate-sessiond.service。
#
#  手工改装上那一份没有意义 —— 下次部署会被覆盖。要改就改这里。
#
#  加固指令的可行性由 tools/check-cluster.sh 第 8 节在目标机器上实测：它带着
#  与这里同一套指令起一个瞬时单元，跑 scontrol ping、把 munge 走一遍、nft list，
#  并验一次「该只读的地方真的只读、该可写的地方真的可写」。
# ==============================================================================

[Unit]
Description=Slurmate session ACL daemon
Documentation=https://github.com/JesseFather/slurmate
After=network-online.target nftables.service slurmctld.service remote-fs.target
Wants=network-online.target
# nftables.service 的 ExecReload 是 `nft 'flush ruleset; include ...'`，
# 会连本服务的表一起清掉。用 PartOf 跟着重启，保证表被重建。
# 注意：这里【不能】用 BindsTo —— 那会让 nftables 启动失败时本服务也起不来。
PartOf=nftables.service
# 永不放弃重启
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/slurmate-sessiond --check --config=/etc/slurmate/slurmate.conf
ExecStart=/usr/local/sbin/slurmate-sessiond --foreground --config=/etc/slurmate/slurmate.conf
# 热重载（v0.12 阶段 3）：SIGHUP 让守护进程重新读一遍配置，正在跑的会话
# 一条都不该断 —— 装/卸插件、改站点配置都走这条路（`slurmate plugin install`
# 与 `slurmate plugin sync` 自己会调 `systemctl reload`）。
#
# 而 `systemctl reload` 的退出码不表达"配置生效了没有" —— 它只说信号送到
#   了。守护进程在碰到"必须重启才生效的键"时会整个拒绝这次重载（用户拍板的
#   那条：校验不全过就一个字都不改），那时它仍然用旧配置照常服务。
#
#   要知道它接受了没有，用 `slurmate service reload`：它记下 `daemon` op 报的
#   `last_reload.seq`，发这个信号，然后等那个序号前进 —— 于是"接受"与"拒绝"
#   有确定答案。直接 `systemctl reload` 时只能自己看日志：
#       journalctl -u slurmate-sessiond -n 20
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5

User=root
Group=root
UMask=0027

# ── 加固 ────────────────────────────────────────────────────────────────────
# 整个文件系统树挂成只读，只有 ReadWritePaths= 点名的几处除外。
# 这就是本设计相对"root 写用户文件"的实质安全增量：本进程是 root，能力集里
#   又带着 CAP_DAC_OVERRIDE，不挂只读的话它能改任何人的任何文件。
# 必须是 strict 而不是 full：full 只盖 /usr 与 /etc，用户的家目录一个都不管，
#   而家目录正是这里要保护的东西。strict 会跳过 /dev、/proc、/sys 这三个 API
#   文件系统（它们由 PrivateDevices=、ProtectKernelTunables=、
#   ProtectControlGroups= 那几条管），所以它卷不到自己。
ProtectSystem=strict
# /home、/root、/run/user 那三个由这一条单独管，不在上一条的覆盖里。
#   实测（RHEL 9.7 / systemd 252）：只写 ProtectSystem=strict 时 /root 仍然写得
#   进去 —— 一个 root 进程的家目录因此敞开。这一条把它们挂成只读。
# 注意它盖的是这三个固定路径，本站的共享存储如果挂在别处（例如 /shared/home），
#   靠的是上面那条；那条盖不盖得住一个独立挂载点，由探针第 8 节实测。
ProtectHome=read-only
# strict 唯一的例外。munge 的 socket 在 /run/munge 下，而连接一个 unix socket
#   需要对该文件有写权限 —— /run 整棵被挂只读之后，scontrol / scancel / sbatch
#   会全部失败（那正是这一档以前不敢开的原因）。
# 状态、日志、运行时那三处不用在这里列：StateDirectory= / LogsDirectory= /
#   RuntimeDirectory= 自己带 BindPaths=，那几个目录始终可写。
ReadWritePaths=/run/munge

# 只读带来的一个代价，要一并知道：释放会话时那一次删会话文件
#   （remove_session_file()）在本单元下必然失败（只读挂载上 unlink 回 EROFS），
#   而那次失败是静默的。残留由下一次作业开头那一次清扫兜住（run.sbatch 的
#   sweep_stale_sessions()），窗口是"从会话结束到这个人下一次交作业"。
# 不能改成"由作业在退出时删"：会话文件里写着墓碑（state 与 exit_code），本进程
#   正是读它才知道那个会话结束了 —— 作业跑起来就失败、一次都没登记上的那些
#   全靠它立刻释放，删早了那个信号就没了，会话要干等一个 enroll 周期。
# 状态、日志、运行时目录由 systemd 管理（自动创建并设置属主/权限）
StateDirectory=slurmate-session
StateDirectoryMode=0700
LogsDirectory=slurmate
LogsDirectoryMode=0750
RuntimeDirectory=slurmate-session
RuntimeDirectoryMode=0755

PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
# nft 走 netlink；scontrol/scancel 走 AF_UNIX（munge）+ AF_INET（slurmctld）
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# 能力最小集：
#   CAP_NET_ADMIN       维护 nftables（唯一的网络能力）
#   CAP_SETUID/SETGID   以目标用户身份提交作业
#   CAP_DAC_READ_SEARCH 读取用户家目录里 0600 的会话文件
#   CAP_DAC_OVERRIDE    同上（家目录 0700 时需要）
#   CAP_KILL            回收子进程
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
