    d = r["data"]
    print("%-12s %-8s %-14s %-24s %s" % ("分区", "默认", "时间上限", "GRES", "说明"))
    print("-" * 86)
    for p in d["partitions"]:
        mark = "" if p.get("allowed") else "  [无权限]"
        # GRES 那一列**三态**，与协议同一条规矩：`gres` 这个键不存在 = 服务端
        # 查不到（它没有说"这个分区没有卡"的资格），`[]` = 确实一个都没配。
        if "gres" not in p:
            gres = "（查不到）"
        else:
            gres = "、".join("%s×%d" % (gres_label(e), e.get("per_node_max") or 0)
                             for e in p["gres"]) or "无"
