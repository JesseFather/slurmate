# 框架版本是 x.y（`major` 无上限、`minor` ∈ 0..255，禁止前导零）。四处声明
# （client/package.json、client/package-lock.json、cluster/slurmate-sessiond、
# 本文件）必须逐字相同，由 .github/workflows/checks.yml 断言。
#
# 第四处（package-lock）最容易漏：`npm ci` 不比较 lock 里根那个 version 字段，
# 它停在旧值也没人会发现。
VERSION = "0.38"
# 发布标识：这一份包是哪一次发出来的。`--version` 报它，站点包名用它。
#   形状是 `VERSION` 后面跟可选的 `-<后缀>`；正式版没有后缀，那时它与
#   `VERSION` 逐字相同。它不是协议版本：`ping` 报的仍是 `VERSION`，
#   因为 rc 与正式版之间的协议完全一样，说成不同反而会让两端判得不对。
#   后缀与 `cluster/slurmate-sessiond` 的那一行必须相同，由
#   .github/workflows/checks.yml 断言。
RELEASE = "0.38-rc1"
DEFAULT_SOCKET = "/run/slurmate-session/ctl.sock"
DEFAULT_SESSIOND = "/usr/local/sbin/slurmate-sessiond"
# systemd 单元的名字。与 `cluster/slurmate-sessiond.service` 的 `[Unit]` 与
# 部署脚本里那个变量是同一个事实，三处各写一遍（有 lint 的机会再说：目前单元
# 名字只在部署期用一次，改错的话 `systemctl` 会当场说"没有这个单元"）。
SERVICE = "slurmate-sessiond"

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NOTFOUND = 3
EXIT_REJECTED = 4
EXIT_NODAEMON = 5
EXIT_SLURM = 6
EXIT_RATELIMIT = 7


# 一条应答最多读多少字节。
#
# 这是链路上最窄的那一节，协议里那几个上限都是从它反推的（不是反过来）：守护进程
# 一次最多发一个 `PLUGIN_PACKAGE_MAX_BYTES`（2 MiB）的包，base64 膨胀 4/3 约
# 2.7 MiB，再加一层 JSON 信封，4 MiB 是约 1.5 倍余量。
#
# 这个数与守护进程的 PLUGIN_PACKAGE_MAX_BYTES 是从两侧各写一遍的，所以有一条用例
# 钉着两者的关系（`cluster/test-sessiond-logic.py` 的 19.11d）。它必须比站点通报的
# 总量上限大：两者相等的话，"整包一次发"就是一句假话（1 MiB 的负载 base64 之后是
# 1.33 MiB，根本读不完），症状还会被认错：这里报"响应太大"，客户端却把它归成
# `daemon_unreachable`（code 5）并退避重试，一次"文件太大"被报成"控制节点上的
# 守护进程没有响应"。
RPC_MAX_RESPONSE_BYTES = 4 << 20

# `slurmate stream` 连上守护进程要等多久。连上之后不再有任何超时，它是常驻通道，
# 空闲是正常的。
STREAM_CONNECT_TIMEOUT = 40.0


def socket_path():
    """socket 的位置。

    这里不读 /etc/slurmate/slurmate.conf 找 `socket_path`，原因有两条：

    一是那个键没有了。socket 路径与 systemd 单元的 RuntimeDirectory 是同一个
    事实，写在两处就有一处会过期。守护进程那边现在从常量取，这边必须取同一个。

    二是读配置这条路本身就脆弱：CLI 是【用户身份】的进程，它的解析能力决定了它
    能不能连上守护进程，而它用的是与守护进程完全不同的解析器（一个 configparser、
    一个手写扫描）。配置文件末尾多一个空行、注释换一种写法，两边就可能对同一个
    文件得出不同的结论，而症状只是"连不上守护进程"。客户端只经 `rpc` 进来，它的
    失败模式必须是确定的。
    """
    return DEFAULT_SOCKET


def sessiond_path():
    """守护进程那个脚本在哪。

    为什么 CLI 要去找它：安装器长在那份脚本里，不在这里。读一个 `.splug`、验签、
    判断包里有没有作业侧，这几件事守护进程本来就要做，而且各自只能有一份实现。
    这里再抄一份的失效方式是这一版最想避免的那种：装得上但守护进程不认，症状要到
    用户点提交时才出现。

    所以 `plugin install` 只是一层壳：找到那份脚本、把参数原样转发过去。与部署
    脚本调 `--check` 是同一个路子（它也是直接跑那份脚本）。

    覆盖用的环境变量叫 `SLURMATE_SESSIOND`：部署脚本把守护进程装在
    `<prefix>/sbin/slurmate-sessiond`，而前缀可以改，所以留一个出口。
    """
    return os.environ.get("SLURMATE_SESSIOND") or DEFAULT_SESSIOND


# ── 服务生命周期：`slurmate service <动词>` ────────────────────────────────
#
# 这一组的全部目的，是让管理员不必自己记 systemctl 的顺序：自检、动作、
#   等就绪、核对结果。`systemctl` 只回"信号送到了""单元启动了"，它不知道
#   守护进程有没有接受配置、有没有真的在应答。这些事实在这里被读完，然后
#   只说一句话。
#
# 锁与安装器是同一把（`/run/slurmate-deploy.lock`）：安装器会在持有它的时候
#   调本程序，所以那时用 `SLURMATE_LOCK_HELD=1` 跳过，避免自锁。
DEPLOY_LOCK = "/run/slurmate-deploy.lock"
READY_TIMEOUT = 20.0
READY_POLL = 0.5
RELOAD_TIMEOUT = 10.0
DRAIN_SECONDS = 60

# 调守护进程脚本里那几个插件入口（`--install-plugins` / `--sync-plugins`）时
#   带上的环境变量。它只说一件事：接下来那一步由调用方做。
#   安装器与对齐器自己不做重载，所以它们原本会留一句"下一步"；由本程序调用时，
#   那一步紧接着就由这里做掉，屏幕上再叫一遍就是让人去跑一条已经跑过的命令。
PLUGIN_FROM_CLI_ENV = "SLURMATE_PLUGIN_FROM_CLI"


def plugin_child_env():
    """给插件入口的子进程用的环境：多带一条 `PLUGIN_FROM_CLI_ENV`。"""
    env = dict(os.environ)
    env[PLUGIN_FROM_CLI_ENV] = "1"
    return env


class ServiceBusy(Exception):
    pass


def daemon_call(op, timeout=2.0):
    """向守护进程发一个生命周期 op。单独一层是为了让用例能替掉它。"""
    return rpc({"op": op}, timeout=timeout)


def systemctl(*argv):
    """跑一个 systemctl 动词。没有 systemctl 的机器上返回 None。"""
    try:
        return subprocess.run(["systemctl"] + list(argv),
                              capture_output=True, text=True)
    except OSError:
        return None


def service_state():
    r = systemctl("is-active", SERVICE)
    if r is None:
        return "missing"
    if r.returncode == 0 and (r.stdout or "").strip() == "active":
        return "active"
    return "inactive"


def nft_table_present():
    try:
        return subprocess.run(["nft", "list", "table", "inet", "slurmate"],
                              capture_output=True).returncode == 0
    except OSError:
        return False


def acquire_deploy_lock():
    """拿部署锁。安装器已经拿着时（环境变量）直接放行。"""
    if os.environ.get("SLURMATE_LOCK_HELD") == "1":
        return None
    try:
        fd = os.open(DEPLOY_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise ServiceBusy("另一个部署或服务操作正在进行（锁：%s）。" % DEPLOY_LOCK)
    return fd


def print_journal():
    try:
        r = subprocess.run(["journalctl", "-u", SERVICE, "-n", "30",
                            "--no-pager"], capture_output=True, text=True)
    except OSError:
        return
    out = (r.stdout or "").strip()
    if out:
        print(out, file=sys.stderr)


def wait_ready(timeout=READY_TIMEOUT):
    """等守护进程真的能应答。返回 `(状态, 最后一次没就绪的原因)`。

    判据是三件事：socket 在、nft 表在、`daemon` op 能答。前两件在 `run()`
      开始之前就为真，所以它们单独都不够 —— 只有"能答"才说明事件循环在转。
      老守护进程不认 `daemon` op 时退回 `ping`。
    """
    deadline = time.monotonic() + timeout
    last = "socket 还没出现"
    while time.monotonic() < deadline:
        if not os.path.exists(socket_path()):
            last = "socket 还没出现"
        elif not nft_table_present():
            last = "nft 表还没建好"
        else:
            try:
                resp = daemon_call("daemon")
            except RpcError as e:
                last = e.message
            else:
                if resp.get("ok"):
                    return resp.get("data") or {}, None
                kind = (resp.get("error") or {}).get("kind")
                if kind == "unknown_op":
                    try:
                        pong = daemon_call("ping")
                    except RpcError as e:
                        last = e.message
                    else:
                        if pong.get("ok"):
                            return pong.get("data") or {}, None
                        last = ((pong.get("error") or {}).get("detail")
                                or "ping 被拒绝")
                else:
                    last = ((resp.get("error") or {}).get("detail")
                            or "守护进程不应答")
        time.sleep(READY_POLL)
    return None, last


def reload_seq():
    """上一次重载的序号；旧守护进程或不可达时返回 None。"""
    try:
        resp = daemon_call("daemon")
    except RpcError:
        return None
    if not resp.get("ok"):
        return None
    cfg = (resp.get("data") or {}).get("config") or {}
    return (cfg.get("last_reload") or {}).get("seq")


def wait_reload(base_seq, timeout=RELOAD_TIMEOUT):
    """等 `last_reload.seq` 前进。返回 `(last_reload, 原因)`。"""
    deadline = time.monotonic() + timeout
    last = "守护进程没有应答"
    # 拿不到基线（旧守护进程刚换、或那一刻正好连不上）时，等半秒再读一次，
    #   把读到的那次当作这次重载的结果。这不是完美的归因，但比"回 0 就说
    #   已生效"诚实：下面会说清"旧守护进程不报结果"。
    if base_seq is None:
        time.sleep(0.5)
    while time.monotonic() < deadline:
        try:
            resp = daemon_call("daemon")
        except RpcError as e:
            last = e.message
        else:
            if resp.get("ok"):
                cfg = (resp.get("data") or {}).get("config") or {}
                lr = cfg.get("last_reload") or {}
                seq = lr.get("seq") or 0
                if base_seq is None or seq > base_seq:
                    return lr, None
            elif (resp.get("error") or {}).get("kind") == "unknown_op":
                # 旧守护进程：它做了这次重载，但不报结果。不许因此把它当成失败。
                return {"ok": True, "unverifiable": True}, None
            else:
                last = ((resp.get("error") or {}).get("detail")
                        or "守护进程不应答")
        # 0.2 秒一次：这个 op 也过每 uid 每秒的限流，100 次/秒是那条线。
        time.sleep(0.2)
    return None, last


def reload_and_report(quiet=False):
    """让守护进程重读配置，并等到它真的接受/拒绝。返回退出码。

    用 `systemctl reload`（单元的 `ExecReload` 是 `kill -HUP`），不是 restart：
      正在跑的会话一条都不该断。`systemctl` 的退出码只说信号送到了，所以
      这里再读 `daemon` op 的 `last_reload`，把"接受"与"拒绝"说准。

    三条路各说各的话：接受了 / 服务没在跑（下次启动用上）/ 拒绝了或没落地。
      把三件事混成一句"配置已生效"，就是这一路在清的那种静默。
    """
    state = service_state()
    if state == "missing":
        return EXIT_OK          # 开发机 / 容器：没有 systemd，没有可通知的
    if state != "active":
        if not quiet:
            print("（守护进程没在跑。配置已经写好，下次启动就会用上。）")
        return EXIT_OK
    base = reload_seq()
    r = systemctl("reload", SERVICE)
    if r is None:
        return EXIT_OK
    if r.returncode != 0:
        print("配置写好了，但 `systemctl reload` 未成功。它会在下次重启时生效；"
              "想立刻生效：sudo slurmate service restart", file=sys.stderr)
        return 1
    lr, why = wait_reload(base)
    if lr is None:
        print("配置写好了，但守护进程没有在 %d 秒内完成重载（%s）。"
              "看它自己的日志：journalctl -u %s -n 20"
              % (int(RELOAD_TIMEOUT), why, SERVICE), file=sys.stderr)
        return 1
    if lr.get("unverifiable"):
        if not quiet:
            print("已让守护进程重读配置（`systemctl reload`），"
                  "正在跑的会话一条都没断。")
            print("  这个守护进程不报重载结果（版本较旧），"
                  "有没有接受看它的日志：journalctl -u %s -n 20" % SERVICE)
        return EXIT_OK
    if lr.get("ok"):
        if not quiet:
            print("守护进程接受了这次重载，正在跑的会话一条都没断。")
            for k in lr.get("notice_keys") or []:
                print("  已生效（会影响已建立的会话）：%s" % k)
        return EXIT_OK
    err = lr.get("error") or "原因未记录"
    keys = lr.get("cold_keys") or []
    print("守护进程拒绝了这次重载：%s%s。新配置一个字都没被采用。"
          % (err, ("（%s）" % "、".join(keys)) if keys else ""), file=sys.stderr)
    print("  要让它生效：sudo slurmate service restart", file=sys.stderr)
    return 1


def reload_daemon(quiet=False):
    """插件命令的落点：配置写完后热重载，并把结果作为退出码传回去。"""
    return reload_and_report(quiet=quiet)


def sync_derived(config=None):
    """把作业模板与作业脚本对齐。返回 `(成功, 失败输出)`。

    守护进程在 `ProtectSystem=strict` 下写不了 jobs 目录，这件事只能由 root
    的 CLI 做。跑的是 `plugin sync` 的同一份实现（`--sync-plugins`），幂等，
    作业脚本逐份原子替换。成功时不打印：它只是启动/重载/重启前的一步。
    """
    exe = sessiond_path()
    if not os.path.isfile(exe):
        return False, "未找到守护进程脚本 %s" % exe
    argv = [sys.executable, exe, "--sync-plugins"]
    if config:
        argv += ["--config", config]
    try:
        r = subprocess.run(argv, capture_output=True, text=True,
                           env=plugin_child_env())
    except OSError as e:
        return False, "启动派生物对齐失败（%s）：%s" % (exe, e)
    if r.returncode == 0:
        return True, ""
    out = ((r.stdout or "") + (r.stderr or "")).strip()
    return False, out or "派生物对齐失败（退出码 %d）" % r.returncode


def nft_delete_table():
    """删掉本系统那张 nft 表。只有 `service stop` 与卸载会走到这里。"""
    try:
        return subprocess.run(["nft", "delete", "table", "inet", "slurmate"],
                              capture_output=True, text=True)
    except OSError:
        return None


def cmd_service_check(args):
    argv = [sys.executable, sessiond_path(), "--check"]
    if args.config:
        argv += ["--config", args.config]
    try:
        return subprocess.run(argv).returncode
    except OSError as e:
        print("启动守护进程自检失败（%s）：%s" % (sessiond_path(), e),
              file=sys.stderr)
        return EXIT_NOTFOUND


def _service_status_data():
    try:
        resp = daemon_call("daemon")
    except RpcError:
        return None
    if resp.get("ok"):
        return resp.get("data") or {}
    if (resp.get("error") or {}).get("kind") == "unknown_op":
        # 旧守护进程：它不报详细状态，但 ping 能证明它活着。
        try:
            pong = daemon_call("ping")
        except RpcError:
            return None
        if pong.get("ok"):
            return {"old": True,
                    "version": (pong.get("data") or {}).get("version")}
    return None


def cmd_service_status(args):
    """systemd 的状态 + 守护进程自己的状态。只读，不需要 root。"""
    state = service_state()
    data = _service_status_data()
    if data is None:
        if state == "active":
            if args.quiet:
                print("在运行，但不应答")
            else:
                print("服务在运行，但守护进程不应答。看日志：")
                print_journal()
            return 1
        if state == "missing":
            print("这台机器上没有 systemctl，也连不上守护进程。")
        else:
            print("未运行。")
            print("  启动：sudo slurmate service start")
        return EXIT_NOTFOUND

    if data.get("old"):
        if args.quiet:
            print("运行中（版本 %s）" % data.get("version"))
        else:
            print("服务：运行中（版本 %s）" % data.get("version"))
            print("  这个守护进程不报详细状态（版本较旧）。"
                  "升级到 0.24 之后这里会有配置摘要、会话数与上次重载结果。")
        return EXIT_OK

    cfg = data.get("config") or {}
    lr = cfg.get("last_reload") or {}
    plugins = data.get("plugins") or {}
    sessions = data.get("sessions") or {}
    draining = (data.get("draining") or {}).get("until") or 0
    if args.quiet:
        print("运行中（版本 %s，pid %s）"
              % (data.get("version"), data.get("pid")))
    else:
        print("服务：运行中（版本 %s，pid %s）"
              % (data.get("version"), data.get("pid")))
        print("配置：%s" % cfg.get("path"))
        print("  已载入于 %s（摘要 %s）"
              % (time.strftime("%Y-%m-%d %H:%M:%S",
                               time.localtime(cfg.get("loaded_at") or 0)),
                 (cfg.get("digest") or "")[:12]))
        if cfg.get("digest") and cfg.get("on_disk_digest") \
                and cfg.get("digest") != cfg.get("on_disk_digest"):
            print("  [注意] 盘上的配置与已载入的不一致，有改动尚未生效："
                  "sudo slurmate service reload")
        if lr.get("seq"):
            if lr.get("ok"):
                print("  上一次重载：接受（%s）"
                      % time.strftime("%H:%M:%S",
                                      time.localtime(lr.get("at") or 0)))
            else:
                print("  上一次重载：拒绝（%s）%s"
                      % (time.strftime("%H:%M:%S",
                                       time.localtime(lr.get("at") or 0)),
                         lr.get("error") or ""))
        print("会话：%s 个占着位置" % sessions.get("active", 0))
        print("插件：%s 个，%s 个启用"
              % (plugins.get("total", 0), plugins.get("enabled", 0)))
        rng = data.get("port_range") or [0, 0]
        print("端口池：%s-%s；nft 表：%s"
              % (rng[0], rng[1],
                 "在位" if data.get("nft_table") else "读取失败"))
        if draining:
            print("排空窗口：到 %s"
                  % time.strftime("%H:%M:%S", time.localtime(draining)))
    return EXIT_OK


def _error(msg):
    print(msg, file=sys.stderr)
    return 1


def cmd_service_start(args):
    if os.geteuid() != 0:
        return _error("这一步要 root：sudo slurmate service start")
    if args.dry_run:
        print("会先跑守护进程自检，再 systemctl start，然后等它真的应答。")
        return EXIT_OK
    try:
        acquire_deploy_lock()
    except ServiceBusy as e:
        return _error(str(e))
    if cmd_service_check(args) != 0:
        return _error("配置自检没过，没有动服务。")
    ok, why = sync_derived(args.config)
    if not ok:
        print(why, file=sys.stderr)
        return _error("派生物对齐失败，没有动服务。")
    state = service_state()
    if state == "missing":
        return _error("这台机器上没有 systemctl，启动不了服务。")
    if state == "active":
        data, _why = wait_ready(2.0)
        if data is not None:
            print("已经在运行。")
            return EXIT_OK
    r = systemctl("start", SERVICE)
    if r is None or r.returncode != 0:
        print_journal()
        return _error("服务启动失败。")
    data, why = wait_ready()
    if data is None:
        print("等待 %d 秒后守护进程仍未就绪（%s）。"
              % (int(READY_TIMEOUT), why), file=sys.stderr)
        print_journal()
        return 1
    print("服务已启动（版本 %s，pid %s）。"
          % (data.get("version", "?"), data.get("pid", "?")))
    return EXIT_OK


def _stop_all_sessions(timeout=30.0):
    """让守护进程取消全部会话，并等它们离开占用状态。

    返回 `(数据, 没停干净的原因)`。数据为 None 表示 op 本身没做成。
    `daemon` op 的 `sessions.active` 把 `releasing` 也算在内：只有等
    `phase_release` 确认作业消失并落终态，它才会归零。等不到就说明还有作业
    没停掉，这时不能停服务（否则下次启动会按 claims 行把 ACL 补回来）。
    """
    try:
        resp = daemon_call("stop_all", timeout=timeout + 10)
    except RpcError as e:
        return None, e.message
    if not resp.get("ok"):
        err = resp.get("error") or {}
        if err.get("kind") == "unknown_op":
            return None, ("这个守护进程不认 stop_all（版本较旧）；"
                          "装好这一版并重启后再试。")
        return None, err.get("detail") or "守护进程拒绝了 stop_all"
    data = resp.get("data") or {}
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            d = daemon_call("daemon")
        except RpcError as e:
            return data, e.message
        if not d.get("ok"):
            return data, ((d.get("error") or {}).get("detail")
                          or "守护进程不应答")
        active = ((d.get("data") or {}).get("sessions") or {}).get("active") or 0
        if active == 0:
            return data, None
        time.sleep(READY_POLL)
    return data, "还有会话没有释放"


def cmd_service_stop(args):
    if os.geteuid() != 0:
        return _error("这一步要 root：sudo slurmate service stop")
    if args.dry_run:
        print("会先取消本站全部会话（用户自己的作业不动），再停服务并删 nft 表。")
        return EXIT_OK
    try:
        acquire_deploy_lock()
    except ServiceBusy as e:
        return _error(str(e))
    if service_state() == "active":
        data, why = _stop_all_sessions()
        if data is None:
            return _error(why or "守护进程没有应答复停全部会话。")
        if why:
            return _error("有会话没有停干净（%s）；服务没有停，稍后再试。"
                          % why)
        print("已结束 %d 条会话（另有 %d 条占位记录作废）。"
              % (len(data.get("stopped") or []),
                 len(data.get("expired") or [])))
        if data.get("cancel_failed"):
            print("  另有 %d 条 scancel 没有发成功，作业自行结束后已释放。"
                  % len(data["cancel_failed"]))
    r = systemctl("stop", SERVICE)
    if r is None or r.returncode != 0:
        print_journal()
        return _error("服务停止失败。")
    deadline = time.monotonic() + READY_TIMEOUT
    while time.monotonic() < deadline:
        if service_state() != "active":
            break
        time.sleep(READY_POLL)
    if service_state() == "active":
        print_journal()
        return _error("服务还在运行。")
    if nft_table_present():
        rr = nft_delete_table()
        if rr is None or rr.returncode != 0:
            return _error("服务已停止，但 nft 表没有删掉："
                          "nft delete table inet slurmate")
        print("已删除 nft 表 inet slurmate。")
    # 运行目录若空就收掉；systemd 的 RuntimeDirectory 可能已经删了。
    try:
        os.rmdir(os.path.dirname(DEFAULT_SOCKET))
    except OSError:
        pass
    print("服务已停止。")
    return EXIT_OK


def _config_mismatch(args):
    """`--config` 与守护进程读的那一份不同时返回一句错误，否则 None。"""
    if not args.config:
        return None
    data = _service_status_data() or {}
    running = (data.get("config") or {}).get("path")
    if running and os.path.abspath(args.config) != os.path.abspath(running):
        return ("--config 指向 %s，而守护进程读的是 %s。"
                "这类动词只能作用于它启动时那一份；要换路径请改单元再重启。"
                % (args.config, running))
    return None


def cmd_service_restart(args):
    if os.geteuid() != 0:
        return _error("这一步要 root：sudo slurmate service restart")
    if args.dry_run:
        print("会先自检、排空、对齐派生物，再 systemctl restart，然后等它应答。")
        return EXIT_OK
    try:
        acquire_deploy_lock()
    except ServiceBusy as e:
        return _error(str(e))
    bad = _config_mismatch(args)
    if bad:
        return _error(bad)
    if cmd_service_check(args) != 0:
        return _error("配置自检没过，没有动服务。")
    if service_state() == "missing":
        return _error("这台机器上没有 systemctl，重启不了服务。")
    # 排空：让新提交在窗口内被拒，重启就不会切断一次走到一半的提交。
    #   失败不致命：旧守护进程不认这个 op，而重启本身仍然是安全的。
    if service_state() == "active":
        try:
            daemon_call("drain")
        except RpcError:
            pass
    # 模板与作业脚本不在守护进程能写的地方（ProtectSystem=strict），
    #   所以由 CLI 在重启前对齐一次；失败就不重启。
    ok, why = sync_derived(args.config)
    if not ok:
        print(why, file=sys.stderr)
        return _error("派生物对齐失败，没有重启服务。")
    r = systemctl("restart", SERVICE)
    if r is None or r.returncode != 0:
        print_journal()
        return _error("服务重启失败。")
    data, why = wait_ready()
    if data is None:
        print("等待 %d 秒后守护进程仍未就绪（%s）。"
              % (int(READY_TIMEOUT), why), file=sys.stderr)
        print_journal()
        return 1
    cfg = data.get("config") or {}
    print("服务已重启（版本 %s，pid %s）。"
          % (data.get("version", "?"), data.get("pid", "?")))
    if cfg.get("digest") and cfg.get("on_disk_digest") \
            and cfg.get("digest") != cfg.get("on_disk_digest"):
        print("  [注意] 盘上的配置与已载入的不一致："
              "sudo slurmate service check", file=sys.stderr)
        return 1
    return EXIT_OK


def cmd_service_reload(args):
    if os.geteuid() != 0:
        return _error("这一步要 root：sudo slurmate service reload")
    if args.dry_run:
        print("会先自检、对齐派生物，再 systemctl reload，然后等它报出接受/拒绝。")
        return EXIT_OK
    try:
        acquire_deploy_lock()
    except ServiceBusy as e:
        return _error(str(e))
    bad = _config_mismatch(args)
    if bad:
        return _error(bad)
    if cmd_service_check(args) != 0:
        return _error("配置自检没过，没有动服务。")
    if service_state() != "active":
        return _error("服务没在跑，没有可重载的内容。启动一次就会用上这份配置："
                      "sudo slurmate service start")
    # 主配置与插件树会被 SIGHUP 重读；模板与作业脚本不在其中，所以先把
    #   派生物对齐，再让守护进程重读。两件事合成一条命令，管理员不必记得
    #   "改完模板还要 plugin sync"。
    ok, why = sync_derived(args.config)
    if not ok:
        print(why, file=sys.stderr)
        return _error("派生物对齐失败，没有重载。")
    return reload_and_report(quiet=args.quiet)


def cmd_plugin_install(args):
    """`slurmate plugin install <文件…>`：把作者发布的 `.splug` 装到本站。

    与这台机器上的 `slurmate` 其余动词不同，它不经 socket、不连守护进程：
    它是一个管理动作（要以 root 跑，写的是 `<prefix>/share/slurmate/plugins/`），
    与"这台机器上的守护进程此刻在不在"无关。
    """
    if os.geteuid() != 0:
        # 早说。装进去的包会成为每一个用户提交的作业的一部分，所以这件事只能
        # root 做。让它在写文件那一刻以 EACCES 失败，报出来的会是一句权限错误，
        # 而管理员要的是"该加 sudo"。
        print("装插件要以 root 运行：包会落到 <prefix>/share/slurmate/plugins/，\n"
              "而它的作业侧会被编织进每一个用户提交的作业。\n"
              "  sudo slurmate plugin install %s"
              % " ".join(args.files), file=sys.stderr)
        return EXIT_REJECTED

    exe = sessiond_path()
    if not os.path.isfile(exe):
        print("未找到守护进程脚本 %s，安装器在它里面。\n"
              "  · 部署过时，检查它是不是在其他 prefix 下，用 SLURMATE_SESSIOND "
              "指过去；\n"
              "  · 还没部署时，先跑 cluster/install-base.sh。" % exe, file=sys.stderr)
        return EXIT_NOTFOUND

    if not args.files and not args.from_dir:
        print("要给一个或多个包，或者用 --from <目录>。\n"
              "  sudo slurmate plugin install foo.splug\n"
              "  sudo slurmate plugin install --from /srv/slurmate-pkgs", file=sys.stderr)
        return EXIT_USAGE

    argv = [sys.executable, exe, "--install-plugins"] + list(args.files)
    if args.from_dir:
        argv += ["--plugins-src", args.from_dir]
    if args.plugins_dir:
        argv += ["--plugins-dir", args.plugins_dir]
    if args.replace_key:
        argv += ["--replace-key", args.replace_key]
    # 不用 os.execv：留一层能让退出码原样传上去，也让这条路在用例里跑得动
    # （execv 会把跑用例的那个进程换掉）。
    try:
        rc = subprocess.run(argv, env=plugin_child_env()).returncode
    except OSError as e:
        print("启动安装器失败（%s）：%s" % (exe, e), file=sys.stderr)
        return EXIT_NODAEMON
    if rc != 0:
        return rc

    # 装完立刻把配置对齐（见守护进程的 `sync_plugin_config`）：装了插件而配置里
    # 看不见它，管理员就少了一处能改开关的地方，而"装了什么"与"配置里写了什么"
    # 不一致正是这一版要消灭的形状。
    #
    # 但 `--plugins-dir` 指到别处时不动配置：那是一条排查路径（把包装到一个临时
    # 目录里看看），拿它去对齐站点配置会把真正的插件配置全删掉（目录里当然没有
    # 它们）。这个口子必须在这里堵住，因为在那边堵不住：守护进程只知道"你给了一
    # 个目录"，不知道那是本站还是别处。
    if args.plugins_dir:
        print("装到了 %s 而不是本站的插件目录，所以没动站点的那两份派生物。"
              % args.plugins_dir, file=sys.stderr)
        return 0
    sync = [sys.executable, exe, "--sync-plugins"]
    if args.config:
        sync += ["--config", args.config]
    try:
        src = subprocess.run(sync, env=plugin_child_env()).returncode
    except OSError as e:
        print("启动配置对齐失败（%s）：%s" % (exe, e), file=sys.stderr)
        return EXIT_NODAEMON
    if src != 0:
        # 包装好了，而站点那两份派生物没对上。分开说：把这两件事混成一句"装插件
        # 失败"，管理员会去重装那个已经装好了的包。
        print("插件包已经装好了，但站点的配置/作业脚本未能对齐（原因见上）。"
              "在它们对齐之前，这个插件可能无法启动或提交不了。", file=sys.stderr)
        return src
    # 装好了、配置也对齐了，就让守护进程重读一遍（热重载），而不是重跑一次基座
    # 安装脚本（stop + start）：那样所有人的会话要断一次，就为了加一个插件。
    # 重载被拒或没落地时把非零传回去：包已经装好，而站点没有接受这次改动，
    # 这两件事要分开说。
    return reload_daemon()


def cmd_plugin_uninstall(args):
    """`slurmate plugin uninstall <id>…`：把插件从本站卸掉。

    卸掉的四处痕迹（包 / 它那份配置 / 它那份作业脚本 / 站点侧那条签名者记录）由
    守护进程的 `uninstall_plugins()` 一处说了算，与安装对称，都是唯一入口。CLI
    这一层只负责找到那份脚本、把参数转过去。
    """
    if os.geteuid() != 0:
        print("卸插件要动 <prefix>/share/slurmate/ 与 %s.d/，所以要 root：\n"
              "  sudo slurmate plugin uninstall %s"
              % (args.config or "/etc/slurmate/slurmate.conf",
                 " ".join(args.ids) or "--all"), file=sys.stderr)
        return EXIT_REJECTED
    if not args.ids and not args.all:
        print("要给一个或多个插件的 id，或者用 --all 卸掉全部。\n"
              "  看本站装了哪些：slurmate plugins", file=sys.stderr)
        return EXIT_USAGE

    exe = sessiond_path()
    if not os.path.isfile(exe):
        print("未找到守护进程脚本 %s，卸载的判据在它里面。\n"
              "  · 部署过时，检查它是不是在其他 prefix 下，用 SLURMATE_SESSIOND "
              "指过去；\n"
              "  · 还没部署时，先跑 cluster/install-base.sh。" % exe, file=sys.stderr)
        return EXIT_NOTFOUND

    argv = [sys.executable, exe, "--uninstall-plugins"] + list(args.ids)
    if args.all:
        argv += ["--all-plugins"]
    if args.plugins_dir:
        argv += ["--plugins-dir", args.plugins_dir]
    if args.config:
        argv += ["--config", args.config]
    try:
        rc = subprocess.run(argv).returncode
    except OSError as e:
        print("启动卸载器失败（%s）：%s" % (exe, e), file=sys.stderr)
        return EXIT_NODAEMON
    if rc == 0:
        # `--plugins-dir` 是排查路径：卸的是那个目录，不动真站点的配置。
        # 那时没有可重载的东西，也不该去拨真守护进程。
        if args.plugins_dir:
            print("卸的是 %s 而不是本站的插件目录，所以没有让守护进程重读"
                  "（真站点一个字节都没动）。" % args.plugins_dir)
            return 0
        # 卸掉一个插件会删掉它那一份配置，所以要让守护进程重读一遍（见
        # reload_daemon）。不说这一句的话，表现是"卸了但它好像还在"，直到下次
        # 重启才消失。
        return reload_daemon()
    return rc


def cmd_plugin_sync(args):
    """`slurmate plugin sync`：把站点的两份派生物与插件目录对齐。

    它不装也不卸任何插件，只对账：某个插件的那份配置（`<ULID>.conf`）或作业脚本
    （`<ULID>.sbatch`）在而插件没了，就删掉；装了而没有配置的，就写一份；有作业侧
    的，就织一份作业脚本。见守护进程的 `sync_plugins()`。

    "插件没了"的判据是 `<ULID>/` 那一棵树。管理员直接 `rm -r` 掉它（或者用
    `slurmate plugin uninstall`）之后，就是跑这一条。
    """
    if os.geteuid() != 0:
        print("对齐要写 %s.d/ 与作业脚本目录，所以要 root：\n"
              "  sudo slurmate plugin sync" % (args.config
                                               or "/etc/slurmate/slurmate.conf"),
              file=sys.stderr)
        return EXIT_REJECTED

    exe = sessiond_path()
    if not os.path.isfile(exe):
        print("未找到守护进程脚本 %s，对账的判据在它里面。\n"
              "  · 部署过时，检查它是不是在其他 prefix 下，用 SLURMATE_SESSIOND "
              "指过去；\n"
              "  · 还没部署时，先跑 cluster/install-base.sh。" % exe, file=sys.stderr)
        return EXIT_NOTFOUND

    argv = [sys.executable, exe, "--sync-plugins"]
    if args.plugins_dir:
        argv += ["--plugins-dir", args.plugins_dir]
    if args.config:
        argv += ["--config", args.config]
    try:
        rc = subprocess.run(argv).returncode
    except OSError as e:
        print("启动配置对齐失败（%s）：%s" % (exe, e), file=sys.stderr)
        return EXIT_NODAEMON
    if rc == 0:
        # 同上：`--plugins-dir` 指到别处时，守护进程那一侧根本没对齐任何
        # 内容（它会说清为什么并回 0）。此时去重载真服务只会把一句话说成谎。
        if args.plugins_dir:
            print("用的是 %s 而不是本站的插件目录，所以没有让守护进程重读"
                  "（真站点一个字节都没动）。" % args.plugins_dir)
            return 0
        # 对齐动了配置文件，所以要守护进程重读一遍（见 reload_daemon）。否则
        # 管理员还得记得"改完要重启"，忘了的后果是"配了但它就是不生效"，而这类
        # 症状正是要消灭的。
        return reload_daemon()
    return rc


def rpc(req, timeout=40.0):
    """向守护进程发一行 JSON，读回一行 JSON。失败抛 RpcError。"""
    path = socket_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout) as e:
        s.close()
        raise RpcError(EXIT_NODAEMON,
                       "无法连接 Slurmate 守护进程（%s）：%s\n"
                       "请确认控制节点上 slurmate-sessiond 正在运行：\n"
                       "  systemctl status slurmate-sessiond" % (path, e))
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "连接守护进程失败（%s）：%s" % (path, e))
    try:
        s.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf and len(buf) < RPC_MAX_RESPONSE_BYTES:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        s.close()
        raise RpcError(EXIT_NODAEMON, "守护进程响应超时")
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "与守护进程通信失败：%s" % e)
    finally:
        try:
            s.close()
        except OSError:
            pass
    # 先说"读不下了"，再说"解析不了"。这两件事的症状一样（`json.loads` 都失败），
    # 但原因差得远：截断的那一份报出来会是「响应不是合法 JSON」，于是下一次有人会
    # 去查守护进程为什么不响应，而真正的原因是这一条响应本来就很大。
    #
    #   什么响应会这么大：`plugin_package` 一次发一整个包（base64 之后还要大三分
    #   之一），或者插件多得那份逐文件的清单本身就装不下。所以出路是"少装几个插件
    #   / 让作者把包做小"，不是"重启守护进程"。
    if b"\n" not in buf and len(buf) >= RPC_MAX_RESPONSE_BYTES:
        raise RpcError(EXIT_SLURM,
                       "守护进程的响应超过了 %d 字节，这一条读不完整。\n"
                       "多半是插件的整包过大（`plugin_package` 一次发一整个包，"
                       "base64 之后还要大三分之一）。\n"
                       "这不是守护进程没响应，是这一条应答本身超出了 CLI 的读取"
                       "上限。\n"
                       "要真的放宽，得同时抬这里的 RPC_MAX_RESPONSE_BYTES 与守护"
                       "进程的 PLUGIN_PACKAGE_MAX_BYTES。只抬一边等于把这句话往后"
                       "移动一格。" % RPC_MAX_RESPONSE_BYTES)
    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise RpcError(EXIT_NODAEMON, "守护进程返回了空响应")
    try:
        return json.loads(line.decode("utf-8"))
    except ValueError as e:
        raise RpcError(EXIT_NODAEMON, "守护进程返回的响应不是合法 JSON：%s" % e)


class RpcError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def call(req, want_json=False, timeout=40.0):
    """发 RPC 并按需渲染。返回退出码。"""
    try:
        resp = rpc(req, timeout=timeout)
    except RpcError as e:
        if want_json:
            print(json.dumps({"ok": False, "code": e.code, "data": None,
                              "error": {"kind": "daemon_unreachable",
                                        "detail": e.message}},
                             ensure_ascii=False))
        else:
            print(e.message, file=sys.stderr)
        return e.code

    if want_json:
        print(json.dumps(resp, ensure_ascii=False))
        return 0 if resp.get("ok") else _code_to_exit(resp)

    if not resp.get("ok"):
        err = resp.get("error") or {}
        print("[错误] %s" % (err.get("detail") or err.get("kind") or "未知错误"),
              file=sys.stderr)
        return _code_to_exit(resp)
    return resp


def _code_to_exit(resp):
    code = resp.get("code", 1)
    if code == 2:
        return EXIT_USAGE
    if code == 3:
        return EXIT_NOTFOUND
    if code == 4:
        return EXIT_REJECTED
    if code == 5:
        return EXIT_NODAEMON
    if code == 6:
        return EXIT_SLURM
    if code == 7:
        return EXIT_RATELIMIT
    return 1


def _human_bytes(n):
    """给人看的字节数。守护进程那一侧有一份同名的，两边都是给人看输出的。它们是
    两个独立安装的程序（CLI 在 <prefix>/bin，守护进程在 <prefix>/sbin），不共享模块，
    所以这点重复是布局带来的，不是抄漏了。"""
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return "%d B" % n if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0


def human_state(state):
    return {
        "reserved": "已分配端口",
        "submitted": "已提交，等待调度",
        "enrolled": "运行中",
        "suspect": "连接中断（作业仍在运行）",
        "orphaned": "判定异常退出，正在释放",
        "releasing": "正在释放",
        "released": "已结束",
        "rejected": "已拒绝",
        "expired": "已过期",
    }.get(state, state)


def parse_gres_spec(s):
    """`--gres` 的取值 → 描述符。写法就是 sbatch 那个：`名字[:型号]:数量`。

    空串 = 没要（返回 `(None, None)`）。这里只做拆词，不判名字合不合法：那是服务端
    的事（它不认识的一切都会拒），而且拒的那句话由服务端说。两边各写一套判断就会
    漂成"这里放过去了、那边说不认识"。

    这个函数与守护进程的 `gres_spec()` 是一对（一个拆、一个拼），住在两个文件里，
    因为 CLI 与守护进程是两个独立安装的程序（见 `_human_bytes` 那段说明）。一对
    拆/拼会漂开，所以 `cluster/test-sessiond-logic.py` 里有一条往返用例把两个文件
    都抠出来真跑。
    """
    s = (s or "").strip()
    if not s:
        return None, None
    parts = s.split(":")
    if len(parts) == 2:
        name, typ, cnt = parts[0], None, parts[1]
    elif len(parts) == 3:
        name, typ, cnt = parts[0], parts[1], parts[2]
    else:
        return None, ("写不对：要「名字:数量」或「名字:型号:数量」，"
                      "例如 gpu:2 / gpu:a100:2")
    if not cnt.isdigit():
        return None, "数量必须是整数，得到 %r" % cnt
    return {"name": name, "type": typ or None, "count": int(cnt)}, None


def gres_label(g):
    """描述符 → 名字（不含数量）：`gpu` 或 `gpu:a100`。

    守护进程里有一份同名的。两边是两个独立安装的程序（CLI 在 <prefix>/bin、守护
    进程在 <prefix>/sbin），不共享模块，与 `_human_bytes` 同一情形。要盯的不是
    这两份（它们只是给人看的字），而是拆词与拼词那一对：`parse_gres_spec()` 与
    守护进程的 `gres_spec()` 必须互相认得，`cluster/test-sessiond-logic.py` 里有
    一条往返用例把两个文件都抠出来真跑。
    """
    if not isinstance(g, dict) or not g.get("name"):
        return "?"
    return "%s:%s" % (g["name"], g["type"]) if g.get("type") else g["name"]


def gres_text(g):
    """描述符 → 人话（`gpu:a100 × 2`）。给人看的输出用；`--json` 出的是原样结构。"""
    if not isinstance(g, dict) or not g.get("name"):
        return None
    return "%s × %s" % (gres_label(g), g.get("count"))


def fmt_left(expires_at):
    if not expires_at:
        return "-"
    left = int(expires_at - time.time())
    if left <= 0:
        return "已到期"
    h, rem = divmod(left, 3600)
    m, _ = divmod(rem, 60)
    if h >= 24:
        return "%dd %dh" % (h // 24, h % 24)
    return "%dh %dm" % (h, m)


def print_session(s, verbose=True):
    if not s:
        print("（没有活跃会话）")
        return
    print("会话 ID   : %s" % s.get("session_id"))
    print("状态      : %s" % human_state(s.get("state")))
    if s.get("job_id"):
        print("作业 ID   : %s" % s.get("job_id"))
    res = s.get("resources") or {}
    gt = gres_text(res.get("gres"))
    print("分区      : %s" % (s.get("partition") or "（由 Slurm 决定）"))
    print("资源      : %s 核 / %s%s"
          % (res.get("cpus") or "?", res.get("mem") or "?",
             "，%s" % gt if gt else ""))
    if s.get("tunnel_target"):
        print("隧道目标  : %s" % s.get("tunnel_target"))
        print("连          : ssh -N -L <本地端口>:%s ..." % s.get("tunnel_target"))
    if s.get("expires_at"):
        print("剩余时间  : %s" % fmt_left(s.get("expires_at")))
        if s.get("time_limit"):
            print("时间上限  : %s（已续期 %s 次）"
                  % (s.get("time_limit"), s.get("renew_count", 0)))
    if s.get("node"):
        print("节点      : %s (%s)" % (s.get("node"), s.get("node_ip")))
    if s.get("note"):
        print("备注      : %s" % s.get("note"))


