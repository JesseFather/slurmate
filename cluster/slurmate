def cmd_rpc(args):
    """从 stdin 读一行 JSON 请求，写一行 JSON 响应。客户端的固定入口。"""
    raw = sys.stdin.readline()
    if not raw.strip():
        print(json.dumps({"ok": False, "code": EXIT_USAGE, "data": None,
                          "error": {"kind": "empty_request",
                                    "detail": "stdin 上没有收到请求"}},
                         ensure_ascii=False))
        return EXIT_USAGE
    try:
        req = json.loads(raw)
        if not isinstance(req, dict):
            raise ValueError("请求必须是 JSON 对象")
    except ValueError as e:
        print(json.dumps({"ok": False, "code": EXIT_USAGE, "data": None,
                          "error": {"kind": "bad_json", "detail": str(e)}},
                         ensure_ascii=False))
        return EXIT_USAGE
    try:
        resp = rpc(req)
    except RpcError as e:
        print(json.dumps({"ok": False, "code": e.code, "data": None,
                          "error": {"kind": "daemon_unreachable",
                                    "detail": e.message}}, ensure_ascii=False))
        return e.code
    print(json.dumps(resp, ensure_ascii=False))
    return 0 if resp.get("ok") else _code_to_exit(resp)


def cmd_stream(args):                                          # noqa: ARG001
    """常驻通道：把 stdin 的一行行请求转给守护进程，把它吐的每一行写回 stdout。

        stdin   一行一条请求（可以带 `rid`，带了的才会收到推送）
        stdout  一行一条：响应带 `rid`，通知带 `seq`

    它是一个字节泵，不是第二套协议实现：不解析、不校验、不重排、不做任何用户态
    缓冲（读多少写多少）。

    "不做用户态缓冲"是整条背压链上唯一可能引入无界缓冲的地方，所以它必须没有。
    链条这样闭合：

        客户端不读 stdout
          → 本进程阻塞在 write(1)            （内核管道缓冲满）
          → 它不再 read(socket)              （单线程，顺序执行）
          → 守护进程的 send 拿到 EAGAIN
          → 它按水位丢推送（响应绝不丢）

    中间任何一级加了队列，这条链就断了，而断掉的症状是"内存慢慢涨"，指不回任何
    一行。

    它不加限速：它以用户自己的身份跑，限自己防不了任何东西；而"一个判据两处实现
    会漂"，漂的方向是心跳发不出去、被判定孤儿、scancel。限流的权威位置只有守护
    进程那一处。

    它不加空闲超时：它不理解心跳的语义（谁在心跳、多久算超时，是 session.js 的
    事）。按"多久没说话"在这里关连接，会在用户只是停下来看界面的时候把通道掐掉。

    两个方向的限长不一样（请求 64 KiB / 响应 4 MiB），但这里一条都不实现：请求那
    一侧由守护进程的 `CONN_IN_MAX` 管，响应那一侧由 `RPC_MAX_RESPONSE_BYTES` 管。
    此处再加一遍就是第三份真相。
    """
    path = socket_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(STREAM_CONNECT_TIMEOUT)
    try:
        s.connect(path)
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout) as e:
        sys.stderr.write(
            "无法连接 Slurmate 守护进程（%s）：%s\n"
            "请确认控制节点上 slurmate-sessiond 正在运行：\n"
            "  systemctl status slurmate-sessiond\n" % (path, e))
        return EXIT_NODAEMON
    except OSError as e:
        sys.stderr.write("连接守护进程失败（%s）：%s\n" % (path, e))
        return EXIT_NODAEMON
    # 连上之后不再有超时：这是一条常驻通道，空闲是正常的。
    s.settimeout(None)

    sel = selectors.DefaultSelector()
    sel.register(0, selectors.EVENT_READ, "in")
    sel.register(s, selectors.EVENT_READ, "sock")
    in_closed = False
    try:
        while True:
            for key, _mask in sel.select():
                if key.data == "in":
                    try:
                        data = os.read(0, 65536)
                    except OSError:
                        data = b""
                    if not data:
                        # stdin 关了（客户端退出）。半关，不是断开：已经发出去的
                        # 请求还要把响应收回来，而守护进程那边正是靠"半关 ≠
                        # 断线"把响应写完的。
                        try:
                            sel.unregister(0)
                        except (KeyError, ValueError):
                            pass
                        try:
                            s.shutdown(socket.SHUT_WR)
                        except OSError:
                            pass
                        in_closed = True
                        continue
                    s.sendall(data)          # 阻塞写：背压靠它往上游传
                else:
                    try:
                        data = s.recv(65536)
                    except OSError as e:
                        sys.stderr.write("与守护进程的通道断了：%s\n" % e)
                        return EXIT_NODAEMON
                    if not data:
                        # 两种"对面关了"要分开：
                        #   · 我们自己先半关过（客户端收摊了），这是正常的终点，
                        #     退出码 0。守护进程会在 EOF_LINGER 之后把这半条关掉，
                        #     所以走到这里就是"该发的都发完了"。
                        #   · 没半关过，就是守护进程不在了，报 5 让客户端去重连。
                        if not in_closed:
                            sys.stderr.write("守护进程关闭了通道\n")
                            return EXIT_NODAEMON
                        return EXIT_OK
                    _write_all(1, data)      # 阻塞写：背压靠它往上游传
    except KeyboardInterrupt:
        return EXIT_OK
    except BrokenPipeError:
        # stdout 没了（客户端进程退出了）。不是错误：走的人不需要解释。
        return EXIT_OK
    finally:
        try:
            sel.close()
        except Exception:                                    # noqa: BLE001
            pass
        try:
            s.close()
        except OSError:
            pass


def _write_all(fd, data):
    """往一个阻塞 fd 写完。写不完就一直写，这就是背压本身。

    不用 `print` / `sys.stdout`：那是带缓冲的文本层，而这条通道上跑的是字节
    （一行 JSON，可能很长）。文本层会引入一层用户态缓冲，正是上面那条链要避免
    的东西。
    """
    view = memoryview(data)
    while view:
        n = os.write(fd, view)
        if n <= 0:
            raise OSError("写标准输出失败")
        view = view[n:]


def cmd_whoami(args):
    r = call({"op": "whoami"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    print("用户      : %s (uid=%s)" % (d.get("user"), d.get("uid")))
    print("家目录    : %s" % d.get("home"))
    if d.get("can_submit"):
        print("计算账户  : %s" % d.get("account"))
    else:
        print("计算账户  : 无（%s）" % (d.get("account_error") or "未分配"))
    ap = d.get("allowed_partitions")
    print("可用分区  : %s" % ("不限" if ap is None else ", ".join(ap)))
    return 0


def cmd_partitions(args):
    r = call({"op": "partitions"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    print("%-12s %-8s %-14s %-12s %-24s %s"
          % ("分区", "默认", "时间上限", "每节点核数", "GRES", "说明"))
    print("-" * 98)
    for p in d["partitions"]:
        mark = "" if p.get("allowed") else "  [无权限]"
        # 三态，与协议同一条规矩：键不存在 = 服务端查不到（它没有说"没有"的
        # 资格），有值 = 查到了。
        cpus = p.get("cpus_per_node")
        cpus_text = ("%d" % cpus) if isinstance(cpus, int) else "（获取失败）"
        # GRES 那一列同理：`gres` 这个键不存在 = 服务端查不到，`[]` = 确实
        # 一个都没配。
        if "gres" not in p:
            gres = "（获取失败）"
        else:
            gres = "、".join("%s×%d" % (gres_label(e), e.get("per_node_max") or 0)
                             for e in p["gres"]) or "无"
        print("%-12s %-8s %-14s %-12s %-24s %s%s"
              % (p["name"], "是" if p.get("is_default") else "",
                 p.get("max_time") or "无上限", cpus_text, gres,
                 p.get("reason", ""), mark))
    print()
    print("「每节点核数」是 `-c` 的上限（有效核数，保留核已经扣掉）。")
    print("GRES 那一列是每个节点最多几个（`--gres` 就是按节点算的）。")
    print("不指定 --partition 时，会把有权限、装得下的分区一起交给 Slurm，")
    print("由它选择最早能开始的那个；落到哪个在作业进队列之后才定得下来。")
    print("缺省资源是按插件的，见 `slurmate plugins`。")
    return 0


def cmd_plugins(args):
    r = call({"op": "plugins"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    # 缺省资源那一列比别的宽：它装四样（核 / 内存 / 时限 / 卡），因为它们回答的
    # 是同一个问题（"这个插件缺省给多少"）。分成几列的话，管理员问"这个插件缺省
    # 配的什么"就要横着读几个地方。
    print("%-14s %-8s %-9s %-30s %-10s %s"
          % ("插件", "状态", "版本", "缺省资源", "分发", "说明"))
    print("-" * 104)
    # 「本站支不支持分发」的判据是顶层有没有 `limits`（见守护进程 `op_plugins`
    # 的注释）。
    _has_delivery = isinstance(d.get("limits"), dict)
    for p in d["plugins"]:
        df = p.get("defaults") or {}
        # 分发那一列（账本 F37）：判据是顶层 `limits` 加这一项的 `package`，三态
        # 是「老守护进程 / 支持但这一份的包不见了 / 有一份包」。判据选错的后果是：
        # 这一列会对每一个站点都显示 `—`（连最新那一个也说"这一版守护进程不支持
        # 分发"），一句系统并不知道的话。
        if not _has_delivery:
            _deliv = "—"
        elif p.get("package") is None:
            _deliv = "缺"
        else:
            _deliv = "1 个包"
        # 时限那一格在老守护进程上是缺席的，与这一屏其它地方同一个惯例：缺席显示
        # `?`，不替它编一个值。
        #
        # 卡那一格相反：没配就不说。`null`（本站确实没给这个插件配默认卡）与
        # "这一格不在"（老守护进程）在这一屏上是同一句话，而两者都不是"有卡但数量
        # 不明"，写一个 `—` 会让人那样读。
        print("%-14s %-8s %-9s %-30s %-10s %s"
              % (p.get("name"), "已启用" if p.get("enabled") else "已停用",
                 p.get("version") or "?",
                 "%s 核 / %s / %s%s" % (
                     df.get("cpus"), df.get("mem"), df.get("time") or "?",
                     (" / " + gres_text(df["gpus"])) if df.get("gpus") else ""),
                 _deliv, p.get("title") or ""))

    # 那些没能加载的包（账本 F22）必须出现在这一屏上，否则这一屏说的就是"本站有
    # 这几个插件"，而真相是"另外还有几个因为撞名/撞 id 没被加载"。少了这一段，
    # 运维看到的是"本站没有这个插件"，方向从第一步就错了。
    _probs = d.get("problems") or []
    if _probs:
        print()
        print("本站有 %d 个插件未能加载（它们不在上面的表里）：" % len(_probs))
        for _x in _probs:
            print("  · %s" % _x)
    if not d["plugins"]:
        # 零插件是合法状态，不是"这台机器坏了"。所以这里给的是出路，不是故障
        # 描述：看到"一个都没有"时的第一个问题就是"该往哪放"，答案必须在这一屏里。
        print("  （本站没有安装任何插件）")
        print()
        print("这是合法状态：守护进程照常运行，已有会话照常能查、能停，")
        print("只是没有可提交的服务。装插件：")
        print("  sudo slurmate plugin install <作者发布的 .splug>")
        print("  或者从一个目录整批对齐：sudo slurmate plugin install --from <目录>")
        # 站点上的插件只能是一个包：把源码树目录直接放进去会被（正确地）拒绝。
        # 装出来的是一棵树加一份记录表（`<ULID>/` 与 `<ULID>.json`），容器只在
        # 两段运输里活着，站点盘上不留它。
        print("站点上的插件是一棵树加一份记录表（`<ULID>/` 与 `<ULID>.json`）：")
        print("  · 源码树直接放上去会被拒绝（它没有记录表，也不该有）；")
        print("  · 包（.splug）要在作者那边用 packer build 打出来，再 plugin install；")
        print("  · 装完之后那个包不在盘上了，容器只是运输形状。")
        return 0
    print()
    print("只有【已启用】的插件能提交（slurmate submit --service-kind <名字>）。")
    print("缺省资源由服务端定并在提交时钳制，客户端不填这些值。")
    # 「分发」那一列的口径写出来：它只对已启用的插件有意义（客户端只来取启用的
    # 那些），而 `—` 表示这一版守护进程不支持分发，不是一个数字。
    if _has_delivery:
        # 只有一条投递方式：整包一次取走。
        print("「分发」= 客户端连上之后要把整个包取走一次（只取已启用的；")
        print("  而这个包是站点从盘上那份目录树现打的，盘上没有现成的容器）。")
        print("  单份上限 %s，另有份数与总量上限；客户端取两边的更严者。"
              % _human_bytes(d["limits"].get("file_bytes")))
        _pb = d["limits"].get("package_bytes")
        if isinstance(_pb, int):
            print("  整包上限 %s，它是链路上的约束（base64 之后要装进一条应答），"
                  "与上面那三个负载内的上限不是一个口径。"
                  % _human_bytes(_pb))
    else:
        print("「分发」显示为 — ：这一版守护进程不支持插件分发"
              "（它的响应里没有 `limits`，客户端不会来取）。")
    print()
    print("id 是这个插件的全球唯一标识（铸造出来、永不改变），客户端靠它 + 版本")
    print("在自己的插件池里找配套的那一半。名字只是本站的短名，日志和配置文件名用它。")
    return 0


def cmd_submit(args):
    # 所有字段都是可选的：不传 = 让服务端用它的默认值（2 核 / 8G / 随机分区）。
    # 这里【不】替服务端填默认值：客户端填了就等于客户端说了算，而"省略字段"
    # 必须表达"用你的默认"，不是"我要 0 核"。
    req = {"op": "submit"}
    if args.partition:
        req["partition"] = args.partition
    if args.cpus:
        req["cpus"] = args.cpus
    if args.mem:
        req["mem"] = args.mem
    # `--no-gres` 发的是显式 `null`，与"没写 `--gres`"是两件事：不写 = 用这个
    # 插件的 `default_gpus`；写了 `--no-gres` = 不占，盖过它。（两者互斥由
    # argparse 的 add_mutually_exclusive_group 保证。）
    if args.no_gres:
        req["gres"] = None
    elif args.gres:
        g, gerr = parse_gres_spec(args.gres)
        if gerr:
            print("--gres %s：%s" % (args.gres, gerr), file=sys.stderr)
            return 2
        req["gres"] = g
    if args.time:
        req["time"] = args.time
    if args.service_kind:
        req["service_kind"] = args.service_kind
    if args.ssh_pubkey:
        req["ssh_pubkey"] = args.ssh_pubkey
    r = call(req, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    res = d.get("resources") or {}
    gt = gres_text(res.get("gres"))
    print("已提交：作业 %s（会话 %s）" % (d.get("job_id"), d.get("session_id")))
    print("插件 %s" % (req.get("service_kind") or "（本站的 default_plugin）"))
    print("分区 %s，时间上限 %s" % (d.get("partition") or "（由 Slurm 决定）",
                                   d.get("requested_time")))
    print("资源 %s 核 / %s%s" % (res.get("cpus"), res.get("mem"),
                                "，%s" % gt if gt else ""))
    if d.get("warning"):
        # 服务端替用户做了决定（截断时间、回退内存、没按他以为的方式挑分区）时
        # 必须说出来：静默地替他决定，他会以为自己要到了。
        print("[注意] %s" % d["warning"], file=sys.stderr)
    print()
    print("下一步：等待调度完成后即可连接。")
    print("  slurmate wait --session %s" % d.get("session_id"))
    return 0


def cmd_status(args):
    req = {"op": "status"}
    if args.session:
        req["session_id"] = args.session
    r = call(req, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    print_session(r["data"].get("session"))
    return 0


def cmd_list(args):
    r = call({"op": "list"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    rows = r["data"]["sessions"]
    if not rows:
        print("（没有会话记录）")
        return 0
    print("%-18s %-8s %-14s %-22s %s"
          % ("会话 ID", "作业", "状态", "隧道目标", "剩余"))
    print("-" * 78)
    for s in rows:
        print("%-18s %-8s %-14s %-22s %s"
              % (s.get("session_id"), s.get("job_id") or "-",
                 human_state(s.get("state")), s.get("tunnel_target") or "-",
                 fmt_left(s.get("expires_at"))))
    return 0


def cmd_wait(args):
    """轮询直到会话登记完成（拿到隧道目标）或失败/超时。"""
    deadline = time.time() + args.timeout
    last = None
    while time.time() < deadline:
        try:
            r = rpc({"op": "status", "session_id": args.session})
        except RpcError as e:
            print(e.message, file=sys.stderr)
            return e.code
        if not r.get("ok"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                err = r.get("error") or {}
                print("[错误] %s" % (err.get("detail") or err.get("kind")),
                      file=sys.stderr)
            return _code_to_exit(r)
        s = r["data"].get("session") or {}
        st = s.get("state")
        if not args.json and st != last:
            print("状态: %s%s" % (human_state(st),
                                 "" if st != "submitted" else "（排队中）"))
            last = st
        if s.get("tunnel_target"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print()
                print("就绪：隧道目标 %s" % s["tunnel_target"])
                if s.get("auth_password"):
                    # 只有需要口令的插件才有这个字段（中转站走公钥，永远没有口令）。
                    # 这里不写死插件名：加第三个插件时它不该变成一句谎话。
                    print("会话口令 %s（%s）"
                          % (s["auth_password"], s.get("service_kind") or "?"))
            return 0
        if st in ("released", "rejected", "expired", "orphaned"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print("[失败] 会话已结束：%s" % human_state(st), file=sys.stderr)
                if s.get("note"):
                    print("  原因: %s" % s.get("note"), file=sys.stderr)
            return EXIT_REJECTED
        time.sleep(args.interval)
    print("[超时] 等待超过 %ds 仍未就绪" % args.timeout, file=sys.stderr)
    return EXIT_SLURM


def cmd_heartbeat(args):
    return _simple({"op": "heartbeat", "session_id": args.session}, args,
                   "心跳已发送")


def cmd_stopjob(args):
    # 协议里那条 op 仍然叫 `goodbye`（客户端与它逐字同源）；命令行这一个动词
    #   叫 `stopjob`：它做的就是取消这条会话的作业。
    return _simple({"op": "goodbye", "session_id": args.session}, args,
                   "已请求释放会话")


def _simple(req, args, okmsg):
    r = call(req, args.json, timeout=20.0)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    print("%s（状态: %s）" % (okmsg, human_state(r["data"].get("state"))))
    # 协议里 `warning` 这个字段存在的唯一理由就是被显示出来，命令行也是客户端。
    # `goodbye` 用它说"这一次 scancel 没成功，我在继续重试"，而那句话没人看见的
    # 话，用户就会以为作业已经停了。
    _w = r["data"].get("warning")
    if _w:
        print("[注意] %s" % _w, file=sys.stderr)
    return 0


def cmd_doctor(args):
    r = call({"op": "doctor"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    ok = "✓"
    bad = "✗"
    print("Slurmate 守护进程自检")
    print("  socket 存在        : %s" % (ok if d.get("socket") else bad))
    print("  nft 表存在         : %s" % (ok if d.get("table") else bad))
    print("  规则可读           : %s" % (ok if d.get("rules_readable") else bad))
    print("  ACL 规则数         : %s" % d.get("rules_count"))
    print("  活跃会话数         : %s" % d.get("active_sessions"))
    print("  规则与会话一致     : %s" % (ok if d.get("consistent") else bad))
    print("  未登记的会话数     : %s" % d.get("pending_sessions", "?"))
    print("  端口池             : %s-%s" % tuple(d.get("port_range", ["?", "?"])))
    print("  守护进程版本       : %s" % d.get("version", "?"))
    print("  上次对账           : %s"
          % ("从未完成" if d.get("last_tick_at") is None
             else "%s 秒前" % d.get("tick_age_seconds")))
    if d.get("last_tick_error"):
        print("  上次对账出错       : %s" % d.get("last_tick_error"))
    probs = d.get("problems")
    if isinstance(probs, list):
        print("  不变量检查         : 检查了 %s 项，%s"
              % (d.get("checked", "?"),
                 "全部通过" if not probs else "发现 %d 个问题" % len(probs)))
        for p in probs:
            print("    %s %s" % (bad, (p or {}).get("detail")
                                  or (p or {}).get("key") or "未说明"))
    else:
        # 没有这一格的是旧守护进程。不能拿"它没报问题"当"没有问题"。
        print("  不变量检查         : ?（守护进程没有 problems 这一格，版本过低）")
    ex = d.get("existing") or {}
    print("  --- 现有系统（只读检查，本系统不碰它们）---")
    print("    控制节点 inet codeserver 表 : %s"
          % (ok if ex.get("codeserver_table") else bad))
    print("    port-daemon DNAT 表        : %s"
          % (ok if ex.get("portdaemon_table") else bad))
    # 检查要能真的失败：有问题、或者对面太旧而根本没检查，退出码都非零 ——
    #   脚本里那句 `&&` 才不会把"说不清"读成"通过"。
    return 0 if probs == [] else 1


def cmd_gc(args):
    """清理自己家目录里的陈旧会话文件（本命令不连守护进程）。"""
    home = os.path.expanduser("~")
    d = os.path.join(home, ".slurmate", "sessions")
    if not os.path.isdir(d):
        print("没有需要清理的内容（%s 不存在）" % d)
        return 0
    removed = 0
    kept = 0
    now = time.time()
    for name in sorted(os.listdir(d)):
        if not name.startswith("job-"):
            continue
        p = os.path.join(d, name)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if not os.path.isfile(p) or os.path.islink(p):
            continue
        if now - st.st_mtime > args.older_than:
            if args.dry_run:
                print("  将删除 %s（%.1f 天未更新）"
                      % (name, (now - st.st_mtime) / 86400))
            else:
                os.unlink(p)
                print("  已删除 %s" % name)
            removed += 1
        else:
            kept += 1
    print("扫描完成：删除 %d 个，保留 %d 个%s"
          % (removed, kept, "（dry-run，未实际删除）" if args.dry_run else ""))
    return 0


