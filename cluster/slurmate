#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
slurmate — Slurmate 用户态 CLI
==============================================================================

以【普通用户身份】运行，通过 unix socket 与 slurmate-sessiond 通信。
身份认证完全由守护进程侧 getsockopt(SO_PEERCRED) 完成，本程序不发送任何身份信息。

对客户端（Electron）的稳定接口是 `slurmate rpc`：
    从 stdin 读一行 JSON 请求，向 stdout 写一行 JSON 响应。
客户端应以【固定 argv】调用它，请求体走 stdin：

    ssh -T -o BatchMode=yes -p 10100 user@host -- /usr/local/bin/slurmate rpc

这样命令行是编译期常量，用户输入永远不可能出现在 SSH 命令串里 ——
从构造上消除注入，而不是靠"记得别用某个词"。

退出码：
    0 成功 / 2 用法错误 / 3 未找到 / 4 被拒绝（配额、权限、账户）/
    5 守护进程不可达 / 6 Slurm 或提交失败 / 7 触发限流
"""

import argparse
import json
import os
import selectors
import socket
import subprocess
import sys
import time

# ★ 框架版本是 **x.y**（`major` 无上限、`minor` ∈ 0..255，禁止前导零）。
#   三处声明（client/package.json、cluster/slurmate-sessiond、本文件）必须逐字相同，
#   由 .github/workflows/checks.yml 断言。
VERSION = "0.8"
DEFAULT_SOCKET = "/run/slurmate-session/ctl.sock"
DEFAULT_SESSIOND = "/usr/local/sbin/slurmate-sessiond"

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NOTFOUND = 3
EXIT_REJECTED = 4
EXIT_NODAEMON = 5
EXIT_SLURM = 6
EXIT_RATELIMIT = 7


# 一条应答最多读多少字节。
#
# ★ 这是**链路**上最窄的那一节，协议里那几个上限都是从它反推的（不是反过来）：
#   守护进程一次最多发一个 `PLUGIN_PACKAGE_MAX_BYTES`（2 MiB）的包，base64 膨胀
#   4/3 ⇒ 约 2.7 MiB，再加一层 JSON 信封 —— 4 MiB 是约 1.5 倍余量。
#
# ★ 这个数与守护进程的 PLUGIN_PACKAGE_MAX_BYTES **是从两侧各写一遍的**，所以有一条
#   用例钉着两者的关系（`cluster/test-sessiond-logic.py` 的 19.11d）。从前这里是
#   1 MiB，而站点通报的**总量**上限恰好也是 1 MiB —— 于是"整包一次发"那个数是一句
#   假话：1 MiB 的负载 base64 之后是 1.33 MiB，根本读不完。症状还会被认错：这里报
#   "响应太大"，而客户端把它归成 `daemon_unreachable`（code 5）并**退避重试** ——
#   一次"文件太大"会被报成"控制节点上的守护进程没有响应"。
RPC_MAX_RESPONSE_BYTES = 4 << 20

# `slurmate stream` 连上守护进程要等多久。连上之后**不再有任何超时** ——
# 它是常驻通道，空闲是正常的。
STREAM_CONNECT_TIMEOUT = 40.0


def socket_path():
    """socket 的位置。

    ★ 这里此前会去读 /etc/slurmate/slurmate.conf 找 `socket_path`，用逐行扫描
      加手工切 `#` 的方式。现在不读了，原因有两条：

      一是那个键没有了 —— socket 路径与 systemd 单元的 RuntimeDirectory 是同一个
      事实，写在两处就有一处会过期。守护进程那边现在从常量取，这边必须取同一个。

      二是这条路本来就脆弱：CLI 是【用户身份】的进程，它对配置文件的解析能力
      决定了它能不能连上守护进程，而它用的是与守护进程完全不同的解析器（一个
      configparser、一个手写扫描）。配置文件末尾多一个空行、注释换一种写法，
      两边就可能对同一个文件得出不同的结论 —— 而症状只是"连不上守护进程"。
      客户端只经 `rpc` 进来，它的失败模式必须是确定的。
    """
    return DEFAULT_SOCKET


def sessiond_path():
    """守护进程那个脚本在哪。

    ★ 为什么 CLI 要去找它：**安装器长在那份脚本里**，不在这里。读一个 `.splug`、
      验签、判断包里有没有作业侧 —— 这几件事守护进程本来就要做，而且各自只能有
      一份实现。这里再抄一份的失效方式是这一版最想避免的那种：**装得上、守护进程
      不认**，症状要到用户点提交时才出现。

    所以 `plugin install` 只是一层壳：找到那份脚本、把参数原样转发过去。
    与 deploy.sh 调 `--check-plugins` 是同一个路子（它也是直接跑那份脚本）。

    ★ 覆盖用的环境变量叫 `SLURMATE_SESSIOND`：部署脚本把守护进程装在
      `<prefix>/sbin/slurmate-sessiond`，而前缀可以改，所以留一个出口。
    """
    return os.environ.get("SLURMATE_SESSIOND") or DEFAULT_SESSIOND


def cmd_plugin_install(args):
    """`slurmate plugin install <文件…>` —— 把作者发布的 `.splug` 装到本站。

    ★ 与这台机器上的 `slurmate` 其余动词不同，它**不经 socket、不连守护进程**：
      它是一个管理动作（要以 root 跑，写的是 `<prefix>/share/slurmate/plugins/`），
      与"这台机器上的守护进程此刻在不在"无关。
    """
    if os.geteuid() != 0:
        # 早说。装进去的包会成为**每一个用户提交的作业**的一部分，所以这件事
        # 只能 root 做 —— 让它在写文件那一刻以 EACCES 失败，报出来的会是一句
        # 权限错误，而管理员要的是"该加 sudo"。
        print("装插件要以 root 运行：包会落到 <prefix>/share/slurmate/plugins/，\n"
              "而它的作业侧会被编织进每一个用户提交的作业。\n"
              "  sudo slurmate plugin install %s"
              % " ".join(args.files), file=sys.stderr)
        return EXIT_REJECTED

    exe = sessiond_path()
    if not os.path.isfile(exe):
        print("找不到守护进程脚本 %s —— 安装器在它里面。\n"
              "  · 部署过的话，检查它是不是在别的 prefix 下，用 SLURMATE_SESSIOND "
              "指过去；\n"
              "  · 还没部署的话，先跑 cluster/deploy.sh。" % exe, file=sys.stderr)
        return EXIT_NOTFOUND

    argv = [sys.executable, exe, "--install-plugins"] + list(args.files)
    if args.plugins_dir:
        argv += ["--plugins-dir", args.plugins_dir]
    if args.replace_key:
        argv += ["--replace-key", args.replace_key]
    # ★ 不用 os.execv：留一层能让退出码原样传上去，也让这条路在用例里跑得动
    #   （execv 会把跑用例的那个进程换掉）。
    try:
        return subprocess.run(argv).returncode
    except OSError as e:
        print("启动安装器失败（%s）：%s" % (exe, e), file=sys.stderr)
        return EXIT_NODAEMON


def rpc(req, timeout=40.0):
    """向守护进程发一行 JSON，读回一行 JSON。失败抛 RpcError。"""
    path = socket_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout) as e:
        s.close()
        raise RpcError(EXIT_NODAEMON,
                       "无法连接 Slurmate 守护进程（%s）：%s\n"
                       "请确认控制节点上 slurmate-sessiond 正在运行：\n"
                       "  systemctl status slurmate-sessiond" % (path, e))
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "连接守护进程失败（%s）：%s" % (path, e))
    try:
        s.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf and len(buf) < RPC_MAX_RESPONSE_BYTES:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        s.close()
        raise RpcError(EXIT_NODAEMON, "守护进程响应超时")
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "与守护进程通信失败：%s" % e)
    finally:
        try:
            s.close()
        except OSError:
            pass
    # ★ 先说"读不下了"，再说"解析不了"。这两件事的症状一样（`json.loads` 都失败），
    #   但原因差得远：截断的那一份报出来会是「响应不是合法 JSON」，于是下一次有人
    #   会去查守护进程为什么不响应 —— 而真正的原因是**这个响应本来就很大**。
    #
    #   什么响应会这么大：`plugin_package` 一次发一整个包（base64 之后还要大三分
    #   之一），或者插件多得那份逐文件的清单本身就装不下。所以出路是"少装几个插件
    #   / 让作者把包做小"，不是"重启守护进程"。
    if b"\n" not in buf and len(buf) >= RPC_MAX_RESPONSE_BYTES:
        raise RpcError(EXIT_SLURM,
                       "守护进程的响应超过了 %d 字节，这一条读不完整。\n"
                       "多半是插件的整包太大（`plugin_package` 一次发一整个包，"
                       "base64 之后还要大三分之一）。\n"
                       "这不是守护进程没响应 —— 是这一条应答本身超出了 CLI 的读取"
                       "上限。\n"
                       "要真的放宽，得同时抬这里的 RPC_MAX_RESPONSE_BYTES 与守护"
                       "进程的 PLUGIN_PACKAGE_MAX_BYTES —— 只抬一边等于把这句话往后"
                       "挪一格。" % RPC_MAX_RESPONSE_BYTES)
    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise RpcError(EXIT_NODAEMON, "守护进程返回了空响应")
    try:
        return json.loads(line.decode("utf-8"))
    except ValueError as e:
        raise RpcError(EXIT_NODAEMON, "守护进程返回的响应不是合法 JSON：%s" % e)


class RpcError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def call(req, want_json=False, timeout=40.0):
    """发 RPC 并按需渲染。返回退出码。"""
    try:
        resp = rpc(req, timeout=timeout)
    except RpcError as e:
        if want_json:
            print(json.dumps({"ok": False, "code": e.code, "data": None,
                              "error": {"kind": "daemon_unreachable",
                                        "detail": e.message}},
                             ensure_ascii=False))
        else:
            print(e.message, file=sys.stderr)
        return e.code

    if want_json:
        print(json.dumps(resp, ensure_ascii=False))
        return 0 if resp.get("ok") else _code_to_exit(resp)

    if not resp.get("ok"):
        err = resp.get("error") or {}
        print("[错误] %s" % (err.get("detail") or err.get("kind") or "未知错误"),
              file=sys.stderr)
        return _code_to_exit(resp)
    return resp


def _code_to_exit(resp):
    code = resp.get("code", 1)
    if code == 2:
        return EXIT_USAGE
    if code == 3:
        return EXIT_NOTFOUND
    if code == 4:
        return EXIT_REJECTED
    if code == 5:
        return EXIT_NODAEMON
    if code == 6:
        return EXIT_SLURM
    if code == 7:
        return EXIT_RATELIMIT
    return 1


def _human_bytes(n):
    """给人看的字节数。守护进程那一侧有一份同名的，两边都是给人看输出的 —— 它们是
    两个独立安装的程序（CLI 在 <prefix>/bin，守护进程在 <prefix>/sbin），不共享模块，
    所以这点重复是布局带来的，不是抄漏了。"""
    try:
        n = int(n)
    except (TypeError, ValueError):
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return "%d B" % n if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024.0


def human_state(state):
    return {
        "reserved": "已分配端口",
        "submitted": "已提交，等待调度",
        "enrolled": "运行中",
        "suspect": "连接中断（作业仍在运行）",
        "orphaned": "判定异常退出，正在释放",
        "releasing": "正在释放",
        "released": "已结束",
        "rejected": "已拒绝",
        "expired": "已过期",
    }.get(state, state)


def parse_gres_spec(s):
    """`--gres` 的取值 → 描述符。**写法就是 sbatch 那个**：`名字[:型号]:数量`。

    空串 = 没要（返回 `(None, None)`）。这里只做**拆词**，不判名字合不合法 ——
    那是服务端的事（它不认识的一切都会拒），而且拒的那句话由服务端说，
    两边各写一套判断就会漂成"这里放过去了、那边说不认识"。

    ★ 这个函数与守护进程的 `gres_spec()` 是一对（一个拆、一个拼）。它们住在两个
      文件里，因为 CLI 与守护进程是**两个独立安装的程序**（见 _human_bytes 那段
      说明）。一对拆/拼会漂开，所以 `cluster/test-sessiond-logic.py` 里有一条
      往返用例把两个文件都抠出来真跑。
    """
    s = (s or "").strip()
    if not s:
        return None, None
    parts = s.split(":")
    if len(parts) == 2:
        name, typ, cnt = parts[0], None, parts[1]
    elif len(parts) == 3:
        name, typ, cnt = parts[0], parts[1], parts[2]
    else:
        return None, ("写不对：要「名字:数量」或「名字:型号:数量」，"
                      "例如 gpu:2 / gpu:a100:2")
    if not cnt.isdigit():
        return None, "数量必须是整数，得到 %r" % cnt
    return {"name": name, "type": typ or None, "count": int(cnt)}, None


def gres_label(g):
    """描述符 → 名字（不含数量）：`gpu` 或 `gpu:a100`。

    ★ 守护进程里有一份同名的。两边是**两个独立安装的程序**（CLI 在 <prefix>/bin、
      守护进程在 <prefix>/sbin），不共享模块 —— 与 `_human_bytes` 同一情形。
      要盯的不是这两份（它们只是给人看的字），而是**拆词与拼词那一对**：
      `parse_gres_spec()` 与守护进程的 `gres_spec()` 必须互相认得，
      `cluster/test-sessiond-logic.py` 里有一条往返用例把两个文件都抠出来真跑。
    """
    if not isinstance(g, dict) or not g.get("name"):
        return "?"
    return "%s:%s" % (g["name"], g["type"]) if g.get("type") else g["name"]


def gres_text(g):
    """描述符 → 人话（`gpu:a100 × 2`）。给人看的输出用；`--json` 出的是原样结构。"""
    if not isinstance(g, dict) or not g.get("name"):
        return None
    return "%s × %s" % (gres_label(g), g.get("count"))


def fmt_left(expires_at):
    if not expires_at:
        return "-"
    left = int(expires_at - time.time())
    if left <= 0:
        return "已到期"
    h, rem = divmod(left, 3600)
    m, _ = divmod(rem, 60)
    if h >= 24:
        return "%dd %dh" % (h // 24, h % 24)
    return "%dh %dm" % (h, m)


def print_session(s, verbose=True):
    if not s:
        print("（没有活跃会话）")
        return
    print("会话 ID   : %s" % s.get("session_id"))
    print("状态      : %s" % human_state(s.get("state")))
    if s.get("job_id"):
        print("作业 ID   : %s" % s.get("job_id"))
    res = s.get("resources") or {}
    gt = gres_text(res.get("gres"))
    print("分区      : %s" % (s.get("partition") or "（Slurm 默认）"))
    print("资源      : %s 核 / %s%s"
          % (res.get("cpus") or "?", res.get("mem") or "?",
             "，%s" % gt if gt else ""))
    if s.get("tunnel_target"):
        print("隧道目标  : %s" % s.get("tunnel_target"))
        print("连          : ssh -N -L <本地端口>:%s ..." % s.get("tunnel_target"))
    if s.get("expires_at"):
        print("剩余时间  : %s" % fmt_left(s.get("expires_at")))
        if s.get("time_limit"):
            print("时间上限  : %s（已续期 %s 次）"
                  % (s.get("time_limit"), s.get("renew_count", 0)))
    if s.get("node"):
        print("节点      : %s (%s)" % (s.get("node"), s.get("node_ip")))
    if s.get("note"):
        print("备注      : %s" % s.get("note"))


