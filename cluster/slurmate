def build_parser():
    ap = argparse.ArgumentParser(
        prog="slurmate",
        description="Slurmate — 远程开发会话管理（客户端请用 `slurmate rpc`）")
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd")

    def add(name, fn, help_text, **kw):
        p = sub.add_parser(name, help=help_text, **kw)
        p.set_defaults(func=fn)
        return p

    p = add("rpc", cmd_rpc, "从 stdin 读 JSON 请求、向 stdout 写 JSON 响应（客户端入口）")

    # 常驻版：一条连接上可以问很多次，服务端还会主动说。老客户端继续用 rpc，
    # 两者是**同一个状态机**，差别只在客户端什么时候关（见守护进程的 Conn）。
    p = add("stream", cmd_stream,
            "常驻通道：stdin 一行一条请求、stdout 一行一条（响应带 rid，通知带 seq）")

    # `plugin` 是一个**管理**动词（要 root），与其余那些用户动词不是一类 ——
    # 所以它有自己的一层子命令，而不是 `slurmate install-plugin` 这样一个动词名。
    p = add("plugin", None, "管理本站的插件（装包；要 root）")
    psub = p.add_subparsers(dest="plugin_cmd")
    pi = psub.add_parser("install", help="把作者发布的 .splug 装到本站")
    pi.add_argument("files", nargs="*", metavar="包",
                    help="一个或多个 .splug 文件（作者 `packer build` 的产物）")
    pi.add_argument("--from", dest="from_dir", default=None, metavar="目录",
                    help="**目录模式**：这次要装的整批包取自这个目录，而站点的"
                         "插件集合随之对齐 —— 上一次由本模式装过、这次目录里没有"
                         "了的包会被卸掉。空目录合法（= 本站一个插件都没有）")
    pi.add_argument("--plugins-dir", default="",
                    help="装到这个目录而不是安装目录（排查用；此时不动站点配置）")
    pi.add_argument("--replace-key", default=None, metavar="旧指纹",
                    help="确认「这个 id 换了签名者」（§2.5）。取值必须是记录里"
                         "那把旧指纹 —— 确认要有依据，不是随手加一个开关")
    pi.add_argument("--config", default="",
                    help="站点配置文件。省略 = 用守护进程的缺省路径"
                         "（/etc/slurmate/slurmate.conf）")
    pi.set_defaults(func=cmd_plugin_install)

    pu = psub.add_parser("uninstall", help="把插件从本站卸掉")
    pu.add_argument("ids", nargs="*", metavar="id",
                    help="插件的 id（26 位 ULID —— 是**身份**，不是短名）。"
                         "看本站装了哪些：`slurmate plugins`")
    pu.add_argument("--all", action="store_true",
                    help="卸掉本站的**全部**插件（不给 id）")
    pu.add_argument("--plugins-dir", default="",
                    help="用这个插件目录而不是安装目录（排查用）")
    pu.add_argument("--config", default="",
                    help="站点配置文件。省略 = 用守护进程的缺省路径"
                         "（/etc/slurmate/slurmate.conf）")
    pu.set_defaults(func=cmd_plugin_uninstall)

    ps = psub.add_parser(
        "sync", help="把站点的两份派生物（插件配置、作业脚本）与插件目录对齐")
    ps.add_argument("--plugins-dir", default="",
                    help="用这个插件目录对账而不是安装目录（排查用；此时什么都"
                         "不对齐）")
    ps.add_argument("--config", default="",
                    help="站点配置文件。省略 = 用守护进程的缺省路径"
                         "（/etc/slurmate/slurmate.conf）")
    ps.set_defaults(func=cmd_plugin_sync)

    p = add("whoami", cmd_whoami, "显示当前用户、计算账户与可用分区")
    p.add_argument("--json", action="store_true")

    p = add("partitions", cmd_partitions, "列出可用的分区及其时间上限")
    p.add_argument("--json", action="store_true")

    p = add("plugins", cmd_plugins, "列出本站的插件、开关状态与缺省资源")
    p.add_argument("--json", action="store_true")

    p = add("submit", cmd_submit, "提交一个开发会话（所有参数都可省略）")
    p.add_argument("--partition", help="分区（省略则从有权限的分区里随机挑一个）")
    p.add_argument("--cpus", type=int,
                   help="CPU 核心数（省略 = 该插件的服务端默认）")
    p.add_argument("--mem", help="内存，如 8G（省略 = 该插件的服务端默认）")
    _gres = p.add_mutually_exclusive_group()
    _gres.add_argument("--gres",
                       help="要哪种 GRES、几个，写法同 sbatch：名字[:型号]:数量，"
                            "例如 gpu:2 / gpu:a100:2 / mps:100。省略 = 用**该插件**"
                            "的默认（`slurmate plugins` 那一列）。"
                            "本站有哪些、每个节点最多几个，看 `slurmate partitions`")
    _gres.add_argument("--no-gres", action="store_true",
                       help="明确**不占** GRES，盖过该插件的默认 —— 与"
                            "「没写 --gres」是两件事")
    p.add_argument("--time",
                   help="时间上限，如 12:00:00（省略 = 该插件的缺省时限；"
                        "到期会自动续期）")
    p.add_argument("--service-kind",
                   help="插件名。见 `slurmate plugins`。省略时用配置里的 "
                        "default_plugin；没配就是必填（没有内建缺省 —— 隐式缺省"
                        "会让装/卸一个插件悄悄改变行为）")
    p.add_argument("--ssh-pubkey",
                   help="一行 ssh-ed25519 公钥。清单元数据里要求公钥的插件"
                        "（contributes.submitPubkey）必填，否则服务端回 code 2")
    p.add_argument("--json", action="store_true")

    p = add("status", cmd_status, "查看会话状态")
    p.add_argument("--session", help="会话 ID（省略则取最近一个活跃会话）")
    p.add_argument("--json", action="store_true")

    p = add("list", cmd_list, "列出自己的会话记录")
    p.add_argument("--json", action="store_true")

    p = add("wait", cmd_wait, "等待会话就绪（拿到隧道目标）")
    p.add_argument("--session", required=True)
    p.add_argument("--timeout", type=int, default=300)
    p.add_argument("--interval", type=float, default=2.0)
    p.add_argument("--json", action="store_true")

    p = add("heartbeat", cmd_heartbeat, "发送心跳（客户端周期调用）")
    p.add_argument("--session", required=True)
    p.add_argument("--json", action="store_true")

    p = add("goodbye", cmd_goodbye, "结束会话并释放资源")
    p.add_argument("--session", required=True)
    p.add_argument("--json", action="store_true")

    p = add("stop", cmd_goodbye, "同 goodbye")
    p.add_argument("--session", required=True)
    p.add_argument("--json", action="store_true")

    p = add("doctor", cmd_doctor, "诊断守护进程与 nft 规则状态")
    p.add_argument("--json", action="store_true")

    p = add("gc", cmd_gc, "清理自己家目录里的陈旧会话文件")
    p.add_argument("--older-than", type=int, default=7 * 86400,
                   help="超过多少秒未更新才清理（默认 7 天）")
    p.add_argument("--dry-run", action="store_true")
    return ap


def main():
    ap = build_parser()
    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help()
        return EXIT_USAGE
    if not hasattr(args, "json"):
        args.json = False
    try:
        return args.func(args)
    except KeyboardInterrupt:
        return 130
    except RpcError as e:
        print(e.message, file=sys.stderr)
        return e.code


if __name__ == "__main__":
    sys.exit(main())
