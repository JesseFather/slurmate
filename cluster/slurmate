              % (p["name"], "是" if p.get("is_default") else "",
                 p.get("max_time") or "无上限", gres, p.get("reason", ""), mark))
    print()
    print("GRES 那一列是**每个节点**最多几个（`--gres` 就是按节点算的）。")
    print("不指定 --partition 时，会从有权限的分区里随机挑一个。")
    print("缺省资源是**按插件**的，见 `slurmate plugins`。")
    return 0


def cmd_plugins(args):
    r = call({"op": "plugins"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    # ★ 缺省资源那一列比别的宽：它现在装四样（核 / 内存 / 时限 / 卡），因为它们
    #   回答的是**同一个问题**（"这个插件缺省给多少"）。分成几列的话，管理员问
    #   "这个插件缺省配的什么"就要横着读几个地方。
    print("%-14s %-8s %-9s %-30s %-10s %s"
          % ("插件", "状态", "版本", "缺省资源", "分发", "说明"))
    print("-" * 104)
    # 「本站支不支持分发」的判据是**顶层有没有 `limits`**（见守护进程 `op_plugins`
    # 的注释：v0.6 那个判据是"这一项里有没有 files"，而 v0.7 把 files 删掉了）。
    _has_delivery = isinstance(d.get("limits"), dict)
    for p in d["plugins"]:
        df = p.get("defaults") or {}
        # ★★ 分发那一列（账本 **F37**）：这里从前读的是 `p.get("files")` ——
        #   那个字段**在 v0.7 就删掉了**（两条投递方式并成一条），于是这一列
        #   **永远**显示 `—`，而下面那句解释说的是"这一版守护进程不支持分发"。
        #   ⇒ CLI 会对**每一个**站点说这句话，**包括最新那一个**：一句系统并不
        #   知道的话，与这个仓库一路在清的是同一类。
        #   今天的判据是顶层 `limits` + 这一项的 `package`（三态：老守护进程 /
        #   支持但这一份的包不见了 / 有一份包）。
        if not _has_delivery:
            _deliv = "—"
        elif p.get("package") is None:
            _deliv = "缺"
        else:
            _deliv = "1 个包"
        # ★ 时限那一格在**老守护进程**上是缺席的（v0.11 才加进 `defaults`）——
        #   与这一屏其它地方同一个惯例：缺席显示 `?`，不替它编一个值。
        # ★ 卡那一格相反：**没配就不说**。`null`（本站确实没给这个插件配默认卡）
        #   与"这一格不在"（老守护进程）在这一屏上是同一句话，而两者都**不是**
        #   "有卡但数量不明" —— 写一个 `—` 会让人那样读。
        print("%-14s %-8s %-9s %-30s %-10s %s"
              % (p.get("name"), "已启用" if p.get("enabled") else "已停用",
                 p.get("version") or "?",
                 "%s 核 / %s / %s%s" % (
                     df.get("cpus"), df.get("mem"), df.get("time") or "?",
                     (" / " + gres_text(df["gpus"])) if df.get("gpus") else ""),
                 _deliv, p.get("title") or ""))

    # ★★ 那些**没能加载**的包（账本 **F22**）必须出现在这一屏上 —— 否则这一屏
    #   说的就是"本站有这几个插件"，而真相是"另外还有几个因为撞名/撞 id 没被
    #   加载"。少了这一段，运维看到的是"本站没有这个插件"，方向从第一步就错了。
    _probs = d.get("problems") or []
    if _probs:
        print()
        print("★ 本站有 %d 个插件**没能加载**（它们不在上面的表里）：" % len(_probs))
        for _x in _probs:
            print("  · %s" % _x)
    if not d["plugins"]:
        # ★ 零插件是**合法状态**，不是"这台机器坏了"。所以这里给的是出路，
        #   不是故障描述 —— 而 99% 的人看到"一个都没有"时的第一个问题是"那我
        #   该往哪放"，所以答案必须在这一屏里。
        print("  （本站没有安装任何插件）")
        print()
        print("这是合法状态：守护进程照常运行，已有会话照常能查、能停，")
        print("只是没有可提交的服务。装插件：")
        print("  sudo slurmate plugin install <作者发布的 .splug>")
        print("  或者从一个目录整批对齐：sudo slurmate plugin install --from <目录>")
        # ★ 这里从前写的是"把插件目录放进 plugins/" —— 那是**源码树布局**时代的
        #   说法，现在放进去的东西会（正确地）被拒绝：站点上的插件只能是一个包。
        # ★ v0.13 起站点上装出来的是**一棵树 + 一份记录表**（`<ULID>/` 与
        #   `<ULID>.json`）—— 容器只在两段运输里活着，站点盘上不留它。
        print("站点上的插件是**一棵树 + 一份记录表**（`<ULID>/` 与 `<ULID>.json`）：")
        print("  · 源码树直接放上去会被拒绝（它没有记录表，也不该有）；")
        print("  · 包（.splug）要在作者那边用 packer build 打出来，再 plugin install；")
        print("  · 装完之后那个包**不在盘上**了 —— 容器只是运输形状。")
        return 0
    print()
    print("只有【已启用】的插件能提交（slurmate submit --service-kind <名字>）。")
    print("缺省资源由服务端定并在提交时钳制 —— 客户端不填这些值。")
    # 「分发」那一列的口径写出来：它**只对已启用的插件有意义**（客户端只来取
    # 启用的那些），而 `—` 表示这一版守护进程不支持分发，不是一个数字。
    if _has_delivery:
        # ★ v0.7 起**只有一条投递方式**：整包一次取走。这里从前印的是"两条投递
        #   方式"那一套（逐份 N 次 RPC / 整包 1 次）—— 与上面那一列同一个毛病：
        #   描述的是一个已经不在的世界。
        print("「分发」= 客户端连上之后要把**整个包**取走一次（只取已启用的；")
        print("  而这个包是站点从盘上那棵树**现打**的 —— 盘上没有现成的容器）。")
        print("  单份上限 %s，另有份数与总量上限；客户端取两边的更严者。"
              % _human_bytes(d["limits"].get("file_bytes")))
        _pb = d["limits"].get("package_bytes")
        if isinstance(_pb, int):
            print("  整包上限 %s —— 它是**链路**上的约束（base64 之后要装进一条"
                  "应答），与上面那三个负载内的上限不是一个口径。"
                  % _human_bytes(_pb))
    else:
        print("「分发」显示为 — ：这一版守护进程不支持插件分发"
              "（它的响应里没有 `limits`，客户端不会来取）。")
    print()
    print("id 是这个插件的全球唯一标识（铸造出来、永不改变），客户端靠它 + 版本")
    print("在自己的插件池里找配套的那一半。名字只是本站的短名，日志和配置文件名用它。")
    return 0


def cmd_submit(args):
    # 所有字段都是可选的：不传 = 让服务端用它的默认值（2 核 / 8G / 随机分区）。
    # 这里【不】替服务端填默认值 —— 客户端填了就等于客户端说了算，
    # 而"省略字段"必须表达"用你的默认"，不是"我要 0 核"。
    req = {"op": "submit"}
    if args.partition:
        req["partition"] = args.partition
    if args.cpus:
        req["cpus"] = args.cpus
    if args.mem:
        req["mem"] = args.mem
    # ★ `--no-gres` 发的是**显式 `null`**，与"没写 `--gres`"是两件事：
    #   不写 = 用**这个插件的** `default_gpus`；写了 `--no-gres` = 不占，盖过它。
    #   （两者互斥由 argparse 的 add_mutually_exclusive_group 保证。）
    if args.no_gres:
        req["gres"] = None
    elif args.gres:
        g, gerr = parse_gres_spec(args.gres)
        if gerr:
            print("--gres %s：%s" % (args.gres, gerr), file=sys.stderr)
            return 2
        req["gres"] = g
    if args.time:
        req["time"] = args.time
    if args.service_kind:
        req["service_kind"] = args.service_kind
    if args.ssh_pubkey:
        req["ssh_pubkey"] = args.ssh_pubkey
    r = call(req, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    res = d.get("resources") or {}
    gt = gres_text(res.get("gres"))
    print("已提交：作业 %s（会话 %s）" % (d.get("job_id"), d.get("session_id")))
    print("插件 %s" % (req.get("service_kind") or "（本站的 default_plugin）"))
    print("分区 %s，时间上限 %s" % (d.get("partition") or "（Slurm 默认）",
                                   d.get("requested_time")))
    print("资源 %s 核 / %s%s" % (res.get("cpus"), res.get("mem"),
                                "，%s" % gt if gt else ""))
    if d.get("warning"):
        # 服务端替用户做了决定（截断时间、回退内存、没按他以为的方式挑分区）
        # 时必须说出来 —— 静默地替他决定，他会以为自己要到了。
        print("[注意] %s" % d["warning"], file=sys.stderr)
    print()
    print("下一步：等待调度完成后即可连接 ——")
    print("  slurmate wait --session %s" % d.get("session_id"))
    return 0


def cmd_status(args):
    req = {"op": "status"}
    if args.session:
        req["session_id"] = args.session
    r = call(req, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    print_session(r["data"].get("session"))
    return 0


def cmd_list(args):
    r = call({"op": "list"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    rows = r["data"]["sessions"]
    if not rows:
        print("（没有会话记录）")
        return 0
    print("%-18s %-8s %-14s %-22s %s"
          % ("会话 ID", "作业", "状态", "隧道目标", "剩余"))
    print("-" * 78)
    for s in rows:
        print("%-18s %-8s %-14s %-22s %s"
              % (s.get("session_id"), s.get("job_id") or "-",
                 human_state(s.get("state")), s.get("tunnel_target") or "-",
                 fmt_left(s.get("expires_at"))))
    return 0


def cmd_wait(args):
    """轮询直到会话登记完成（拿到隧道目标）或失败/超时。"""
    deadline = time.time() + args.timeout
    last = None
    while time.time() < deadline:
        try:
            r = rpc({"op": "status", "session_id": args.session})
        except RpcError as e:
            print(e.message, file=sys.stderr)
            return e.code
        if not r.get("ok"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                err = r.get("error") or {}
                print("[错误] %s" % (err.get("detail") or err.get("kind")),
                      file=sys.stderr)
            return _code_to_exit(r)
        s = r["data"].get("session") or {}
        st = s.get("state")
        if not args.json and st != last:
            print("状态: %s%s" % (human_state(st),
                                 "" if st != "submitted" else "（排队中）"))
            last = st
        if s.get("tunnel_target"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print()
                print("就绪：隧道目标 %s" % s["tunnel_target"])
                if s.get("auth_password"):
                    # 只有需要口令的插件才有这个字段（中转站走公钥，永远没有口令）。
                    # 这里不写死插件名 —— 加第三个插件时它不该变成一句谎话。
                    print("会话口令 %s（%s）"
                          % (s["auth_password"], s.get("service_kind") or "?"))
            return 0
        if st in ("released", "rejected", "expired", "orphaned"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print("[失败] 会话已结束：%s" % human_state(st), file=sys.stderr)
                if s.get("note"):
                    print("  原因: %s" % s.get("note"), file=sys.stderr)
            return EXIT_REJECTED
        time.sleep(args.interval)
    print("[超时] 等待超过 %ds 仍未就绪" % args.timeout, file=sys.stderr)
    return EXIT_SLURM


def cmd_heartbeat(args):
    return _simple({"op": "heartbeat", "session_id": args.session}, args,
                   "心跳已发送")


def cmd_goodbye(args):
    return _simple({"op": "goodbye", "session_id": args.session}, args,
                   "已请求释放会话")


def _simple(req, args, okmsg):
    r = call(req, args.json, timeout=20.0)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    print("%s（状态: %s）" % (okmsg, human_state(r["data"].get("state"))))
    # ★ 协议里 `warning` 这个字段存在的**唯一**理由就是被显示出来 —— 命令行也是
    #   客户端。`goodbye` 用它说"这一次 scancel 没成功，我在继续重试"，
    #   而那句话没人看见的话，用户就会以为作业已经停了。
    _w = r["data"].get("warning")
    if _w:
        print("[注意] %s" % _w, file=sys.stderr)
    return 0


def cmd_doctor(args):
    r = call({"op": "doctor"}, args.json)
    if isinstance(r, int):
        return r          # --json 或出错时，call() 已经把退出码算好了
    if not isinstance(r, dict):
        return 1
    d = r["data"]
    ok = "✓"
    bad = "✗"
    print("Slurmate 守护进程自检")
    print("  socket 存在        : %s" % (ok if d.get("socket") else bad))
    print("  nft 表存在         : %s" % (ok if d.get("table") else bad))
    print("  规则可读           : %s" % (ok if d.get("rules_readable") else bad))
    print("  ACL 规则数         : %s" % d.get("rules_count"))
    print("  活跃会话数         : %s" % d.get("active_sessions"))
    print("  规则与会话一致     : %s" % (ok if d.get("consistent") else bad))
    print("  端口池             : %s-%s" % tuple(d.get("port_range", ["?", "?"])))
    ex = d.get("existing") or {}
    print("  --- 现有系统（只读体检，本系统不碰它们）---")
    print("    控制节点 inet codeserver 表 : %s"
          % (ok if ex.get("codeserver_table") else bad))
    print("    port-daemon DNAT 表        : %s"
          % (ok if ex.get("portdaemon_table") else bad))
    return 0


def cmd_gc(args):
    """清理自己家目录里的陈旧会话文件（本命令不连守护进程）。"""
    home = os.path.expanduser("~")
    d = os.path.join(home, ".slurmate", "sessions")
    if not os.path.isdir(d):
        print("没有需要清理的内容（%s 不存在）" % d)
        return 0
    removed = 0
    kept = 0
    now = time.time()
    for name in sorted(os.listdir(d)):
        if not name.startswith("job-"):
            continue
        p = os.path.join(d, name)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if not os.path.isfile(p) or os.path.islink(p):
            continue
        if now - st.st_mtime > args.older_than:
            if args.dry_run:
                print("  将删除 %s（%.1f 天未更新）"
                      % (name, (now - st.st_mtime) / 86400))
            else:
                os.unlink(p)
                print("  已删除 %s" % name)
            removed += 1
        else:
            kept += 1
    print("扫描完成：删除 %d 个，保留 %d 个%s"
          % (removed, kept, "（dry-run，未实际删除）" if args.dry_run else ""))
    return 0


