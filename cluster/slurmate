def cmd_wait(args):
    """轮询直到会话登记完成（拿到隧道目标）或失败/超时。"""
    deadline = time.time() + args.timeout
    last = None
    while time.time() < deadline:
        try:
            r = rpc({"op": "status", "session_id": args.session})
        except RpcError as e:
            print(e.message, file=sys.stderr)
            return e.code
        if not r.get("ok"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                err = r.get("error") or {}
                print("[错误] %s" % (err.get("detail") or err.get("kind")),
                      file=sys.stderr)
            return _code_to_exit(r)
        s = r["data"].get("session") or {}
        st = s.get("state")
        if not args.json and st != last:
            print("状态: %s%s" % (human_state(st),
                                 "" if st != "submitted" else "（排队中）"))
            last = st
        if s.get("tunnel_target"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print()
                print("就绪：隧道目标 %s" % s["tunnel_target"])
                if s.get("auth_password"):
                    # 只有需要口令的插件才有这个字段（中转站走公钥，永远没有口令）。
                    # 这里不写死插件名 —— 加第三个插件时它不该变成一句谎话。
                    print("会话口令 %s（%s）"
                          % (s["auth_password"], s.get("service_kind") or "?"))
            return 0
        if st in ("released", "rejected", "expired", "orphaned"):
            if args.json:
                print(json.dumps(r, ensure_ascii=False))
            else:
                print("[失败] 会话已结束：%s" % human_state(st), file=sys.stderr)
                if s.get("note"):
                    print("  原因: %s" % s.get("note"), file=sys.stderr)
            return EXIT_REJECTED
        time.sleep(args.interval)
    print("[超时] 等待超过 %ds 仍未就绪" % args.timeout, file=sys.stderr)
    return EXIT_SLURM


