#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
slurmate — Slurmate 用户态 CLI
==============================================================================

以【普通用户身份】运行，通过 unix socket 与 slurmate-sessiond 通信。
身份认证完全由守护进程侧 getsockopt(SO_PEERCRED) 完成，本程序不发送任何身份信息。

对客户端（Electron）的稳定接口是 `slurmate rpc`：
    从 stdin 读一行 JSON 请求，向 stdout 写一行 JSON 响应。
客户端应以【固定 argv】调用它，请求体走 stdin：

    ssh -T -o BatchMode=yes -p 10100 user@host -- /usr/local/bin/slurmate rpc

这样命令行是编译期常量，用户输入永远不可能出现在 SSH 命令串里 ——
从构造上消除注入，而不是靠"记得别用某个词"。

退出码：
    0 成功 / 2 用法错误 / 3 未找到 / 4 被拒绝（配额、权限、账户）/
    5 守护进程不可达 / 6 Slurm 或提交失败 / 7 触发限流
"""

import argparse
import json
import os
import socket
import sys
import time

VERSION = "0.5.0"
DEFAULT_SOCKET = "/run/slurmate-session/ctl.sock"

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_NOTFOUND = 3
EXIT_REJECTED = 4
EXIT_NODAEMON = 5
EXIT_SLURM = 6
EXIT_RATELIMIT = 7


def socket_path():
    """socket 的位置。

    ★ 这里此前会去读 /etc/slurmate/slurmate.conf 找 `socket_path`，用逐行扫描
      加手工切 `#` 的方式。现在不读了，原因有两条：

      一是那个键没有了 —— socket 路径与 systemd 单元的 RuntimeDirectory 是同一个
      事实，写在两处就有一处会过期。守护进程那边现在从常量取，这边必须取同一个。

      二是这条路本来就脆弱：CLI 是【用户身份】的进程，它对配置文件的解析能力
      决定了它能不能连上守护进程，而它用的是与守护进程完全不同的解析器（一个
      configparser、一个手写扫描）。配置文件末尾多一个空行、注释换一种写法，
      两边就可能对同一个文件得出不同的结论 —— 而症状只是"连不上守护进程"。
      客户端只经 `rpc` 进来，它的失败模式必须是确定的。
    """
    return DEFAULT_SOCKET


def rpc(req, timeout=40.0):
    """向守护进程发一行 JSON，读回一行 JSON。失败抛 RpcError。"""
    path = socket_path()
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout) as e:
        s.close()
        raise RpcError(EXIT_NODAEMON,
                       "无法连接 Slurmate 守护进程（%s）：%s\n"
                       "请确认控制节点上 slurmate-sessiond 正在运行：\n"
                       "  systemctl status slurmate-sessiond" % (path, e))
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "连接守护进程失败（%s）：%s" % (path, e))
    try:
        s.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf and len(buf) < 1 << 20:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        s.close()
        raise RpcError(EXIT_NODAEMON, "守护进程响应超时")
    except OSError as e:
        s.close()
        raise RpcError(EXIT_NODAEMON, "与守护进程通信失败：%s" % e)
    finally:
        try:
            s.close()
        except OSError:
            pass
    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise RpcError(EXIT_NODAEMON, "守护进程返回了空响应")
    try:
        return json.loads(line.decode("utf-8"))
    except ValueError as e:
        raise RpcError(EXIT_NODAEMON, "守护进程返回的响应不是合法 JSON：%s" % e)


class RpcError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def call(req, want_json=False, timeout=40.0):
    """发 RPC 并按需渲染。返回退出码。"""
    try:
        resp = rpc(req, timeout=timeout)
    except RpcError as e:
        if want_json:
            print(json.dumps({"ok": False, "code": e.code, "data": None,
                              "error": {"kind": "daemon_unreachable",
                                        "detail": e.message}},
                             ensure_ascii=False))
        else:
            print(e.message, file=sys.stderr)
        return e.code

    if want_json:
        print(json.dumps(resp, ensure_ascii=False))
        return 0 if resp.get("ok") else _code_to_exit(resp)

    if not resp.get("ok"):
        err = resp.get("error") or {}
        print("[错误] %s" % (err.get("detail") or err.get("kind") or "未知错误"),
              file=sys.stderr)
        return _code_to_exit(resp)
    return resp


def _code_to_exit(resp):
    code = resp.get("code", 1)
    if code == 2:
        return EXIT_USAGE
    if code == 3:
        return EXIT_NOTFOUND
    if code == 4:
        return EXIT_REJECTED
    if code == 5:
        return EXIT_NODAEMON
    if code == 6:
        return EXIT_SLURM
    if code == 7:
        return EXIT_RATELIMIT
    return 1


def human_state(state):
    return {
        "reserved": "已分配端口",
        "submitted": "已提交，等待调度",
        "enrolled": "运行中",
        "suspect": "连接中断（作业仍在运行）",
        "orphaned": "判定异常退出，正在释放",
        "releasing": "正在释放",
        "released": "已结束",
        "rejected": "已拒绝",
        "expired": "已过期",
    }.get(state, state)


def fmt_left(expires_at):
    if not expires_at:
        return "-"
    left = int(expires_at - time.time())
    if left <= 0:
        return "已到期"
    h, rem = divmod(left, 3600)
    m, _ = divmod(rem, 60)
    if h >= 24:
        return "%dd %dh" % (h // 24, h % 24)
    return "%dh %dm" % (h, m)


def print_session(s, verbose=True):
    if not s:
        print("（没有活跃会话）")
        return
    print("会话 ID   : %s" % s.get("session_id"))
    print("状态      : %s" % human_state(s.get("state")))
    if s.get("job_id"):
        print("作业 ID   : %s" % s.get("job_id"))
    res = s.get("resources") or {}
    print("分区      : %s" % (s.get("partition") or "（Slurm 默认）"))
    print("资源      : %s 核 / %s%s"
          % (res.get("cpus") or "?", res.get("mem") or "?",
             "，GPU %s" % res.get("gpus") if res.get("gpus") else ""))
    if s.get("tunnel_target"):
        print("隧道目标  : %s" % s.get("tunnel_target"))
        print("连          : ssh -N -L <本地端口>:%s ..." % s.get("tunnel_target"))
    if s.get("expires_at"):
        print("剩余时间  : %s" % fmt_left(s.get("expires_at")))
        if s.get("time_limit"):
            print("时间上限  : %s（已续期 %s 次）"
                  % (s.get("time_limit"), s.get("renew_count", 0)))
    if s.get("node"):
        print("节点      : %s (%s)" % (s.get("node"), s.get("node_ip")))
    if s.get("note"):
        print("备注      : %s" % s.get("note"))


