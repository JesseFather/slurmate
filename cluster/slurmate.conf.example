# ==============================================================================
#  slurmate.conf — Slurmate 集群侧配置
# ==============================================================================
#
#  格式：`键 = 值`，# 起注释（行首与行尾都可以），值里不能含 #，空行忽略。
#  同一个键写两遍是【错误】—— 写两遍说明作者对哪个生效有不同看法，而任何
#  "取最后一个"的选择都会让其中一处永远不被执行。拼错的键同样是错误。
#
#  两种行形态：
#
#      键 = 值              ← 站点通用。【必须写在所有块之前】
#      [plugin:名字]        ← 插件块。块存在 = 这个插件装上了，
#                             块里 enabled = yes 才是真的开着。
#
#  ⚠️ 块一旦开始就没有回头路：块之后写的通用键会落进那个块，然后被拒。
#     把通用键都放在文件上半部分，插件块放后面。
#
#  读者：
#    slurmate-sessiond   全部键
#    cluster/deploy.sh   range_start / range_end / reserved_ranges / readonly_paths
#    slurmate（用户 CLI）【不读本文件】—— socket 路径是编译期常量，见下。
#
#  本文件由 root 拥有（0644）。守护进程把它读到的**所有**值当作可信输入，
#  但绝不允许用户进程修改它 —— 部署脚本会断言属主与权限。
#
#  修改后：systemctl restart slurmate-sessiond
#
# ── 通用段里只有「无法从系统推导」的值 ──────────────────────────────────────
#  分区名、分区的时间上限、GPU 型号 —— 这些 Slurm 自己知道，写在这里就是第二份
#  副本。副本会与实际分叉，而分叉了没有任何东西会告诉你。所以它们全部现查：
#  分区来自 `scontrol show partition`，权限来自 `sacctmgr show assoc`。
#
# ── 插件块里放的是「插件的策略」，不是站点事实 ──────────────────────────────
#  比如默认资源（一个 shell 和一个跑语言服务器的 IDE 不是一回事）、可执行文件
#  路径、认证方式。这些既不是系统事实也不是 Slurm 事实，所以它们归插件自己。
# ==============================================================================


# ── 集群网段 ────────────────────────────────────────────────────────────────
#
# 用于 nft 的基础规则 `ip daddr != <CIDR> accept`：即使前面所有校验都被绕过，
# 也影响不到本网段之外的流量。
#
# ⚠️ 只能写【一个】CIDR，登录节点与计算节点都必须落在里面。多网段集群目前
#    无法表达，见 docs/DEPLOYMENT.md 的前置条件。
#
# ⚠️ 这里【故意留空】，因为它没有安全的默认值。填错的后果不是报错，而是
#    【全部 ACL 静默失效】：会话的 drop 规则追加在链尾，而链首那条基础规则会把
#    去往网段外计算节点的流量直接放行 —— 链的 policy 是 accept，没有任何迹象。
#    所以自检会拒绝启动，而不是替你猜一个。写法：
#
#        cluster_cidr = <网络地址>/<前缀长度>      例如 192.0.2.0/24
#
#    （上面那个地址是文档示例，**请换成你的集群网段**。自检不拦它 —— 用
#      192.0.2.0/24 的测试集群是存在的，软件没有依据判定它不是真的 ——
#      但启动时会与 Slurm 的 NodeAddr 交叉核对，对不上就拒绝启动并点名。）
cluster_cidr =

# 共享家目录的挂载点，多个用空格分隔。deploy.sh 用它渲染 systemd 单元的
# ReadOnlyPaths。
#
# 为什么可以只读：守护进程【从不写】用户家目录 —— 口令由作业自己生成并写进
# 0600 的会话文件，会话文件也由作业自己创建。root 身上没有"写用户文件"这条
# 攻击面。留空则生成的单元不含该行，这层保护随之消失（deploy.sh 会警告）。
readonly_paths = /shared/home


# ── 端口池 ──────────────────────────────────────────────────────────────────
#
# 范围由你定，唯一的要求是：与集群上【其他端口管理系统】的区间完全不交，
# 并把那些区间写进下面的 reserved_ranges。
#
# 为什么必须不交：nftables 对【同 hook 同 priority 的跨表求值顺序没有保证】，
# 两个表都匹配同一个 dport 时，谁先求值是未定义的。集合不交能让判决与顺序无关。
range_start = 55001
range_end = 55999

# 需要避让的其他端口区间，格式 "起-止,起-止"（逗号分隔）。留空表示没有。
# 守护进程启动时与部署脚本预检时都会断言与本端口池不交。
#
# 例子：若你的集群上另有一套端口分配方案占用 5000-49999（用户端口）与
# 50000-55000（DNAT 外部端口），就写成：
#   reserved_ranges = 5000-49999,50000-55000
reserved_ranges =

# 每次提交分配给该会话的候选端口数。作业脚本会逐个试，
# 某个端口被同节点的其他作业占用时自动试下一个。
candidates_per_session = 6


# ── Slurm 与作业 ────────────────────────────────────────────────────────────
#
# Slurm 命令的路径。留空 = 运行时自动查找（先查 PATH，再依次查
# /usr/bin、/usr/local/bin、/opt/slurm/bin、/usr/sbin、/bin、/sbin）。
#
# 为什么要能自动查找：Slurm 的安装位置因集群而异 —— 发行版包在 /usr/bin，
# 源码编译的常在 /opt/slurm/bin。此前"留空"其实是一句谎话（代码里只有
# `or "/usr/bin/sbatch"` 硬兜底），于是装在 /opt/slurm/bin 的集群照抄本示例
# 会直接起不来，报的还是"Slurm 命令不存在: /usr/bin/sbatch"。
#
# 留空是推荐值。只有当自动查找会找错（比如机器上有两套 Slurm）时才写死。
sbatch =
scancel =
squeue =
scontrol =
sacctmgr =

# 作业日志写到用户的 ~/.slurmate/logs/ 下。这是与 run.sbatch 的约定，
# 不是站点参数 —— 改它要让两边同时改，所以它不再是配置项。

# ==============================================================================
#  插件 —— 一个块 = 一个已安装的插件
# ==============================================================================
#
#  目前有两个：
#
#    code-server —— 浏览器里的 IDE
#    sshd        —— 用户态 ssh，供原生 VS Code Remote-SSH、codex 这类
#                   【要求 ssh 连接】的工具用（它们没法直接 ssh 到计算节点）
#
# ★ 「装了」和「开着」是两件事，别混：
#
#       块在不在    →  这个插件**装没装**（决定它的配置从哪来）
#       enabled     →  它**开没开**（决定用户能不能提交它）
#
#   一个块都没有时，默认开着的是 code-server —— 与升级前完全一致。而写一个块
#   **不会**顺手把 code-server 关掉（那是管理员只想开中转站、结果所有人 IDE
#   没了的经典事故），也**不会**因为"块在那儿"就自动开启 sshd（那会让一句
#   default_cpus = 1 在没有任何显式同意的情况下开出一条交互式 ssh 的路）。
#   想开就写 enabled = yes。
#
#   块内认不出的键同样会报错 —— 写成 defualt_cpus 不能被静默忽略。
#
#   全部块都关掉是**合法**的（站点可能只想留框架），但自检会说出来，否则表现
#   是"客户端上一个按钮都没有"而配置里一个字都不像有问题。

# ── plugin:code-server ──────────────────────────────────────────────────────
[plugin:code-server]

enabled = yes

# 缺省资源。客户端【高级选项】里不填时用这一组 —— 界面上显示为"管理员设定"，
# 用户改不了（要改就是展开高级选项做一次性覆盖，不持久化）。
default_cpus = 2
default_mem = 8G

# 作业模板里 code-server 的路径（在【计算节点】上）。
#
# 留空 = 先在本机 PATH 里找（大多数集群的登录节点与计算节点软件布局一致），
# 找不到就退回 /usr/local/bin/code-server。
#
# ⚠️ 守护进程在登录节点上运行，它【无法确认】计算节点上这个路径是否存在 ——
#    这是设计上必然的（它没有也不能在计算节点上执行命令）。所以这一项找错了
#    只会在作业启动时才暴露，`--check` 会把它是否解析得到如实打印出来。
bin =

# code-server 的认证方式。
#
#   password  作业自己生成一个随机口令（写进 0600 的会话文件），
#             code-server 以 --auth password 启动；客户端自动完成登录，用户无感。
#   none      以 --auth none 启动，保护完全依赖 nft ACL。
#
# ⚠️ 为什么默认是 password，以及这个默认值为什么不该改
# ─────────────────────────────────────────────────
# nft ACL 的 hook 点是【登录节点的 output 链】，也就是"登录节点自己发出的包"。
# 它拦得住"登录节点上的其他用户连你的端口"，但拦不住"另一个作业恰好被调度到
# 同一台计算节点之后直接 curl 你的端口" —— 那条流量根本不经过登录节点。
#
# 这不是某个集群的配置问题，而是这个架构的固有边界：绝大多数集群的计算节点
# 上没有任何 per-user 网络隔离（cgroup 没有 net_cls/net_prio，主机防火墙
# 也不按 UID 区分），而本机进程访问本机 IP 走的是 lo，通常被放行。
# 在采用本方案前，请自行确认你的计算节点上是否真的存在这样的隔离 ——
# 若没有，`--auth none` 意味着同节点上任何人一个 curl 就完整拿到你的 IDE：
# 你的终端、你的文件读写权，全部以你的身份运行。共享家目录 0700 之类的
# 保护恰好被绕过，因为攻击者用的是你的身份。
#
# 改回 none 之前，请先确认你有别的手段覆盖这个缺口。
auth_mode = password

# ── plugin:sshd ─────────────────────────────────────────────────────────────
#
# ★ 开启之前请读完这一段，因为它牵涉一条站点策略。
#
#   sshd 分支会在计算节点上以【作业属主】身份起一个用户态 sshd。它**读不到**
#   站点的 ssh 准入策略：非 root 的 sshd 只能用 UsePAM no，PAM 栈整个不跑，
#   /etc/security/access.conf 里的规则（以及 pam_access）从不执行。这是结构性的，
#   改配置救不了 —— 任何"给用户一个 sshd 登录"的方案都等价于给用户一个 sshd 登录。
#
#   它并不因此逃出监管，这一点有实测：会话的 cgroup 落在 job_<id>/step_batch 里，
#   作业一结束就被回收，连三重 setsid 想脱离的进程都活不过去。所以它给的是
#   「Slurm 分配里的一把 ssh」。但如果你所在站点的政策是"计算节点上不允许出现
#   交互式登录"，那这条就是明令禁止的 —— 所以它默认关着（下面这块是**停用**的），
#   让开启成为一个**看得见的决定**，而不是升级时悄悄多出来的能力。
#
#   要开就把下面的 enabled 改成 yes 并重启守护进程。
[plugin:sshd]

enabled = no

# 中转站里跑的是一个 shell（codex、git、编译），不是一个跑语言服务器的 IDE，
# 所以默认给得比 code-server 小。按你站点的实际情况调 ——
# 它是**策略**，不是 Slurm 事实，所以住在这里而不是现查。
default_cpus = 1
default_mem = 2G

# 作业模板里 sshd 的路径（在【计算节点】上）。
#
# 与 code-server 的 bin 不同，这一项**不做 PATH 查找**：登录节点上有没有 sshd
# 对计算节点不是证据。留空就用惯例路径 /usr/sbin/sshd。找错了只会在作业启动时
# 暴露，而 run.sbatch 会在日志里写出"$SLURMATE_SSHD_BIN 不存在或不可执行"。
bin =
