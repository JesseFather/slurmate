# 每个键的含义、取值与改错的后果：见《配置参考》（仓库里是 cluster/docs/CONFIGURATION.md）

range_start = 55001
range_end = 55999
reserved_ranges =
candidates_per_session = 6

sbatch =
scancel =
squeue =
scontrol =
sacctmgr =
sinfo =
sshare =
sacct =

max_sessions_per_user = 1
max_connections_per_user = 8

default_plugin =

# ── 会话续期 ────────────────────────────────────────────────────────────────
# 不写就是下面这几个值。这一节按注释写出来的意思是：它们本来就有一个说得通的
# 缺省，只有站点真的想改时才把那一行的 `#` 去掉。
#
#   renew_increment   每次续期加多少。它同时是界面上那个「剩余时间」的上限，
#                     也是守护进程出事之后作业还能活多久 —— 取 1 小时就是
#                     「可容忍约一小时的续期中断」。
#   renew_threshold   剩余时间少于它就续。它决定提前多久动手，也决定最后那一段
#                     里能试几次（冷却跟着它算：阈值的五分之一，30 到 300 秒）。
#   renew_max_total   一个会话累计最多活多久，到顶之后不再续。
#
# renew_increment = 1:00:00
# renew_threshold = 0:10:00
# renew_max_total = 7-00:00:00

# ── 作业日志 ────────────────────────────────────────────────────────────────
# 两个数由作业脚本执行（每 60 秒看一眼）：保留期删掉更早的整份，总量上限超了
# 就从最老的开始删。当前这个作业自己那两份永远不动。
# 写法是 1024 进制，裸数字是字节（`10G` 与 `10737418240` 是同一个值）。
#
# log_keep_days = 7
# log_dir_max_bytes = 10G
