class PluginSpec(object):
    """一个插件在【服务端】的元数据 —— 由 `<prefix>/share/slurmate/plugins/` 下
    某个目录里的 `plugin.json` **扫出来**，不是代码里写死的。

    ★ 这里刻意不写任何 `if name == "sshd"` 之类的分支。守护进程需要知道的关于一个
      插件的一切都在这个对象上；**加一个插件不该要求改守护进程的任何一行**。
    """

    def __init__(self, plugin_id, name, version, title,
                 default_cpus, default_mem,
                 default_enabled=False, needs_pubkey=False,
                 bin_env=None, bin_discovery="convention",
                 bin_name=None, bin_fallback=None, enum_keys=(),
                 source_dir=None, needs_job=False):
        # ── 身份有两层，别把它们合并 ────────────────────────────────────────
        #
        # `id` 是**铸造出来的**全球唯一标识符（ULID，26 字符，见
        # client/src/main/plugins/ulid.js）。一个插件诞生时铸一次，此后永不改变。
        # 它**不是名字** —— 名字（displayName）可以随便改，它不行。
        #
        # 为什么要有它：插件由**站点**分发，没有市场能在线升级，而站点更新频繁、
        # 也可能长期不更新。于是同一个插件在不同站点上可能叫不同的名字、可能是
        # 不同的版本。要靠名字认出"这是同一个东西"是做不到的；靠铸造出来的 id 才
        # 能。客户端据此把两个站点分发的同一个构件合成一条（只多记一个来源），
        # 又把两个不同的插件分开存放（各自标明来源）。
        #
        # `version` 是这一版的号。**会话必须把 `id@版本` 一起记下来**：作业侧与
        # 客户端侧是配套的两半，而站点一升级插件，已经跑着的作业用的仍是旧的那
        # 一版 —— 按"站点当前的版本"去解析一个已跑的会话会接错。
        self.id = plugin_id
        self.version = version
        # `name` 是**站点内**用的短名：配置块名（`[plugin:<name>]`）、提交时的
        # `service_kind`、日志与报错文案里出现的都是它。它只需要站点内唯一（由
        # 配置校验保证），不需要全球唯一 —— 全球唯一是上面那个 id 的事。
        self.name = name
        self.title = title
        # 这个插件安装时所在的目录。**只用于报错**（"哪个目录里的清单坏了"），
        # 不参与任何判定 —— 目录名不参与身份，这一点与客户端一致。
        self.source_dir = source_dir
        # 它有没有作业侧实现（`job/start.sh`）。没有的话守护进程允许提交，而作业
        # 会在 run.sbatch 里以 24 明确失败 —— 但**部署时** deploy.sh 就会断言每个
        # 插件都有这一半，所以正常路径下这个字段永远是 True（保留它是为了自检能
        # 把"这个插件没有作业侧"单独说出来）。
        self.needs_job = needs_job
        self.default_cpus = default_cpus
        self.default_mem = default_mem
        # ★ 装上了是不是就等于开着。绝大多数插件是 False：装一个插件是一次**显式
        #   的决定**，但升级是另一回事 —— 站点从旧版本升上来时，新装进来的插件
        #   不该在没有任何人同意的情况下多出一个能力。
        #
        #   为 True 的只有一种插件：它**就是升级前那个唯一可用的服务**（历史上是
        #   code-server）。这条标记存在的全部理由就是「升级不改变现有站点的行为」，
        #   而不是「这个插件比较重要」。新插件**不要**标它。
        self.default_enabled = default_enabled
        # 需要客户端随提交带一行公钥（作业内的插件把它写进 authorized_keys 之类）。
        self.needs_pubkey = needs_pubkey
        # 承载该插件可执行文件的 SLURMATE_* 环境变量名。
        self.bin_env = bin_env
        # 二进制怎么找：`which` = 先查 PATH 再查候选目录；`convention` = 只用惯例
        # 路径。差别是真实的 —— 守护进程在**登录节点**上跑，而作业跑在计算节点上，
        # 所以 which 的结果只是推测；惯例路径反而比"登录节点上恰好有这个文件"更可信。
        self.bin_discovery = bin_discovery
        # bin_discovery == "which" 时，去 PATH 里找的可执行文件名。
        self.bin_name = bin_name
        self.bin_fallback = bin_fallback
        # 取值只能是固定几种的键：(键名, 允许值, 缺省值)。放在这里而不是写一段
        # `if 插件名 == "code-server"` —— 校验规则属于插件的元数据。
        self.enum_keys = tuple(enum_keys)

    @property
    def job_entry(self):
        """作业侧的处理函数名。

        ★ 这是个**真契约**，不是文档：`run.sbatch` 的 `plugin_call` 就是这个拼法
          （短名里的 `-` 写成 `_`），deploy.sh 在编织时会断言每个插件的
          `job/start.sh` 里确实定义了这个函数。名字对不上时作业会在运行时才报
          "本站没有作业侧实现了 X 的插件"，而那是一个用户排完队之后才看到的错误。
        """
        return "start_" + self.name.replace("-", "_")

    def enum_default(self, key):
        for k, choices, default in self.enum_keys:
            if k == key:
                return default
        raise KeyError(key)

    def enum_choices(self, key):
        for k, choices, default in self.enum_keys:
            if k == key:
                return choices
        raise KeyError(key)

    def block_keys(self):
        """这个插件的配置块里允许出现的键。

        ★ 没有一份单独的"额外键"清单：取值受枚举约束的键**就是**额外键。两份清单
          的后果是它们可以互相矛盾 —— 一个键在 `enumKeys` 里却不在 `blockKeys` 里，
          表现是"校验规则写了，但用户永远写不进去"。
        """
        return PLUGIN_COMMON_KEYS + ("bin",) + tuple(k for k, _c, _d in self.enum_keys)


def parse_plugin_manifest(where, raw):
    """一份 plugin.json → `(PluginSpec, [问题…])`。

    问题一次列全，不是遇到第一个就停 —— 「改一个跑一次」是最烦人的那种自检，
    而插件清单是人手写的，一次写对三处的概率不高。
    """
    problems = []
    if not isinstance(raw, dict):
        return None, ["%s：清单的顶层必须是一个 JSON 对象，得到 %s"
                      % (where, type(raw).__name__)]

    def bad(msg):
        problems.append("%s：%s" % (where, msg))
        return None

    def need_str(key, pattern=None, what=""):
        v = raw.get(key)
        if not isinstance(v, str) or not v.strip():
            return bad("缺少非空字符串 %r" % key)
        v = v.strip()
        if pattern is not None and not pattern.match(v):
            return bad("%r 的取值 %r 不合法%s" % (key, v, what))
        return v

    pid = need_str("id", PLUGIN_ID_RE,
                   "（应为一个 26 字符的 ULID，全大写 Crockford base32。"
                   "它是**铸造**出来的、此后永不改变，不是随手起的名字）")
    name = need_str("name", PLUGIN_NAME_RE,
                    "（短名：小写字母开头，只含小写字母/数字/连字符，最长 32。"
                    "它进配置块名 `[plugin:<名字>]`，也是作业侧函数名的后缀）")
    version = need_str("version", PLUGIN_VERSION_RE, "（应为 x.y.z）")

    # displayName 只用于界面与报错文案，缺了就退回短名 —— 它不影响任何判定，
    # 所以不必为它拒绝整个插件。
    title = raw.get("displayName")
    if not isinstance(title, str) or not title.strip():
        title = name or where
    else:
        title = title.strip()

    # engines.slurmate：这个插件要求的最低框架版本。客户端那一侧也会查一遍。
    # 守护进程也要查 —— 一个要求 >=0.6.0 的插件被 0.5.0 的守护进程收下，后果是
    # 它在作业侧用了一个这边还没有的宿主能力，而症状是运行到一半才失败。
    eng = raw.get("engines")
    if isinstance(eng, dict):
        rng = eng.get("slurmate")
        if isinstance(rng, str) and rng.strip():
            ok, why = version_satisfies(VERSION, rng)
            if not ok:
                bad("要求 slurmate %s，而本站的守护进程是 %s（%s）"
                    % (rng.strip(), VERSION, why))

    site = raw.get("site")
    if site is None:
        site = {}
    if not isinstance(site, dict):
        return None, problems + ["%s：`site` 必须是一个对象" % where]

    default_cpus = None
    v = site.get("defaultCpus")
    if not isinstance(v, int) or isinstance(v, bool):
        bad("`site.defaultCpus` 必须是整数")
    elif not (1 <= v <= MAX_CPUS_REQUEST):
        bad("`site.defaultCpus` 应在 1-%d 之间，当前为 %d" % (MAX_CPUS_REQUEST, v))
    else:
        default_cpus = v

    default_mem = None
    v = site.get("defaultMem")
    if not isinstance(v, str) or not v.strip():
        bad("缺少 `site.defaultMem`（形如 8G / 512M）")
    else:
        mem, rejected = sanitize_mem(v.strip(), None)
        if rejected:
            # ★ 这里**不**回退一个默认值，直接拒绝：插件清单里写错必须当场发现。
            #   「文件里写着 0，而所有人实际拿到 8G」会一直没人发现。
            bad("`site.defaultMem` 无法识别: %r（形如 8G / 512M。注意 0 在 Slurm 里"
                "表示整台节点的内存，不是「零内存」）" % v)
        else:
            default_mem = mem

    default_enabled = site.get("defaultEnabled", False)
    if not isinstance(default_enabled, bool):
        bad("`site.defaultEnabled` 必须是 true / false")

    contrib = raw.get("contributes")
    if contrib is None:
        contrib = {}
    needs_pubkey = False
    if not isinstance(contrib, dict):
        bad("`contributes` 必须是一个对象")
    else:
        needs_pubkey = contrib.get("submitPubkey", False)
        if not isinstance(needs_pubkey, bool):
            bad("`contributes.submitPubkey` 必须是 true / false")

    # ── 可执行文件 ──────────────────────────────────────────────────────────
    bin_env = bin_name = bin_fallback = None
    bin_discovery = "convention"
    b = site.get("bin")
    if b is not None:
        if not isinstance(b, dict):
            bad("`site.bin` 必须是一个对象")
        else:
            bin_env = b.get("env")
            if not isinstance(bin_env, str) or not bin_env.strip():
                bad("`site.bin.env` 必须是一个非空的环境变量名")
                bin_env = None
            elif not bin_env.startswith("SLURMATE_"):
                # 这个名字会被塞进作业的环境变量表，前缀是本系统的领地 ——
                # 不限制的话一个插件能覆盖掉宿主自己读的变量。
                bad("`site.bin.env` 必须以 SLURMATE_ 开头，得到 %r" % bin_env)
                bin_env = None
            else:
                bin_env = bin_env.strip()
            bin_discovery = b.get("discovery", "convention")
            if bin_discovery not in ("which", "convention"):
                bad("`site.bin.discovery` 只能是 which 或 convention，得到 %r"
                    % bin_discovery)
                bin_discovery = "convention"
            bin_fallback = b.get("fallback")
            if not isinstance(bin_fallback, str) or not bin_fallback.strip():
                bad("`site.bin.fallback` 必须是一个非空路径")
                bin_fallback = None
            else:
                bin_fallback = bin_fallback.strip()
            if bin_discovery == "which":
                bin_name = b.get("name")
                if not isinstance(bin_name, str) or not bin_name.strip():
                    bad("`site.bin.discovery` 是 which 时必须给 `site.bin.name`"
                        "（去 PATH 里找的那个可执行文件名）")
                    bin_name = None
                else:
                    bin_name = bin_name.strip()

    # ── 取值受限的键 ────────────────────────────────────────────────────────
    enum_keys = []
    ek = site.get("enumKeys")
    if ek is not None:
        if not isinstance(ek, dict):
            bad("`site.enumKeys` 必须是一个对象（键 → {choices, default}）")
        else:
            for key in sorted(ek):
                if not PLUGIN_NAME_RE.match(str(key).replace("_", "-")):
                    bad("`site.enumKeys` 里的键名 %r 不像一个配置键" % key)
                    continue
                spec = ek[key]
                if not isinstance(spec, dict):
                    bad("`site.enumKeys.%s` 必须是 {choices, default} 形式的对象" % key)
                    continue
                choices = spec.get("choices")
                if (not isinstance(choices, list) or not choices
                        or not all(isinstance(c, str) and c.strip() for c in choices)):
                    bad("`site.enumKeys.%s.choices` 必须是一个非空的字符串数组" % key)
                    continue
                choices = [c.strip().lower() for c in choices]
                dflt = spec.get("default", choices[0])
                if not isinstance(dflt, str) or dflt.strip().lower() not in choices:
                    bad("`site.enumKeys.%s.default`（%r）不在 choices 里"
                        % (key, dflt))
                    continue
                enum_keys.append((key, tuple(choices), dflt.strip().lower()))

    if problems:
        return None, problems

    jobsh = os.path.join(os.path.dirname(where), PLUGIN_JOB_ENTRY)
    spec = PluginSpec(
        plugin_id=pid, name=name, version=version, title=title,
        default_cpus=default_cpus, default_mem=default_mem,
        default_enabled=default_enabled, needs_pubkey=needs_pubkey,
        bin_env=bin_env, bin_discovery=bin_discovery, bin_name=bin_name,
        bin_fallback=bin_fallback, enum_keys=tuple(enum_keys),
        source_dir=os.path.dirname(where), needs_job=os.path.isfile(jobsh))
    return spec, []


def scan_plugins(plugins_dir):
    """扫插件目录，返回 `(specs, problems)`。

        <plugins_dir>/<任意目录名>/plugin.json

    ★ **目录名不参与任何判定**（身份来自清单里的 `id`），所以这里只扫**一层**：
      这个目录是 deploy.sh 建的、布局由它定。
      客户端那边扫两层，因为用户会自己 `cp -r` 一个目录进去 —— 两处不同不是
      疏忽，是"谁往这里写"不同。

    ★ 坏掉的目录**跳过并报出来**，绝不让守护进程起不来：一个插件坏了不该带走整个
      站点。但它若在配置里有 `[plugin:<名字>]` 块，那条仍然是硬错误（那个块现在
      指向一个不存在的插件）—— 装了但坏掉、与配置指向一个不存在的东西，症状相同，
      报错也该相同。

    目录不存在时返回**空的**、且**不是错误** —— 一个插件都没装是合法状态。
    """
    specs, problems = [], []
    if not os.path.isdir(plugins_dir):
        return (), ()
    for entry in sorted(os.listdir(plugins_dir)):
        if entry.startswith("."):
            continue
        d = os.path.join(plugins_dir, entry)
        if not os.path.isdir(d):
            continue
        mf = os.path.join(d, MANIFEST_NAME)
        if not os.path.isfile(mf):
            problems.append("%s：这是一个插件目录，但里面没有 %s"
                            % (d, MANIFEST_NAME))
            continue
        try:
            with open(mf, encoding="utf-8") as f:
                raw = json.load(f)
        except (OSError, ValueError) as e:
            problems.append("%s：读不出来或不是合法 JSON（%s）" % (mf, e))
            continue
        spec, probs = parse_plugin_manifest(mf, raw)
        if spec is None:
            problems.extend(probs)
            continue
        dup = next((s for s in specs if s.name == spec.name), None)
        if dup is not None:
            # 短名必须站点内唯一：它是配置块名，也是作业侧函数名的后缀。
            # 两个目录抢一个短名时**两个都不收** —— 挑一个的后果是"哪个生效"取决于
            # 目录名的字典序，而那是没人会想到去查的地方。
            problems.append("%s：短名 %r 与 %s 里的那个重复了，两个都不加载"
                            % (mf, spec.name, dup.source_dir))
            specs = [s for s in specs if s.name != spec.name]
            continue
        specs.append(spec)
    return tuple(sorted(specs, key=lambda s: s.name)), tuple(problems)

JOB_LOG_SUBDIR = ".slurmate/logs"

# Slurm 命令的候选目录。配置里留空时按这个顺序找。
#
# 为什么不能只靠 PATH：守护进程在 systemd 下运行，而 systemd 的 PATH 是固定的
# （通常是 /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin），
# 与登录 shell 的 PATH 无关。/opt/slurm/bin 这类源码安装的位置不在其中，
# 于是"留空则自动查找"会失败，而失败信息看起来像"Slurm 没装"。
SLURM_BIN_DIRS = ("/usr/bin", "/usr/local/bin", "/opt/slurm/bin", "/usr/sbin",
                  "/bin", "/sbin")

# 配置里允许出现的**站点通用**键。表外的键一律报错 —— 拼错的键被静默忽略，
# 正是这个项目一路在清的那类问题：文件里写着，而实际什么也没发生。
#
# ★ 插件自己的键**不在这里**，见 PluginSpec.block_keys()。`auth_mode`、`bin`
#   这些东西是**插件的**策略（code-server 的认证方式、sshd 的可执行文件路径），
#   不是站点的事实 —— 所以它们各自住在 [plugin:<名字>] 块里，而不是在顶层排成一排。
GLOBAL_KEYS = frozenset([
    "cluster_cidr", "readonly_paths",
    "range_start", "range_end", "reserved_ranges", "candidates_per_session",
    "sbatch", "scancel", "squeue", "scontrol", "sacctmgr",
    # 提交时不带 service_kind 时用哪个插件。**没有内建缺省值** —— 见 Config 里
    # 那段说明：隐式缺省会让"装/卸一个插件"这种配置之外的动作悄悄改变行为。
    "default_plugin",
])

SECTION_PREFIX = "plugin:"


def parse_config(path):
    """读配置，返回 `({站点通用键: 值}, {插件名: {块内键: 值}})`。

    两种行形态：

        键 = 值            ← 站点通用。**必须写在所有块之前**
        [plugin:名字]      ← 其后直到下一个块头的键，都属于这个插件

    行尾的 `# …` 也算注释（所以值里不能出现 `#`）。空行忽略。
    重复的键、重复的块都报错 —— 写两遍说明作者对哪个生效有不同看法，而任何
    「取最后一个」的选择都会让其中一处永远不被执行。

    ★ 块一旦开始就没有回头路：块之后写的通用键会落进那个块，然后在块内键白名单
      那一步被拒。那一步的错误消息会点明「这是站点通用键，要写在块之前」——
      因为「把 cluster_cidr 追加到文件末尾」是个很容易犯、而症状完全指错方向的错。
    """
    global_out = {}
    sections = {}
    section_line = {}
    cur = None                          # None = 全局段，否则是插件名
    with open(path, "r", encoding="utf-8") as f:
        for lineno, raw in enumerate(f, 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("["):
                if not line.endswith("]"):
                    raise ValueError("第 %d 行：块头缺少闭合的 `]`: %r"
                                     % (lineno, raw.strip()))
                head = line[1:-1].strip()
                if not head.startswith(SECTION_PREFIX):
                    raise ValueError(
                        "第 %d 行：认不出的块头 %r。本版只有 [plugin:名字] 一种块。"
                        % (lineno, line))
                name = head[len(SECTION_PREFIX):].strip()
                if not name:
                    raise ValueError("第 %d 行：块头里没有插件名: %r" % (lineno, line))
                if name in sections:
                    raise ValueError("第 %d 行：[plugin:%s] 出现了两次（第 %d 行"
                                     "已经出现过）" % (lineno, name, section_line[name]))
                sections[name] = {}
                section_line[name] = lineno
                cur = name
                continue
            if "=" not in line:
                raise ValueError("第 %d 行不是 `键 = 值` 形式: %r" % (lineno, raw.strip()))
            key, _, val = line.partition("=")
            key = key.strip()
            if not key:
                raise ValueError("第 %d 行缺少键名: %r" % (lineno, raw.strip()))
            target = global_out if cur is None else sections[cur]
            where = "全局段" if cur is None else "[plugin:%s] 块" % cur
            if key in target:
                raise ValueError("第 %d 行：%s 里键 %r 重复出现" % (lineno, where, key))
            target[key] = val.strip()
    return global_out, sections


def parse_yes_no(raw, default, what):
    """解析 yes/no 形式的开关。**认不出的值报错，不退回默认。**

    静默退回默认的后果是「文件里写着 no，而它实际是开的」—— 对一个控制
    「要不要在计算节点上开一条 ssh」的开关来说，这是最不能接受的一种失败。
    """
    if raw is None or not str(raw).strip():
        return default
    v = str(raw).strip().lower()
    if v in ("yes", "true", "on", "1"):
        return True
    if v in ("no", "false", "off", "0"):
        return False
    raise ValueError("%s 只能是 yes 或 no，得到: %r" % (what, raw))


def resolve_bin(name, explicit):
    """把一个外部命令解析成【确实存在】的绝对路径，找不到返回 None。

    explicit 非空 → 原样用它。管理员点名了就必须是它，不做任何猜测 ——
    猜的后果是"我明明配了另一套 Slurm，跑起来的却是这一套"。

    explicit 为空 → 先查 PATH，再依次查 SLURM_BIN_DIRS。
    """
    if explicit:
        return explicit
    found = shutil.which(name)
    if found:
        return found
    for d in SLURM_BIN_DIRS:
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def default_jobs_dir():
    """作业脚本目录，从【守护进程自身的安装位置】推导。

    安装布局由 deploy.sh 定下：守护进程在 <prefix>/sbin，作业脚本在
    <prefix>/share/slurmate/jobs。两边由同一个前缀推导，就不存在
    「配置指向 A、实际装在 B」这种只在提交时才炸的不一致。

    ★ **一个插件一份**，文件名是这个插件清单里的 ULID（`<ULID>.sbatch`）。
      ULID 是插件的**身份**（全球唯一、铸造出来就不变），短名只是本站的标签。
      文档与排查里要认哪一份，看 `<jobs_dir>/<ULID>.sbatch` 与
      `<plugins_dir>/*/plugin.json` 里的 `id` 对不对得上。

    ★ 为什么是一插件一份、不是所有插件织进同一份：见 plugins/README.md。
      一句话 —— 同处一个文件时，插件里任何一行**不在函数里**的代码都会待在
      主流程中间，在**每一个**作业里执行，不管用的是哪个插件。
    """
    here = os.path.dirname(os.path.realpath(__file__))
    return os.path.normpath(
        os.path.join(here, os.pardir, "share", "slurmate", "jobs"))


def default_plugins_dir():
    """插件安装目录，同样从守护进程自身的安装位置推导。

    ★ **它是唯一的真相来源** —— 两个读者：
        deploy.sh  读它 + 各插件的 job/start.sh，编织成 run.sbatch
        本守护进程 启动时扫它，建出 PluginSpec 表

      加一个插件于是是「放一个目录 + 跑一次 deploy.sh」，不是「改守护进程的源码」。
      这正是「插件是独立项目」在集群侧的落点：守护进程仍然要 root 重部署一次，
      但那是**安装动作**，不是**改代码**。

    ★ 它**不是**配置项：一个能配的路径与"实际装在哪"可以不一致，而症状是守护进程
      报的插件表与作业模板里编织的插件是两套 —— 用户看得见按钮、点了却起不来。
    """
    here = os.path.dirname(os.path.realpath(__file__))
    return os.path.normpath(
        os.path.join(here, os.pardir, "share", "slurmate", "plugins"))


class PluginConfig(object):
    """一个插件的**生效配置**：元数据（PluginSpec）+ 站点在它的块里写的东西。

    ★ 行为只看 `enabled`，**不看块在不在**：
        写一个 `[plugin:sshd]` 块**不会**顺手把别的插件关掉（管理员只想开一个
        中转站、结果所有人的 IDE 没了，是最危险的那类静默改变），也不会因为
        "块在那儿"就自动把它打开（一句 `default_cpus = 1` 在没有任何显式同意的
        情况下开出一条交互式 ssh 进计算节点的路）。
      `present` 只用于自检输出，让运维分得清「没写这个块」与「写了但关着」——
      这两种状态的**行为**可能相同，但**该做什么**完全不同。
    """

    def __init__(self, spec, raw, present):
        self.spec = spec
        self.name = spec.name
        self.title = spec.title
        self.present = present
        self.raw = dict(raw)

        # 缺省开关状态由**插件自己**声明（`site.defaultEnabled`）。为 true 的只有
        # 一种：它就是升级前那个唯一可用的服务 —— 那条标记的全部理由是「升级不改变
        # 现有站点的行为」，不是「这个插件比较重要」。见 PluginSpec.default_enabled。
        self.enabled = parse_yes_no(
            raw.get("enabled"), spec.default_enabled,
            "[plugin:%s] 的 enabled" % spec.name)

        # ── 默认资源（缺省 = 该插件代码里的内建值）──
        v = (raw.get("default_cpus") or "").strip()
        if v:
            try:
                self.default_cpus = int(v)
            except ValueError:
                raise ValueError("[plugin:%s] 的 default_cpus 必须是整数，得到: %r"
                                 % (spec.name, v))
        else:
            self.default_cpus = spec.default_cpus
        if not (1 <= self.default_cpus <= MAX_CPUS_REQUEST):
            raise ValueError("[plugin:%s] 的 default_cpus 应在 1-%d 之间，当前为 %d"
                             % (spec.name, MAX_CPUS_REQUEST, self.default_cpus))

        v = (raw.get("default_mem") or "").strip()
        if v:
            self.default_mem, bad = sanitize_mem(v, None)
            if bad:
                # ★ 这里**不**回退默认值，直接报错。请求里的 mem 写错可以回退
                #   （用户会拿到 warning），而配置里写错必须当场拒绝 —— 否则
                #   「文件里写着 0，而所有人实际拿到 8G」会一直没人发现。
                raise ValueError(
                    "[plugin:%s] 的 default_mem 无法识别: %r（形如 8G / 512M。"
                    "注意 0 在 Slurm 里表示整台节点的内存，不是「零内存」）"
                    % (spec.name, v))
        else:
            self.default_mem = spec.default_mem

        # ── 可执行文件 ──
        explicit = (raw.get("bin") or "").strip()
        if explicit:
            self.bin, self.bin_src = explicit, "配置指定"
        elif spec.bin_discovery == "which":
            found = shutil.which(spec.bin_name) if spec.bin_name else None
            if found:
                self.bin, self.bin_src = found, ("本机 PATH 中找到（节点布局通常"
                                                 "一致，但未在计算节点上确认）")
            else:
                self.bin, self.bin_src = spec.bin_fallback, ("惯例路径（本机没有，"
                                                             "未在计算节点上确认）")
        else:
            # ★ 不做 PATH 查找。这一项在**登录节点**上求值，而真正的执行发生在
            #   **计算节点**上 —— 登录节点上恰好有这个文件，对计算节点不是证据。
            #   写错了由作业侧明确失败（run.sbatch 会 log 出"不存在或不可执行"），
            #   而不是在这里猜一个看起来合理的路径。
            self.bin, self.bin_src = (spec.bin_fallback, "惯例路径（本机不做查找："
                                                         "登录节点上的结果对计算节点不是证据）")

        # ── 取值受限的键（如 code-server 的 auth_mode）──
        self.enum = {}
        for key, choices, default in spec.enum_keys:
            val = (raw.get(key) or "").strip().lower() or default
            if val not in choices:
                raise ValueError("[plugin:%s] 的 %s 只能是 %s 之一，当前为 %r"
                                 % (spec.name, key, " 或 ".join(choices), val))
            self.enum[key] = val

    def get(self, key):
        """取一个 enums 键的生效值。"""
        return self.enum[key]

    @property
    def session_auth_mode(self):
        """这个插件的会话用什么认证方式 —— 会写进会话文件、交给客户端。

        需要公钥的插件：`publickey`。作业内的 sshd 用客户端带上来的那把公钥认证，
        会话文件里**根本没有口令**（run.sbatch 那条分支不生成口令）。

        其余插件：用块里那个 enum 键（code-server 的 `auth_mode`）。插件一个
        enum 键都没有时是 `none` —— 那表示「框架不知道有什么客户端侧的认证步骤」，
        而不是「不需要认证」；具体怎么接由插件自己在客户端侧声明。
        """
        if self.spec.needs_pubkey:
            return "publickey"
        return self.enum.get("auth_mode") or "none"


def build_plugin_configs(specs, sections):
    """把配置里的块摊成 {插件名: PluginConfig}。**每个装了的插件都有一项**，
    哪怕站点没写它的块 —— 因为「没写」和「写着但关掉了」在行为上等价，
    但在自检输出里必须分得开。
    """
    out = {}
    for spec in specs:
        raw = sections.get(spec.name)
        out[spec.name] = PluginConfig(spec, raw or {}, raw is not None)
    return out


def section_names_problem(sections, by_name):
    """块名有没有认不出的。返回错误串列表（空 = 没问题）。

    ★ 报错而不是忽略：写成 `[plugin:ssh]`（少个 d）被静默忽略，症状是
      「配了但它就是不生效」—— 与未知键那条要防的是同一类问题。

    ★ 一个插件都没装时这句话要说**安装**，不是"名字写错了"：那是两种完全不同的
      行动（去装一个 vs 去改一个字），而它们在配置里长得一模一样。
    """
    errors = []
    for name in sorted(sections):
        if name in by_name:
            continue
        if by_name:
            errors.append(
                "[plugin:%s] 是个未知的插件。本站**装了**的是：%s。"
                "（装了的才认得 —— 装插件是放一个目录到插件安装目录再跑一次 "
                "deploy.sh，见 plugins/README.md。）"
                % (name, "、".join(sorted(by_name))))
        else:
            errors.append(
                "[plugin:%s] 指向一个插件，而本站**一个插件都没装**。"
                "插件安装目录是空的，所以任何 [plugin:*] 块都不可能生效。"
                "把插件目录放进去再跑一次 deploy.sh 即可（见 plugins/README.md）。"
                % name)
    return errors


def block_keys_problem(sections, by_name):
    """块内的键有没有认不出的。返回错误串列表（空 = 没问题）。"""
    errors = []
    for name in sorted(sections):
        spec = by_name.get(name)
        if spec is None:
            continue                    # 块名本身就不认识，那条错误已经报过了
        allowed = spec.block_keys()
        for key in sorted(sections[name]):
            if key in allowed:
                continue
            if key in GLOBAL_KEYS:
                errors.append(
                    "[plugin:%s] 块里有 %r，它是**站点通用键** —— 通用键必须写在"
                    "所有 [plugin:*] 块之前。块一旦开始就没有回头路，"
                    "把它挪到文件顶部即可。" % (name, key))
            else:
                errors.append(
                    "[plugin:%s] 块里有无法识别的键 %r（本版这个块只认：%s）"
                    % (name, key, ", ".join(allowed)))
    return errors


def parse_reserved_ranges(spec):
    """`"起-止,起-止"` → [(起, 止), …]。格式错误抛 ValueError。"""
    out = []
    for item in (spec or "").split(","):
        item = item.strip()
        if not item:
            continue
        if "-" not in item:
            raise ValueError("reserved_ranges 的每一项应为 起-止 形式，得到: %r" % item)
        a, b = item.split("-", 1)
        try:
            out.append((int(a), int(b)))
        except ValueError:
            raise ValueError("reserved_ranges 的起止必须是数字，得到: %r" % item)
    return out


class Config(object):
    def __init__(self, path):
        self.path = path
        raw, sections = parse_config(path)

        # ── 插件：表是**扫出来的**，不是代码里写死的 ────────────────────────
        # 先扫盘 —— 配置里的 [plugin:*] 块要对照它才知道认不认识。顺序不能反。
        self.plugins_dir = default_plugins_dir()
        self.plugin_specs, self.plugin_problems = scan_plugins(self.plugins_dir)
        self.plugin_by_name = {s.name: s for s in self.plugin_specs}

        # 认不出来的键/块/块内键不在构造时报错，攒着交给 validate() —— --check
        # 要能一次把问题列全，而不是让人改一个跑一次。
        self.unknown_keys = sorted(set(raw) - GLOBAL_KEYS)
        self.bad_sections = section_names_problem(sections, self.plugin_by_name)
        self.bad_block_keys = block_keys_problem(sections, self.plugin_by_name)

        def get(key, default=""):
            return raw.get(key, default)

        def getint(key, default):
            v = raw.get(key, "")
            if v == "":
                return default
            try:
                return int(v)
            except ValueError:
                raise ValueError("%s 必须是整数，得到: %r" % (key, v))

        # ── 网络 ──
        self.cluster_cidr = get("cluster_cidr").strip()
        self.readonly_paths = get("readonly_paths").strip()

        # ── 端口池 ──
        self.port_start = getint("range_start", 55001)
        self.port_end = getint("range_end", 55999)
        self.candidates_per_session = getint("candidates_per_session", 6)
        # 需要避让的其他端口区间。若集群上还有别的端口管理系统（某些 guard /
        # DNAT 守护进程之类），把它们的区间写进配置 —— 启动时会断言不交。
        # nftables 对同 hook 同 priority 的【跨表顺序不给保证】，只有"集合不交"
        # 才能让行为确定。开源前的旧实现把"必须 > 55000"写死在代码里，那是本
        # 集群的约定，别人的集群用 55000 以下端口时会直接起不来。
        self.reserved_ranges = parse_reserved_ranges(get("reserved_ranges"))

        # ── 插件 ──
        # 每个【装了的】插件都有一项，哪怕站点没写它的块（见 build_plugin_configs）。
        # 默认资源、可执行文件路径、auth_mode 这些**插件的策略**住在这里的块里，
        # 而它们的缺省值来自插件自己的清单（plugin.json 的 site 段）。
        self.plugins = build_plugin_configs(self.plugin_specs, sections)
        # 已启用的插件名，按名字排序 —— 稳定顺序，界面与日志才不会每次都不一样。
        # ★ enabled_kinds 才是"本站开了哪些"，**不是**"配置里有哪些块"。
        self.enabled_kinds = tuple(sorted(
            n for n, p in self.plugins.items() if p.enabled))

        # ── 提交时的缺省服务种类 ────────────────────────────────────────────
        # ★ 刻意**没有**硬编码的缺省，也刻意**不**用"表里唯一的那个"当缺省：
        #   隐式缺省会让"改配置之外的动作"（装一个插件、卸一个插件）悄悄改变行为，
        #   而这一层要的恰恰是可预测。没配就要求调用方显式给，报错里说清为什么。
        self.default_plugin = get("default_plugin").strip()

        # ── 从代码常量来的（见文件上方的理由）──
        self.socket_path = SOCKET_PATH
        self.state_dir = STATE_DIR
        self.db_path = os.path.join(STATE_DIR, "claims.db")
        self.rejected_dir = os.path.join(STATE_DIR, "rejected")
        self.log_dir = LOG_DIR
        self.audit_log = os.path.join(LOG_DIR, "audit.log")
        self.tick_seconds = TICK_SECONDS
        self.startup_grace_seconds = STARTUP_GRACE_SECONDS
        self.default_time = DEFAULT_TIME
        self.max_time = MAX_TIME
        self.suspect_after = SUSPECT_AFTER
        self.orphan_after = ORPHAN_AFTER
        self.reserved_ttl = RESERVED_TTL
        self.submitted_ttl = SUBMITTED_TTL
        self.released_keep = RELEASED_KEEP
        self.job_missing_confirm_ticks = JOB_MISSING_CONFIRM_TICKS
        self.renew_enabled = True
        self.renew_threshold = RENEW_THRESHOLD
        self.renew_increment = RENEW_INCREMENT
        self.renew_max_total = RENEW_MAX_TOTAL
        self.password_bytes = PASSWORD_BYTES
        self.max_active_per_user = MAX_ACTIVE_PER_USER
        self.max_pending_per_user = MAX_PENDING_PER_USER
        self.max_rpc_per_second = MAX_RPC_PER_SECOND
        self.reject_threshold = REJECT_THRESHOLD
        self.reject_window = REJECT_WINDOW
        self.throttle_seconds = THROTTLE_SECONDS
        self.jobs_dir = default_jobs_dir()
        self.job_log_subdir = JOB_LOG_SUBDIR

        # ── 「有作业侧、却找不到那份脚本」的插件 ──────────────────────────
        # 它**不是**启动错误，**也不进 validate()** —— 理由有两条，都写在这里
        # 免得下一个人"顺手"把它挪进去：
        #
        #   ① `validate()` 只有 errors 一条通道（任何一条都让守护进程拒绝启动），
        #      所以往里加任何东西都等于「让整个站点起不来」。而这条描述的是一个
        #      **部署不完整**，不是「这份配置错了」—— 一个站点不该因为少了一份
        #      作业脚本就拒绝为所有人服务，那会连"停掉正在跑的会话"都做不到。
        #   ② 与它同族的 `plugin_problems`（清单坏掉的插件目录）走的就是这条路：
        #      `--check` 里打 ⚠、`start()` 里 log.error，其余一切照常。
        #
        # 判据用 `needs_job`（插件目录里有没有 job/start.sh），所以**没有作业侧
        # 的插件不在这个列表里** —— 那种插件是合法的，它只是不能提交，
        # 由 op_submit 的 service_kind_no_job 说清楚。
        self.plugin_job_missing = [
            s for s in self.plugin_specs
            if s.needs_job
            and not os.path.isfile(os.path.join(self.jobs_dir, s.id + ".sbatch"))]

        # ── 外部命令（留空则查找）──
        self.sbatch = resolve_bin("sbatch", get("sbatch"))
        self.scancel = resolve_bin("scancel", get("scancel"))
        self.squeue = resolve_bin("squeue", get("squeue"))
        self.scontrol = resolve_bin("scontrol", get("scontrol"))
        self.sacctmgr = resolve_bin("sacctmgr", get("sacctmgr"))
    def plugin(self, name):
        """取一个插件的生效配置。名字不认识返回 None（调用方负责报错）。"""
        return self.plugins.get(name)

    def cluster_cidr_problem(self):
        """cluster_cidr 的**形式**问题描述；没问题返回 None。

        这一项此前只校验了「地址部分是合法 IPv4」，另外两件事一件没做，而它们的
        失效方向**都是 fail-open**（不报错，只是 ACL 不再生效）：
          ① 前缀长度不校验 —— `192.0.2.0/99` 能通过自检，在 nft 里却是语法错误；
          ② 主机位不为 0 的写法（`192.0.2.5/24`）在 nft 里语义含糊。

        至于「这个网段是不是真的覆盖了全部计算节点」—— 那是**内容**问题，不是形式
        问题，只有问 Slurm 才知道，见 crosscheck_cidr()。

        ★ 这里刻意【没有】「拒绝 RFC 5737 文档网段」那一条，虽然它看起来能一眼抓住
          「照抄示例忘了改」。理由：那会**拒绝一个完全合法的配置** —— 用 192.0.2.0/24
          的测试集群是存在的，而软件没有任何依据判定它不是真的。一个不许人填真实值的
          校验，是软件的错，不是配置的错。而它想防的那件事由 crosscheck_cidr() 覆盖，
          且报错更精确（它会点名到底是哪几个节点落在外面）。
        """
        s = self.cluster_cidr
        if not s:
            return ("未配置 cluster_cidr。它是 nft 基础规则 `ip daddr != <CIDR> accept` "
                    "的几何约束，而它没有安全的默认值 —— 填错的后果不是报错，而是"
                    "全部 ACL 静默失效。写法：cluster_cidr = <网络地址>/<前缀长度>"
                    "（例如 192.0.2.0/24 —— 把地址换成你的集群网段）")
        if "/" not in s:
            return ("cluster_cidr 必须是 CIDR（<网络地址>/<前缀长度>），当前为 %r" % s)
        addr, _, plen = s.partition("/")
        if not is_ipv4(addr):
            return "cluster_cidr 的地址部分不是合法 IPv4: %r" % s
        if not plen.isdigit():
            return "cluster_cidr 的前缀长度不是数字: %r" % s
        n = int(plen)
        if not (0 <= n <= 32):
            return "cluster_cidr 的前缀长度越界: %r（应为 0-32）" % s
        if n == 0:
            return ("cluster_cidr 的前缀长度是 0：`ip daddr != 0.0.0.0/0` 恒为假，"
                    "基础规则等于不存在，实际保护范围远超预期")
        net = ipaddress.IPv4Network(s, strict=False)
        if str(net) != s:
            return ("cluster_cidr 的主机位不为 0（%s）。在 nft 里语义含糊，"
                    "请改写成网络地址：%s" % (s, net))
        return None

    def _db_schema_errors(self):
        """数据库表结构是否还是本版认得的样子。

        只在库文件已存在且读得到时检查：非 root 跑 `--check` 读不到
        /var/lib/slurmate-session 是正常的，不该因此报错。

        ★ v0.2 删掉了 sessions.purpose 这一列（「用途」这一层没有了）。
          SQLite 的 `CREATE TABLE IF NOT EXISTS` **不会**改已存在的表，而那一列
          是 NOT NULL —— 于是旧库上的每一次提交都会以 IntegrityError 失败，被
          dispatch 兜成 code 9「内部错误」，信息里没有一个字与数据库有关。
          这里把它变成一条能照着做的启动错误。claims.db 可以放心删：它记的是
          "这个 job_id 是我代表哪个 uid 提交的"，丢了之后
          recover_from_rules() 会从 nft 规则重建。
        """
        if not os.path.exists(self.db_path):
            return []
        try:
            conn = sqlite3.connect("file:%s?mode=ro" % self.db_path, uri=True,
                                   timeout=5)
        except sqlite3.Error:
            return []                       # 读不到（多半是权限）—— 不当作错误
        try:
            cols = {r[1] for r in conn.execute("PRAGMA table_info(sessions)")}
        except sqlite3.Error:
            return []
        finally:
            conn.close()
        if not cols:
            return []                       # 表还不存在，Store 会建
        if "purpose" in cols:
            return ["数据库 %s 是 v0.1 的（sessions 表还有 purpose 列，而 v0.2 起"
                    "不再有「用途」这一层）。它不会被自动改表，旧列是 NOT NULL，"
                    "留着会让每一次提交都以内部错误失败。删掉它再启动即可 —— "
                    "会话归属能从 nft 规则重建：rm -f %s" % (self.db_path, self.db_path)]
        return []

    def validate(self):
        """启动时自检。任何一条不满足都拒绝启动 —— 宁可不起，也不要带病运行。"""
        errors = []
        for k in self.unknown_keys:
            errors.append("配置里有无法识别的键 %r（拼错了？本版只认：%s）"
                          % (k, ", ".join(sorted(GLOBAL_KEYS))))
        errors.extend(self.bad_sections)
        errors.extend(self.bad_block_keys)
        # ★ **一个插件都没装、或一个都没开，都是合法的** —— 那正是"外壳"的定义：
        #   基座的功能不因为插件的有无而缺一块。以前这里把零插件判成错误、让守护
        #   进程 100% 起不来，那是把"框架"和"插件"绑死了。
        #   但它必须**说得出来**：否则表现是"客户端上一个按钮都没有"，而配置里
        #   一个字都不像有问题。所以它进的是 --check 的提示，不是错误。
        #
        # 插件目录坏了**同样不是**启动错误：一个插件坏了不该带走整个站点。它由
        # --check 逐条打印，也在 start() 里进日志。
        if self.default_plugin and self.default_plugin not in self.plugin_by_name:
            errors.append(
                "配置里的 default_plugin = %r 在本站**没有装**。装了的插件是：%s。"
                "（装插件是放一个目录到插件安装目录 %s 再跑一次 deploy.sh。）"
                % (self.default_plugin,
                   "、".join(sorted(self.plugin_by_name)) or "（一个都没有）",
                   self.plugins_dir))
        # 端口区间必须与集群上其他端口管理系统完全不交（nftables 对同 hook 同
        # priority 的跨表顺序没有保证，只有"集合不交"才能保证判决确定）。
        # 要与哪些区间避让由配置的 reserved_ranges 决定，不写死在代码里。
        if self.port_start < 1 or self.port_start > self.port_end:
            errors.append("端口区间起止非法: %d-%d" % (self.port_start, self.port_end))
        for _a, _b in self.reserved_ranges:
            if self.port_start <= _b and _a <= self.port_end:
                errors.append("端口区间 %d-%d 与 reserved_ranges 里的 %d-%d 重叠"
                              % (self.port_start, self.port_end, _a, _b))
        if self.port_end > 65535:
            errors.append("端口区间上界 %d 越界" % self.port_end)
        # 阈值关系。这几个现在是代码常量，正常情况下恒成立 —— 留着是因为
        # "恒成立"这句话本身该由机器来断言，而不是由读代码的人来相信。
        if self.job_missing_confirm_ticks < 1:
            errors.append("job_missing_confirm_ticks 必须 >= 1")
        if self.suspect_after >= self.orphan_after:
            errors.append("suspect_after(%d) 必须小于 orphan_after(%d)"
                          % (self.suspect_after, self.orphan_after))
        # ★ 这里此前有一条 `if not os.path.exists(self.job_script)` —— 那时作业
        #   脚本是**一份**编织成品，不在就等于整个系统不能提交，判成启动错误是
        #   合理的。现在一个插件一份，缺失的语义变成了「这个插件的部署不完整」：
        #   **一个插件的问题不该让整个站点起不来**（起不来连"停掉正在跑的会话"
        #   都做不到）。所以它改走 `plugin_job_missing` + `--check` 的 ⚠ 与
        #   `start()` 的 log.error，与 `plugin_problems` 同一条路。
        #   **不要再把它加回这里** —— `validate()` 没有 warnings 通道。
        cidr_err = self.cluster_cidr_problem()
        if cidr_err:
            errors.append(cidr_err)
        # ★ 五个命令全查。此前只查 sbatch/scancel/scontrol，而 squeue（job_state
        #   的兜底查询）与 sacctmgr（账户与分区权限）可以是错路径而启动通过，
        #   运行时才失败 —— 那时报出来的是"查不到作业"或"没有账户"，与真正的
        #   原因（路径写错）隔了好几层。
        for name in ("sbatch", "scancel", "squeue", "scontrol", "sacctmgr"):
            path = getattr(self, name)
            if not path:
                errors.append("找不到 %s：配置里留空表示自动查找，已在 PATH 与 %s "
                              "里找过，都没有。请在配置里写明它的绝对路径。"
                              % (name, "、".join(SLURM_BIN_DIRS)))
            elif not os.path.exists(path):
                errors.append("Slurm 命令不存在: %s（配置里 %s 指定）" % (path, name))
        if not (4 <= self.password_bytes <= 64):
            errors.append("password_bytes 应在 4-64 之间，当前为 %d"
                          % self.password_bytes)
        errors.extend(self._db_schema_errors())
        return errors


