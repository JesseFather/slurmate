# ==============================================================================

def main():
    ap = argparse.ArgumentParser(description="Slurmate 会话守护进程")
    ap.add_argument("--config", default="/etc/slurmate/slurmate.conf")
    ap.add_argument("--foreground", action="store_true",
                    help="前台运行（systemd 下用，日志直接进 journal）")
    ap.add_argument("--check", action="store_true",
                    help="只做配置校验与连通性自检，不启动")
    ap.add_argument("--check-plugins", action="store_true",
                    help="只扫插件目录并校验每份 plugin.json，不读配置、不启动。"
                         "deploy.sh 在编织作业脚本之前用它 —— 校验规则只有这"
                         "一份，不在部署脚本里另写一套")
    ap.add_argument("--plugins-dir", default="",
                    help="配合 --check-plugins：改扫这个目录而不是安装目录。"
                         "部署前的体检用它校验**还没装进去**的源目录")
    ap.add_argument("--version", action="version", version=VERSION)
    args = ap.parse_args()

    log_setup()

    # ── 只扫插件（deploy.sh 用）────────────────────────────────────────────
    # ★ 它跑的是**守护进程自己的**扫描器，不是在部署脚本里另写一份规则。
    #   两套解释器的后果是"预检放行了、守护进程起不来"（或者反过来），而这个
    #   仓库已经因为同一类分叉吃过一次亏（reserved_ranges 的解析）。
    if args.check_plugins:
        where = args.plugins_dir or default_plugins_dir()
        specs, problems = scan_plugins(where)
        for p in problems:
            print("插件错误: %s" % p)
        if problems:
            return 1
        if not specs:
            print("插件目录 %s 是空的 —— 本站没有安装任何插件。" % where)
            print("  这是合法状态：守护进程照常启动、会话照常能停，只是没有可提交的服务。")
            return 0
        print("插件目录 %s 里有 %d 个插件：" % (where, len(specs)))
        for s in specs:
            if s.needs_job:
                note = "  作业侧入口 %s" % s.job_entry
            else:
                # ★ 这**不是**故障，是一种合法状态：插件可以只有客户端那一半。
                #   所以措辞是"不能提交"，不是"会失败" —— 它连提交都到不了。
                #   要给它加作业侧，就补一份 job/start.sh 再跑一次 deploy.sh。
                note = "  ⚠ 没有 job/start.sh —— 本插件不能提交（合法状态）"
            print("  %-16s %s@%s  %s%s"
                  % (s.name, s.id, s.version,
                     "启用" if s.default_enabled else "停用", note))
        # deploy.sh 要逐个处理这些目录，所以最后给一行**机器可读**的。
        # 用制表符而不是空格：短名里不允许空格，也不允许制表符。
        #
        # ★ 三列，**第三列是 id（ULID）**：deploy.sh 用它给每个插件的作业脚本命名
        #   （`<ULID>.sbatch`）。少发这一列，部署脚本就只能拿短名当文件名 ——
        #   而短名是本站的标签、可以改，ULID 才是身份。两列都不够，所以是三列。
        print("plugin-dirs:")
        for s in specs:
            print("%s\t%s\t%s" % (s.name, s.source_dir, s.id))
        return 0

    # 先把配置与 --check 走完，这样非 root 也能拿它做诊断（nft 相关项会诚实报 false）
    try:
        cfg = Config(args.config)
    except Exception as e:                                   # noqa: BLE001
        log.error("读取配置失败 %s: %s", args.config, e)
        return 1

    errors = cfg.validate()
    if errors:
        for e in errors:
            log.error("配置错误: %s", e)
        return 1

    if args.check:
        is_root = os.geteuid() == 0
        print("配置 OK: %s" % args.config)
        print("  端口池        : %d-%d" % (cfg.port_start, cfg.port_end))
        print("  socket        : %s" % cfg.socket_path)
        print("  数据库        : %s" % cfg.db_path)
        print("  作业脚本目录  : %s" % cfg.jobs_dir)
        print("  插件目录      : %s" % cfg.plugins_dir)
        print("  缺省插件      : %s" % (cfg.default_plugin or
              "（未设置 —— 提交时必须显式给 service_kind）"))
        print("  集群网段      : %s" % cfg.cluster_cidr)
        print("  闪断/孤儿阈值 : %ds / %ds" % (cfg.suspect_after, cfg.orphan_after))
        print("  续期          : %s  阈值 %ds 增量 %s"
              % ("开" if cfg.renew_enabled else "关", cfg.renew_threshold,
                 cfg.renew_increment))
        # 命令路径逐条打印【解析结果】而不是配置里写了什么：配置留空是推荐值，
        # 而留空之后究竟找没找到、找到的是哪一个，只有这里说得清。
        print("  外部命令      :")
        for _n in ("sbatch", "scancel", "squeue", "scontrol", "sacctmgr"):
            _p = getattr(cfg, _n)
            print("    %-9s %s" % (_n, _p or "【找不到】配置留空且 PATH 与候选目录里都没有"))
        # 插件逐个打印：开没开、默认资源、可执行文件解析到了哪里。
        # ★ 同样打印【解析结果】：`bin` 留空是推荐值，而留空之后落在了哪个路径上，
        #   以及那个路径是"配置指定的"还是"猜的"，只有这里说得清。
        # 坏掉的插件目录：**报告但不算错误**。一个插件坏了不该带走整个站点，
        # 但它必须被看见 —— 否则表现是"我明明装了啊"，而日志里一个字都没有。
        for _p in cfg.plugin_problems:
            print("  ⚠ 插件目录有问题（已跳过，其余插件照常工作）：%s" % _p)
        # 「有作业侧、却找不到那份作业脚本」—— 同样是**报告但不算错误**。
        # 它说明这个插件的部署不完整（deploy.sh 跑在插件装上之前？拷贝失败了？），
        # 而症状是提交时被拒。不说出来的话，运维只会看到"本站没有开启"之类
        # 与真正原因隔了一层的话。修法是重跑一次 deploy.sh。
        for _s in cfg.plugin_job_missing:
            print("  ⚠ 插件「%s」的作业脚本不在：%s（重跑一次 deploy.sh 会生成它）"
                  % (_s.name, os.path.join(cfg.jobs_dir, _s.id + ".sbatch")))

        print("  插件          :")
        if not cfg.plugins:
            # ★ 零插件是**合法状态**，不是"安装包坏了"。所以这里给的是出路，
            #   不是故障描述。
            print("    【本站没有安装任何插件】")
            print("      这是合法状态：守护进程照常启动，已有会话照常能查、能停，")
            print("      只是没有可提交的服务。装插件就是把插件目录放进")
            print("      %s 再跑一次 deploy.sh（见 plugins/README.md）。" % cfg.plugins_dir)
        for _n in sorted(cfg.plugins):
            _p = cfg.plugins[_n]
            print("    %-12s %s  默认 %s 核 / %s%s"
                  % (_p.name, "已启用" if _p.enabled else "已停用",
                     _p.default_cpus, _p.default_mem,
                     "" if _p.present else "（配置里没有这个块，这里是插件清单里的缺省值）"))
            print("      %-11s %s@%s" % ("id@版本", _p.spec.id, _p.spec.version))
            if not _p.spec.needs_job:
                print("      %-11s 【没有 job/start.sh —— 合法状态，但本插件提交不了】"
                      % "作业侧")
            print("      %-11s %s" % ("作业脚本",
                                      os.path.join(cfg.jobs_dir, _p.spec.id + ".sbatch")))
            if _p.spec.bin_env:
                print("      %-11s %s（%s）"
                      % (_p.spec.bin_env, _p.bin, _p.bin_src))
            for _k in sorted(_p.enum):
                print("      %-11s %s" % (_k, _p.enum[_k]))
        if cfg.plugins and not cfg.enabled_kinds:
            print("    【装了，但一个都没启用】客户端上将没有任何可用的服务")
        slurm = Slurm(cfg)
        print("  accounting 强制: %s（决定 sbatch 是否必须带 -A）"
              % slurm.is_accounting_enforced())
        table = slurm.partition_table()
        if table is None:
            print("  分区          : 【读不到】scontrol show partition 失败")
        elif not table:
            print("  分区          : 【一个都没有】")
        else:
            print("  分区          :")
            for _n in sorted(table, key=lambda n: (not table[n]["is_default"], n)):
                _i = table[_n]
                print("    %-12s %s%s" % (
                    _n, "默认  " if _i["is_default"] else "      ",
                    "无时间上限" if _i["max_time"] is None
                    else fmt_slurm_time(_i["max_time"])))
        # cluster_cidr 与 Slurm 的 NodeAddr 交叉核对 —— 这是唯一能发现
        # 「网段漏掉了某个节点」的地方，而漏掉的后果是静默失效。
        cidr_errors = crosscheck_cidr(cfg)
        for _e in cidr_errors:
            print("  ⚠ %s" % _e)
        nft = Nft(cfg)
        print("  nft 表存在    : %s" % nft.table_exists())
        rules = nft.session_rules()
        print("  nft 可读规则  : %s%s" % (rules is not None,
              "" if is_root else "  ← 非 root，无法读取属正常"))
        if not is_root:
            print("  [提示] 非 root 运行，nft 相关项仅供参考；完整自检请用 sudo")
        # 上面那些 ⚠ 不能只是一行字：systemd 的 ExecStartPre 就是跑这个命令，
        # 退出码非零才会真的拦住服务。交叉核对失败时拒绝启动，与
        # Sessiond.start() 里的判断是同一条 —— 两处都要有，因为 --check
        # 才是 systemd 看到的那一道。
        if cidr_errors:
            print("配置检查未通过：cluster_cidr 与 Slurm 的节点地址对不上（见上）")
            return 1
        return 0

    if os.geteuid() != 0:
        log.error("必须以 root 运行（需要 CAP_NET_ADMIN 维护 nftables，"
                  "以及 setuid 代表用户提交作业）。诊断用 --check 不需要 root。")
        return 1

    d = Sessiond(cfg)
    rc = 0
    try:
        if not d.start():
            rc = 1
        else:
            d.run()
    except KeyboardInterrupt:
        pass
    finally:
        d.shutdown()
    return rc


if __name__ == "__main__":
    sys.exit(main())
