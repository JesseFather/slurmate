# 客户端带上来的一行公钥。
#
# ★ 这条正则是**安全关键**，不是格式校验：authorized_keys 允许选项前缀
#   （command=、environment=、cert-authority…）与任意多行，而这一段文本会被写进
#   一份被 sshd 信任的文件里。这里只放行「算法名 + 空格 + 恰好 68 个 base64 字符
#   (+ 可选注释)」，一次性排除掉选项前缀与"追加第二条公钥"。
# ★ **允许带注释**（客户端生成的就是 `ssh-ed25519 <b64> slurmate-20260915-1145`），
#   但注释会被整个丢掉、不参与任何校验。不这么做的话整条路是堵死的 —— 客户端的
#   公钥行本来就带注释。而注释里可以有**逗号**，守护进程又是用
#   `--export=ALL,k=v,…` 传环境变量的，一个逗号就能把一个变量劈成两个 ——
#   所以正确做法是「收下、只校验 base64 那一段、把注释丢掉」，不是「拒绝带注释的」。
#   `[^\r\n]*` 让注释不能跨行，于是多行输入（追加第二条公钥）仍然被拒。
SSH_PUBKEY_RE = re.compile(
    r"^ssh-ed25519 ([A-Za-z0-9+/]{68})(?:[ \t]+[^\r\n]*)?$")

# 一把 ed25519 公钥解出来恒为 51 字节：4 + 11("ssh-ed25519") + 4 + 32。
SSH_ED25519_BLOB_LEN = 51


def parse_ssh_pubkey(raw):
    """把一行公钥收成规范形态 `ssh-ed25519 <base64>`；不合法返回 None。

    除了形状，还**真的解一次 base64** 确认它是一把 ed25519 公钥。形状对但内容
    不是密钥的输入（随便 68 个 base64 字符）会被这一步挡住，而不是等到认证失败
    才暴露 —— 那时用户看到的只有一句"认证失败"，根因在计算节点上。
    """
    m = SSH_PUBKEY_RE.match(str(raw or "").strip())
    if not m:
        return None
    b64 = m.group(1)
    try:
        blob = base64.b64decode(b64, validate=True)
    except (ValueError, TypeError):
        return None
    if len(blob) != SSH_ED25519_BLOB_LEN or blob[4:15] != b"ssh-ed25519":
        return None
    if struct.unpack(">I", blob[15:19])[0] != 32:
        return None
    return "ssh-ed25519 " + b64
