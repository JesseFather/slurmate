SCHEMA_SQL = """
CREATE TABLE IF NOT EXISTS sessions (
    session_id      TEXT PRIMARY KEY,
    uid             INTEGER NOT NULL,
    user            TEXT NOT NULL,
    -- v0.2 删掉了 purpose 列（「用途」这一层没有了）。已存在的旧库不会被
    -- `CREATE TABLE IF NOT EXISTS` 改动，而那一列是 NOT NULL —— 所以启动时会
    -- 明确拒绝（见 Config._db_schema_errors），而不是等第一次提交时炸成内部错误。
    --
    -- partition 允许为空串：分区权限查不到时（sacctmgr 失败），缺省提交会退化为
    -- 不带 -p，此时"落在哪个分区"在提交那一刻确实无人知晓，而空串是它诚实的
    -- 表示。作业跑起来之后 session_view 会改用它从 Slurm 查到的实际分区。
    partition       TEXT NOT NULL DEFAULT '',
    account         TEXT NOT NULL,
    cpus            INTEGER NOT NULL DEFAULT 1,
    mem             TEXT NOT NULL DEFAULT '2G',
    gres            TEXT,
    requested_time  TEXT NOT NULL,
    job_id          INTEGER,
    state           TEXT NOT NULL,
    node            TEXT,
    node_ip         TEXT,
    service_port    INTEGER,
    candidates      TEXT NOT NULL,
    auth_mode       TEXT NOT NULL DEFAULT 'password',
    -- 这个会话提供哪种服务（'code-server' / 'sshd'）。
    -- ★ **可空**，NULL = 未知 —— 从 nft 规则恢复出来的会话不知道自己是什么服务，
    --   那时报 NULL 比编一个 'code-server' 诚实（与 cpus/mem 在恢复态报 null 而不是 0
    --   是同一条原则）。老库上这一列由 Store._migrate 补上。
    service_kind    TEXT,
    -- 这个会话用的是**哪一个插件、哪一版** —— `"<id>@<版本>"`。
    -- ★ 与 service_kind 一样**可空**，NULL = 不知道（从 nft 规则恢复出来的会话）。
    --   但两者记的是不同的事：service_kind 是站点内的短名（给人读），
    --   而这一列是解析键。
    -- ★ 它必须是**提交那一刻**的值，不能在读取时按站点当前清单现算：作业侧跑的
    --   是那一版的代码，站点升级插件之后现算会把新版本的客户端代码接到旧版本的
    --   作业实现上。
    service_plugin  TEXT,
    created_at      INTEGER NOT NULL,
    submitted_at    INTEGER,
    enrolled_at     INTEGER,
    ended_at        INTEGER,
    last_hb_socket  INTEGER,
    file_inode      INTEGER,
    file_ctime      INTEGER,
    job_started_at  INTEGER,
    renew_count     INTEGER NOT NULL DEFAULT 0,
    renew_last_at   INTEGER,
    trust           TEXT NOT NULL DEFAULT 'owned',
    note            TEXT
);
CREATE INDEX IF NOT EXISTS idx_sessions_state ON sessions(state);
CREATE INDEX IF NOT EXISTS idx_sessions_job   ON sessions(job_id);
CREATE INDEX IF NOT EXISTS idx_sessions_uid   ON sessions(uid, state);
-- 活跃期间 (node_ip, service_port) 唯一：防止两个会话抢同一个节点端口
CREATE UNIQUE INDEX IF NOT EXISTS idx_sessions_port_active
    ON sessions(node_ip, service_port)
    WHERE service_port IS NOT NULL
      AND state IN ('enrolled','suspect','orphaned','releasing');

CREATE TABLE IF NOT EXISTS rejects (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    uid        INTEGER NOT NULL,
    at         INTEGER NOT NULL,
    reason     TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_rejects_uid ON rejects(uid, at);
"""


class Store(object):
    def __init__(self, path):
        self.path = path
        self.conn = sqlite3.connect(path, timeout=10, isolation_level=None)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA journal_mode=WAL")
        self.conn.execute("PRAGMA synchronous=FULL")
        self.conn.execute("PRAGMA busy_timeout=5000")
        self.conn.executescript(SCHEMA_SQL)
        self._migrate()

    def _migrate(self):
        """把**已经存在**的旧库补齐到当前表结构。

        ★ 为什么这里只加列、不改列：`CREATE TABLE IF NOT EXISTS` 不会改已存在的表，
          所以新列的缺失只发生在老库上。加一个**可空**列是纯加法、幂等、零数据损失，
          可以直接做。
          而 v0.1→v0.2 那次是**删**一个 NOT NULL 列，那个没法安全自动做，所以那次的
          选择是「拒绝启动 + 让管理员删库」（见 Config._db_schema_errors）。两者不是
          同一种变更，不要照抄。

        ★ 为什么必须在**这里**补齐：`_db_schema_errors` 只检查「多了一列」，**没有**
          「少了一列」这条反向规则 —— 于是旧库上守护进程**照常启动**，直到第一次
          SELECT/INSERT 碰到新列才抛 `no such column`，被 dispatch 兜成 code 9
          「内部错误」，信息里没有一个字与数据库有关。SCHEMA_SQL 上面那段注释记的就是
          这个失败形态（只是方向反过来）。所以补齐只能在这里做，不能指望别处报错。
        """
        cols = {r[1] for r in self.conn.execute("PRAGMA table_info(sessions)")}
        if not cols:
            return                       # 表刚建出来，SCHEMA_SQL 已经带上了所有列
        for name, decl in (("service_kind", "TEXT"), ("service_plugin", "TEXT")):
            if name not in cols:
                self.conn.execute(
                    "ALTER TABLE sessions ADD COLUMN %s %s" % (name, decl))

    def close(self):
        try:
            self.conn.close()
        except Exception:                                    # noqa: BLE001
            pass

    # ── 查询 ────────────────────────────────────────────────────────────────
    def get(self, session_id):
        cur = self.conn.execute("SELECT * FROM sessions WHERE session_id=?",
                                (session_id,))
        row = cur.fetchone()
        return dict(row) if row else None

    def by_state(self, states):
        q = ",".join("?" * len(states))
        cur = self.conn.execute(
            "SELECT * FROM sessions WHERE state IN (%s) ORDER BY created_at" % q,
            tuple(states))
        return [dict(r) for r in cur.fetchall()]

    def by_job(self, job_id):
        cur = self.conn.execute("SELECT * FROM sessions WHERE job_id=?", (job_id,))
        row = cur.fetchone()
        return dict(row) if row else None

    def by_uid(self, uid, states=None):
        if states:
            q = ",".join("?" * len(states))
            cur = self.conn.execute(
                "SELECT * FROM sessions WHERE uid=? AND state IN (%s) "
                "ORDER BY created_at" % q, (uid,) + tuple(states))
        else:
            cur = self.conn.execute(
                "SELECT * FROM sessions WHERE uid=? ORDER BY created_at", (uid,))
        return [dict(r) for r in cur.fetchall()]

    def active_ports(self):
        """所有活跃会话占用的端口（候选集 ∪ 已选定），用于分配时避让。"""
        used = set()
        for s in self.by_state((ST_RESERVED, ST_SUBMITTED) + ACL_STATES):
            for tok in (s.get("candidates") or "").split(","):
                if tok.strip().isdigit():
                    used.add(int(tok))
            if s.get("service_port"):
                used.add(int(s["service_port"]))
        return used

    def count_active(self, uid):
        q = ",".join("?" * len(ACL_STATES))
        cur = self.conn.execute(
            "SELECT COUNT(*) FROM sessions WHERE uid=? AND state IN (%s)" % q,
            (uid,) + ACL_STATES)
        return cur.fetchone()[0]

    def count_pending(self, uid):
        cur = self.conn.execute(
            "SELECT COUNT(*) FROM sessions WHERE uid=? AND state IN (?,?)",
            (uid, ST_RESERVED, ST_SUBMITTED))
        return cur.fetchone()[0]

    # ── 写入 ────────────────────────────────────────────────────────────────
    def insert(self, **kw):
        cols = ",".join(kw.keys())
        ph = ",".join("?" * len(kw))
        self.conn.execute("INSERT INTO sessions (%s) VALUES (%s)" % (cols, ph),
                          tuple(kw.values()))

    def update(self, session_id, **kw):
        if not kw:
            return
        sets = ",".join("%s=?" % k for k in kw)
        self.conn.execute("UPDATE sessions SET %s WHERE session_id=?" % sets,
                          tuple(kw.values()) + (session_id,))

    def delete(self, session_id):
        self.conn.execute("DELETE FROM sessions WHERE session_id=?", (session_id,))

    def record_reject(self, uid, reason):
        self.conn.execute("INSERT INTO rejects (uid, at, reason) VALUES (?,?,?)",
                          (uid, now_ts(), reason[:300]))
        self.conn.execute("DELETE FROM rejects WHERE at < ?", (now_ts() - 86400,))

    def reject_count_since(self, uid, since_ts):
        cur = self.conn.execute(
            "SELECT COUNT(*) FROM rejects WHERE uid=? AND at > ?", (uid, since_ts))
        return cur.fetchone()[0]


