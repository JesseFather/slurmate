def crosscheck_cidr(cfg, run=None):
    """把 cluster_cidr 与 Slurm 的 NodeAddr 全集交叉核对，返回错误列表。

    为什么必须有这一步：cluster_cidr 漏掉一个节点时，去往那个节点的流量会被
    链首的基础规则 `ip daddr != CIDR accept` 放行 —— 所有会话规则永远匹配不到，
    而链的 policy 就是 accept，所以既没有报错也没有日志。表现是"IDE 能连上，
    但那条 drop 规则其实从没生效过"，比连不上危险得多。

    查询失败时【不返回错误】：那多半是控制器抖动（slurmctld 重启、munge 抖动），
    而不是配置错了。宁可留着（可能不完整的）保护继续服务，也不要因为一次查询
    失败就拒绝启动 —— 后者会把一次瞬时抖动放大成一次停机。
    """
    problem = cfg.cluster_cidr_problem()
    if problem:
        return []                     # 配置本身就不合法，交给 validate() 报
    run = run or run_cmd
    rc, out, _ = run([cfg.scontrol, "show", "node", "-o"], timeout=15)
    if rc != 0 or not out.strip():
        # ★ 这是整个校验里唯一的缺口，所以说得重一点、说清楚缺的是什么：
        #   「跳过核对」的实质是「cluster_cidr 对不对，这一次没人验」。
        #   照抄文档示例网段 + 恰好这一次问不到 Slurm，两个条件同时成立时，
        #   守护进程会带着一份无效的 ACL 起来 —— 而它的表现是"一切正常"。
        log.warning("取不到 Slurm 节点列表（rc=%s）：本次【没有】核对 cluster_cidr "
                    "（%s）是否覆盖了全部计算节点。若这个网段是照抄文档示例填的，"
                    "现在正是它会被漏过去的时候。", rc, cfg.cluster_cidr)
        return []
    net = ipaddress.IPv4Network(cfg.cluster_cidr, strict=False)
    outside = []
    for m in re.finditer(r"\bNodeAddr=(\S+)", out):
        ip = m.group(1)
        # NodeAddr 在有些集群里写的是主机名（由 Slurm 解析）—— 那种情况这里
        # 无从判断，跳过而不是报错。
        if is_ipv4(ip) and ipaddress.IPv4Address(ip) not in net:
            outside.append(ip)
    if not outside:
        return []
    shown = "、".join(outside[:8]) + ("…（共 %d 个）" % len(outside)
                                      if len(outside) > 8 else "")
    return ["cluster_cidr = %s 漏掉了 %d 个节点：%s。去往这些节点的流量会被"
            "基础规则放行，会话的 drop 规则永远匹配不到 —— 而链的 policy 是 "
            "accept，不会有任何报错。请把网段放大到覆盖全部计算节点。"
            % (cfg.cluster_cidr, len(outside), shown)]


