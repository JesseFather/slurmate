def _ver_tuple(s):
    m = PLUGIN_VERSION_RE.match(str(s or "").strip())
    return tuple(int(x) for x in m.group(0).split(".")) if m else None


def version_satisfies(version, rng):
    """`version` 满不满足 `rng`（形如 `>=0.5.0 <0.7.0`）。返回 (bool, 原因)。

    ★ 与客户端 `plugins/index.js` 的 `satisfies()` **必须逐条一致**。两边规则不同
      的后果是一个插件在一侧被收下、在另一侧被拒 —— 而报错只会说"清单不合法"。

    支持 `>= > <= < =`，空格分隔，**全部满足**才算通过。故意不支持 `^` / `~` /
    `||` —— 那些的语义各自都有坑，而这里要的是"装之前就能判定"，不是"尽量满足"。
    """
    v = _ver_tuple(version)
    if v is None:
        return False, "版本号 %r 不是 x.y.z 形式" % version
    parts = [p for p in str(rng or "").strip().split() if p]
    if not parts:
        return False, "范围是空的"
    for p in parts:
        m = re.match(r"^(>=|<=|>|<|=)?(\d+\.\d+\.\d+)$", p)
        if not m:
            return False, "看不懂的范围片段 %r" % p
        c = _ver_tuple(m.group(2))
        op = m.group(1) or "="
        ok = {">=": v >= c, "<=": v <= c, ">": v > c,
              "<": v < c, "=": v == c}[op]
        if not ok:
            return False, "%s 不满足 %s" % (version, p)
    return True, ""


