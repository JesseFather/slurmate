_INF_TOKENS = {"unlimited", "infinite", "inf", "none", "n/a", "unknown", ""}

# 无法确定（查询失败）—— 与 None（已确认"不限制"）严格区分。
# 比较时用 `is`，不要用 ==。
PARTITIONS_UNKNOWN = "__PARTITIONS_UNKNOWN__"


def parse_slurm_time(s):
    """把 Slurm 的各种时间写法解析成秒。返回 None 表示"无限"。

    实测本集群会出现：183-00:00:00 / 12:00:00 / UNLIMITED / infinite
    """
    if s is None:
        return None
    s = str(s).strip()
    if s.lower() in _INF_TOKENS:
        return None
    m = re.fullmatch(r"(?:(\d+)-)?(\d+)(?::(\d+))?(?::(\d+))?", s)
    if not m:
        raise ValueError("无法解析 Slurm 时间: %r" % s)
    d, a, b, c = m.groups()
    if d is not None:                 # D-HH[:MM[:SS]]
        return ((int(d) * 24 + int(a)) * 60 + int(b or 0)) * 60 + int(c or 0)
    if b is None and c is None:       # 纯分钟
        return int(a) * 60
    if c is None:                     # MM:SS
        return int(a) * 60 + int(b)
    return (int(a) * 60 + int(b)) * 60 + int(c)   # HH:MM:SS


def fmt_slurm_time(secs):
    """秒 → Slurm 的 [D-]HH:MM:SS"""
    days, rem = divmod(int(secs), 86400)
    hh, rem = divmod(rem, 3600)
    mm, ss = divmod(rem, 60)
    if days:
        return "%d-%02d:%02d:%02d" % (days, hh, mm, ss)
    return "%02d:%02d:%02d" % (hh, mm, ss)


def normalize_ipv4(s):
    """严格校验并规范化 IPv4。返回规范字符串，不合法返回 None。

    用 ipaddress 而不是手写分割：手写版会放行 `010.1.1.1`、`1.2.3.04` 这类
    带前导零的写法（八进制歧义），也可能与 nft 的解析不一致。
    注意 Python 3.9.5+ 的 ipaddress 已经拒绝前导零，这里再显式挡一层，
    保证在更老的解释器上行为一致。
    """
    if not isinstance(s, str) or not s or len(s) > 15:
        return None
    try:
        import ipaddress
        addr = ipaddress.IPv4Address(s)
    except Exception:                                        # noqa: BLE001
        return None
    canon = str(addr)
    # 输入里任何一段带前导零（如 010）都拒绝
    for part in s.split("."):
        if len(part) > 1 and part.startswith("0"):
            return None
    return canon


def is_ipv4(s):
    return normalize_ipv4(s) is not None


def run_cmd(argv, timeout=10, check=False):
    """执行命令，返回 (rc, stdout, stderr)。永不抛异常。"""
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           timeout=timeout)
        out = p.stdout.decode("utf-8", "replace")
        err = p.stderr.decode("utf-8", "replace")
        if check and p.returncode != 0:
            log.warning("命令失败 rc=%s: %s | stderr=%s", p.returncode,
                        " ".join(argv), err.strip()[:200])
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        log.warning("命令超时(%ss): %s", timeout, " ".join(argv))
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", "not found: %s" % argv[0]
    except Exception as e:                                   # noqa: BLE001
        return 1, "", str(e)


def now_ts():
    return int(time.time())


