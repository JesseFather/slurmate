class Purpose(object):
    def __init__(self, key, label, partition, gres, cpus, mem):
        self.key = key
        self.label = label
        self.partition = partition
        self.gres = gres
        self.cpus = cpus
        self.mem = mem

    def to_dict(self):
        return {"key": self.key, "label": self.label, "partition": self.partition,
                "gres": self.gres, "cpus": self.cpus, "mem": self.mem}


class Config(object):
    def __init__(self, path):
        # inline_comment_prefixes：允许 `key = value   # 说明` 这种写法。
        # 注意这意味着值里不能出现 '#'（本配置文件里的路径/网段/时间都不含）。
        cp = configparser.ConfigParser(inline_comment_prefixes=("#",))
        with open(path, "r", encoding="utf-8") as f:
            cp.read_file(f)
        self.raw = cp
        self.path = path

        g = cp["general"]
        self.socket_path = g.get("socket_path", "/run/slurmate-session/ctl.sock")
        self.state_dir = g.get("state_dir", "/var/lib/slurmate-session")
        self.db_path = g.get("db_path", os.path.join(self.state_dir, "claims.db"))
        self.rejected_dir = g.get("rejected_dir", os.path.join(self.state_dir, "rejected"))
        self.log_dir = g.get("log_dir", "/var/log/slurmate")
        self.audit_log = g.get("audit_log", os.path.join(self.log_dir, "audit.log"))
        self.cluster_cidr = g.get("cluster_cidr", "192.0.2.0/24")
        self.tick_seconds = g.getint("tick_seconds", 2)
        self.startup_grace_seconds = g.getint("startup_grace_seconds", 120)

        p = cp["ports"]
        self.port_start = p.getint("range_start", 55001)
        self.port_end = p.getint("range_end", 55999)
        self.candidates_per_session = p.getint("candidates_per_session", 6)

        # 需要避让的其他端口区间，格式 "start-end,start-end"（逗号分隔，可留空）。
        # 若你的集群上还有别的端口管理系统（某些 guard / DNAT 守护进程之类），
        # 把它们的区间写在这里，启动时会断言不交 —— nftables 对同 hook 同
        # priority 的【跨表顺序不给保证】，只有"集合不交"才能让行为确定。
        # 开源前的旧实现把 "必须 > 55000" 写死在代码里，那是本集群的约定，
        # 别人的集群用 55000 以下端口时会直接起不来。
        self.reserved_ranges = []
        for _item in (p.get("reserved_ranges", "") or "").split(","):
            _item = _item.strip()
            if not _item:
                continue
            if "-" not in _item:
                raise ValueError("reserved_ranges 的每一项应为 start-end 形式，得到: %r"
                                 % _item)
            _a, _b = _item.split("-", 1)
            self.reserved_ranges.append((int(_a), int(_b)))

        lc = cp["lifecycle"]
        self.default_time = lc.get("default_time", "12:00:00")
        self.max_time = lc.get("max_time", "7-00:00:00")
        self.suspect_after = lc.getint("suspect_after_seconds", 300)
        self.orphan_after = lc.getint("orphan_after_seconds", 1800)
        self.reserved_ttl = lc.getint("reserved_ttl_seconds", 600)
        # "作业查不到"要连续确认多少个 tick 才认定结束（防 scontrol 瞬时不稳）
        self.job_missing_confirm_ticks = lc.getint("job_missing_confirm_ticks", 3)
        self.submitted_ttl = lc.getint("submitted_ttl_seconds", 1800)
        self.released_keep = lc.getint("released_keep_seconds", 600)

        rn = cp["renew"]
        self.renew_enabled = rn.getboolean("enabled", True)
        self.renew_threshold = rn.getint("threshold_seconds", 7200)
        self.renew_increment = rn.get("increment", "12:00:00")
        self.renew_max_total = rn.getint("max_total_seconds", 604800)

        sec = cp["security"]
        self.auth_mode = sec.get("auth_mode", "password").strip().lower()
        self.password_bytes = sec.getint("password_bytes", 12)

        q = cp["quota"]
        self.max_active_per_user = q.getint("max_active_per_user", 1)
        self.max_pending_per_user = q.getint("max_pending_per_user", 4)
        self.max_rpc_per_second = q.getint("max_rpc_per_second", 10)
        self.reject_threshold = q.getint("reject_threshold", 20)
        self.reject_window = q.getint("reject_window_seconds", 600)
        self.throttle_seconds = q.getint("throttle_seconds", 1800)

        s = cp["slurm"]
        self.sbatch = s.get("sbatch") or "/usr/bin/sbatch"
        self.scancel = s.get("scancel") or "/usr/bin/scancel"
        self.squeue = s.get("squeue") or "/usr/bin/squeue"
        self.scontrol = s.get("scontrol") or "/usr/bin/scontrol"
        self.sacctmgr = s.get("sacctmgr") or "/usr/bin/sacctmgr"
        self.job_script = s.get("job_script", "/usr/local/share/slurmate/run.sbatch")
        self.code_server_bin = s.get("code_server_bin", "/usr/local/bin/code-server")
        # 作业日志在用户家目录下的相对路径。Slurm.submit() 用它拼 sbatch 的 -o/-e。
        #
        # ⚠️ 这一行曾经【漏掉过】—— 配置项在 slurmate.conf 里写着，Slurm.submit()
        #    里也读着，唯独 Config 从来没把它从配置里取出来。后果不是"日志路径
        #    不对"，而是 `AttributeError`，被 dispatch 兜成 code 9 内部错误：
        #    **每一次提交都失败**，而错误信息里看不出任何与"日志路径"有关的线索。
        #    教训：配置项要在三处对齐 —— 示例配置、读取处、使用处。少一处就是
        #    一个只在运行时才炸的洞。
        self.job_log_subdir = s.get("job_log_subdir", ".slurmate/logs")

        self.purposes = {}
        for sec in cp.sections():
            if sec.startswith("purpose:"):
                key = sec.split(":", 1)[1]
                self.purposes[key] = Purpose(
                    key=key,
                    label=cp.get(sec, "label", fallback=key),
                    partition=cp.get(sec, "partition"),
                    gres=cp.get(sec, "gres", fallback=""),
                    cpus=cp.getint(sec, "cpus", fallback=1),
                    mem=cp.get(sec, "mem", fallback="2G"),
                )

    def validate(self):
        """启动时自检。任何一条不满足都拒绝启动 —— 宁可不起，也不要带病运行。"""
        errors = []
        # 端口区间必须与集群上其他端口管理系统完全不交（nftables 对同 hook 同
        # priority 的跨表顺序没有保证，只有"集合不交"才能保证判决确定）。
        # 要与哪些区间避让由配置的 reserved_ranges 决定，不写死在代码里。
        if self.port_start > self.port_end:
            errors.append("端口区间起止颠倒: %d-%d" % (self.port_start, self.port_end))
        for _a, _b in self.reserved_ranges:
            if self.port_start <= _b and _a <= self.port_end:
                errors.append("端口区间 %d-%d 与 reserved_ranges 里的 %d-%d 重叠"
                              % (self.port_start, self.port_end, _a, _b))
        if self.port_end > 65535:
            errors.append("端口区间上界 %d 越界" % self.port_end)
        # 阈值关系
        if self.job_missing_confirm_ticks < 1:
            errors.append("job_missing_confirm_ticks 必须 >= 1")
        if self.suspect_after >= self.orphan_after:
            errors.append("suspect_after(%d) 必须小于 orphan_after(%d)"
                          % (self.suspect_after, self.orphan_after))
        if not os.path.exists(self.job_script):
            errors.append("作业脚本不存在: %s" % self.job_script)
        if not is_ipv4(self.cluster_cidr.split("/")[0]):
            errors.append("cluster_cidr 不是 IPv4 网段: %s" % self.cluster_cidr)
        for want in (self.sbatch, self.scancel, self.scontrol):
            if not os.path.exists(want):
                errors.append("Slurm 命令不存在: %s" % want)
        if not self.purposes:
            errors.append("没有配置任何 [purpose:*]")
        if self.auth_mode not in ("password", "none"):
            errors.append("security.auth_mode 只能是 password 或 none，当前为 %r"
                          % self.auth_mode)
        if not (4 <= self.password_bytes <= 64):
            errors.append("security.password_bytes 应在 4-64 之间，当前为 %d"
                          % self.password_bytes)
        return errors


